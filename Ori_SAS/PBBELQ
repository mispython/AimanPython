CLASS BNMCODE FMTNAME DESC SIGN;
VAR   AMOUNT TOTAL AMOUNX TOTALX;
OUTPUT OUT=ELWT (DROP=_TYPE_ _FREQ_) SUM=;
*;
DATA ELWT;
