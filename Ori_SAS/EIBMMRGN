        @204 LIMIT     $18.
        @222 B_UPDATE  $12.
        @234 TOT_OS    $18.
        @252 TOTLIMIT  $18.
        @270 FROM_YR   5.
        @275 TO_YR     5.
        @280 MTH_ODR   $13.
        @293 COND_ACC  $13.
