        @326 CRRGRADE  $UPCASE5.
        @331 CONTACT1  $15.
        @346 CONTACT2  $15.
        @361 ADDRESS   $UPCASE130.
        ;
   OS_BAL=RIGHT(OS_BAL);
   OS_BAL=COMPRESS(OS_BAL,',');
   OS_BAL=OS_BAL*1;

   LIMIT=RIGHT(LIMIT);
   LIMIT=COMPRESS(LIMIT,',');
   LIMIT=LIMIT*1;

   TOTLIMIT=RIGHT(TOTLIMIT);
