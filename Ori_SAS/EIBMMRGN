   TOTLIMIT=TOTLIMIT*1;

   TOT_OS=RIGHT(TOT_OS);
   TOT_OS=COMPRESS(TOT_OS,',');
   TOT_OS=TOT_OS*1;
     RUN;
*;

DATA MARGIN2;
 SET MARGIN;
 FILE MARGOUT;
    PUT @0001 RGNCODE    $8.
        @0009 BSCGROUP   5.
        @0014 AA_NO      $20.
        @0034 CRRGRADE   $UPCASE5.
        @0039 NAME       $UPCASE80.
        @0119 IDNO1      $18.
        @0137 IDNO2      $18.
        @0152 CONTACT1   $15.
