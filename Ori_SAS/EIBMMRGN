//SYSIN     DD *

OPTIONS YEARCUTOFF=1950 NOCENTER;
DATA REPTDATE;
     INFILE DATEFILE LRECL=80 OBS=1;
     INPUT @01  EXTDATE   11.;
     REPTDATE=INPUT(SUBSTR(PUT(EXTDATE, Z11.), 1, 8), MMDDYY8.);
  MM=MONTH(REPTDATE);
  CALL SYMPUT('REPTYEAR',PUT(REPTDATE,YEAR2.));
  CALL SYMPUT('REPTMON',PUT(MM,Z2.));
  CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE), Z2.));
RUN;
PROC PRINT DATA=REPTDATE;
*;
DATA MARGIN;
  INFILE MARGTXT FIRSTOBS=2;
  INPUT @001 RGNCODE   $8.
        @009 NAME      $UPCASE80.
        @089 IDNO1     $18.
        @107 NATINLTY  $5.
        @112 BSCGROUP  5.
        @117 IDNO2     $18.
        @135 FAC_DATE  $12.
        @147 STATUS    $3.
        @150 CAPACITY  $10.
        @160 LENDTYPE  $5.
        @165 MY_FRGN   $3.
        @168 FACILITY  $18.
