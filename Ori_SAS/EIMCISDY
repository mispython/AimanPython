//EIMCISDY JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=258M                    JOB54376
//**********************************************************************
//* CONVERT FILES INTO SAS DATAWAREHOUSE FOR SURVEY RESPONSES
//* FOR PRIZE WINNERS
//* DATASET: CUSTDLY
//* ESMR   : 2018-4001
//**********************************************************************
//*
//DELETE  EXEC PGM=IEFBR14
//DEL01    DD DSN=SAP.PBB.MONTH.CUSTDLY.CUSFTP,
//            DISP=(MOD,DELETE,DELETE),
//            SPACE=(CYL,(0))
//*
//CREATE  EXEC PGM=IEFBR14
//CRT01    DD DSN=SAP.PBB.MONTH.CUSTDLY.CUSFTP,
//            DISP=(NEW,CATLG,DELETE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920),
//            SPACE=(CYL,(100,80),RLSE),UNIT=(SYSDA,5)
//*
//EIMCISDY EXEC SAS609,WORK='24000,12000',REGION=8M
//CUST     DD DSN=RBP2.B033.CIS.CUST.DAILY,DISP=SHR
//CISTAXID DD DSN=RBP2.B033.CCRIS.TAXID.GDG(0),DISP=SHR
//SASLIST  DD SYSOUT=X
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(500))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(500))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(500))
//SORTWK04 DD UNIT=SYSDA,SPACE=(CYL,(500))
//SORTWK05 DD UNIT=SYSDA,SPACE=(CYL,(500))
//SYSIN    DD *

OPTIONS YEARCUTOFF=1950 NOCENTER;

PROC SORT DATA=CUST.CUSTDLY OUT=CUSTDLY;BY CUSTNO;RUN;

DATA CISTAXID;
  INFILE CISTAXID MISSOVER;
  INPUT @001 CUSTNO    $11.
        @083 RHOLD_IND $1.
        ;
RUN;
PROC SORT DATA=CISTAXID NODUPKEY;BY CUSTNO;RUN;

DATA CUSTDLY(KEEP=ACCTNOC CUSTNO RHOLD_IND CUSTNAME DOBDOR ALIAS);
   MERGE CUSTDLY(IN=A) CISTAXID(IN=B);BY CUSTNO;
   IF A;
RUN;

FILENAME TRANFILE 'SAP.PBB.MONTH.CUSTDLY.CUSFTP' DISP=OLD;
PROC CPORT DATA=CUSTDLY FILE=TRANFILE;
RUN;

//*------------------------------------------------------
//* FTP TO EDW
//*------------------------------------------------------
//RUNSFTP  EXEC COZBATCH
//CMD.SYSUT1 DD DISP=SHR,DSN=OPER.PBB.PARMLIB(EDW#SFTP)
//           DD *
lzopts servercp=$servercp,notrim,overflow=trunc,mode=binary
lzopts linerule=$lr
cd /stgsrcsys/host/ftpfiles
put //SAP.PBB.MONTH.CUSTDLY.CUSFTP CUSTDLY
lzopts servercp=$servercp,notrim,overflow=trunc,mode=text
lzopts linerule=$lr
cd /stgsrcsys/host/control
put //SAP.CRMS.MONTH.CONTROL   EIMCISDY.TXT
EOB
