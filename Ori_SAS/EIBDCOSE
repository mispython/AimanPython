*** 9. DEPOSIT - AVERAGE BALANCE AND INTEREST PAID ***;
***              (ONLY ON MONTH END)               ***;
%MACRO DEPBAL;
   %IF "&MTHEND" EQ "01" %THEN %DO;
      DATA DPBAL;
         INFILE DPTRBL LRECL=924;
         INPUT @110 ACCTNO   PD6.
               @822 AVGBAL   PD8.2
               @880 INTRSTPD PD9.2
               ;
         TRANDT=INPUT("&RDATE", DDMMYY8.);
         IF ACCTNO GT 0;
      RUN;

      PROC SORT DATA=COST.NAME OUT=NAME; BY ACCTNO; RUN;
      PROC SORT DATA=DPBAL NODUPKEYS; BY ACCTNO; RUN;
      DATA DPBAL;
         MERGE DPBAL(IN=A) NAME(IN=B);
         BY ACCTNO;
         IF A AND B;
      RUN;

      DATA COST.DPBAL&REPTMON; SET DPBAL; RUN;
   %END;
%MEND;


*** 10. OTHER (H/W AND DATA COMM) ***;
%MACRO OTHERDTL;
   DATA OTHCOST(DROP=DD MM YY DD1 MM1 YY1);
      INFILE COSTOTH FIRSTOBS=5;
      INPUT @001 ACCTNO    10.
            @012 CTYPE     $2.
            @020 ORICOST   12.2
            @033 DD        2.
            @035 MM        2.
            @037 YY        4.
            @042 DD1       2.
            @044 MM1       2.
            @046 YY1       4.
            ;
      IF ACCTNO GT 0;
      IF CTYPE = 'HW' THEN DO;
         TRANDT  = MDY(MM,DD,YY);
         EXPDT   = MDY(MM1,DD1,YY1);
      END;

   RUN;
   DATA COST.OTHCOST; SET OTHCOST; RUN;
%MEND;



*** MAIN PROCESS ***;
%MACRO PROCESS;
  %IF "&SBKDT" EQ "&RDATE" AND
      "&DEP01DT" EQ "&RDATE" %THEN %DO;

     %CORPNAME;
     %COSTRT;
     %ESMRDTL;
     %SBKDTL;
     %DEPCOLL;
     %DEPECP;
     %DEPDDS;
     %DEPMISC;
     %DEPBAL;
     %OTHERDTL;

  %END;
  %ELSE %DO;
     %IF "&SBKDT" NE "&RDATE" %THEN
        %PUT THE STOCK BANKING FILE IS NOT DATED &RDATE;
     %IF "&DEP01DT" NE "&RDATE" %THEN
        %PUT THE DEPOSIT COLLECTION FILE IS NOT DATED &RDATE;
     %PUT THE JOB IS NOT DONE !!;
     %DO;
        DATA A;
        ABORT 77;
     %END;
  %END;
%MEND;
%PROCESS;

