//DEP04     DD DSN=RBP2.B033.DP.MISC.DAILY,DISP=SHR
//SYSIN     DD *

OPTIONS NOCENTER YEARCUTOFF=1950 LS=132;

DATA COST.REPTDATE;
  REPTDATE = TODAY()-1;
  CALL SYMPUT('MTHEND',PUT(DAY(TODAY()),Z2.));
  CALL SYMPUT('REPTDAY',PUT(DAY(REPTDATE),Z2.));
  CALL SYMPUT('REPTMON',PUT(MONTH(REPTDATE),Z2.));
  CALL SYMPUT('REPTYEAR',PUT(REPTDATE,YEAR4.));
  CALL SYMPUT('RDATE',PUT(REPTDATE,DDMMYY8.));
RUN;
PROC PRINT DATA=COST.REPTDATE; FORMAT REPTDATE DATE8. ;RUN;

DATA _NULL_;
  INFILE STOCKBK OBS=1;
  INPUT @056  YY     4.
        @060  MM     2.
        @062  DD     2.
        ;
  REPTDATE = MDY(MM,DD,YY);
  CALL SYMPUT('SBKDT', PUT(REPTDATE, DDMMYY8.));
RUN;

DATA _NULL_;
  INFILE DEP01 OBS=1;
  INPUT @056  YY     4.
        @060  MM     2.
        @062  DD     2.
        ;
  REPTDATE = MDY(MM,DD,YY);
  CALL SYMPUT('DEP01DT', PUT(REPTDATE, DDMMYY8.));
RUN;

*** 1. CORP NAME (FR ESMR) ***;
%MACRO CORPNAME;
   DATA NAME;
      INFILE CORPNM;
      INPUT @001 CUSTNAME  $80.
            @081 NMABBR    $20.
            @101 ACCNM     $80.
            @181 ACCTNO    10.
            ;
      IF NMABBR NE '' AND ACCTNO GT 0;
   RUN;

   PROC APPEND DATA=NAME BASE=COST.NAME; RUN;
   PROC SORT DATA=COST.NAME NODUPKEY; BY ACCTNO NMABBR ACCNM; RUN;
%MEND;


*** 2. COST RATE FROM USER ***;
%MACRO COSTRT;
   DATA RATE;
      INFILE COSTRATE FIRSTOBS=4;
      INPUT @001 FLOAT     5.2
            @008 MANRATE   7.2
            @017 OTCRATE   5.2
            @024 ATMRATE   5.2
            @031 PBERATE   5.2
            @040 TELERATE  5.2
            @053 DEBRATE   5.2
            @067 MISCRATE  5.2
            ;
      IF FLOAT GT 0;
      TRANDT=INPUT("&RDATE", DDMMYY8.);
   RUN;

   %IF "&REPTDAY" EQ "01" %THEN %DO;
      DATA COST.RATE&REPTMON; SET RATE; RUN;
   %END;
   %ELSE %DO;
      DATA COST.RATE&REPTMON;
        SET COST.RATE&REPTMON;
        IF TRANDT EQ INPUT("&RDATE", DDMMYY8.) THEN DELETE;
      RUN;
      PROC APPEND DATA=RATE BASE=COST.RATE&REPTMON; RUN;
   %END;
%MEND;


*** 3. ESMR  ***;
%MACRO ESMRDTL;
   DATA ESMR(DROP=DD MM YY);
      INFILE ESMRTXT;
      INPUT @001 SMRNO     $13.
            @014 ACCTNO    10.
            @034 MANDAY    8.
            @044 DD        2.
            @047 MM        2.
            @050 YY        4.
            ;
      TRANDT  = MDY(MM,DD,YY);
      EXPDT   = MDY(MM,DD,(YY+5));
   RUN;

   PROC APPEND DATA=ESMR BASE=COST.ESMR; RUN;
   PROC SORT DATA=COST.ESMR NODUPKEY; BY ACCTNO SMRNO; RUN;
%MEND;


*** 4. STOCK BANKING ***;
%MACRO SBKDTL;
   DATA STBK(DROP=DD MM YY);
      INFILE STOCKBK;
      INPUT @001 ACCTNO    10.
            @012 SVTYPE    $7.
            @020 COUNT     7.
            @028 AMOUNT    13.
            @042 FEEAMT1   13.
            @056 YY        4.
            @060 MM        2.
            @062 DD        2.
            @065 FEEAMT2   13.
            ;
      TRANDT  = MDY(MM,DD,YY);
      AMOUNT  = AMOUNT/100;
      FEEAMT1 = FEEAMT1/100;
      FEEAMT2 = FEEAMT2/100;
   RUN;

   %IF "&REPTDAY" EQ "01" %THEN %DO;
      DATA COST.STBK&REPTMON; SET STBK; RUN;
   %END;
   %ELSE %DO;
      DATA COST.STBK&REPTMON;
         SET COST.STBK&REPTMON;
         IF TRANDT EQ INPUT("&RDATE", DDMMYY8.) THEN DELETE;
      RUN;
      PROC APPEND DATA=STBK BASE=COST.STBK&REPTMON; RUN;
   %END;
%MEND;


