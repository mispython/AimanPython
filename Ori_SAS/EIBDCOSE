//EIBDCOSE  JOB MISEIS,CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID
/*JOBPARM S=S1M2
//*
//EIBDCOSE  EXEC SAS609,REGION=8M
//COST      DD DSN=SAP.PBB.CORP.COST,DISP=OLD
//CORPNM    DD DSN=SAP.PBB.COST.CORP.TEXT(0),DISP=SHR
//ESMRTXT   DD DSN=SAP.PBB.COST.ESMR.TEXT(0),DISP=SHR
//COSTRATE  DD DSN=SAP.PBB.COST.RATE.TEXT(0),DISP=SHR
//COSTOTH   DD DSN=SAP.PBB.COST.OTHER.TEXT(0),DISP=SHR
//DPTRBL    DD DSN=RBP2.B033.DPTRBLGS,DISP=SHR
//STOCKBK   DD DSN=RBP2.B033.SASCONF1.PYMT(0),DISP=SHR
//DEP01     DD DSN=RBP2.B033.DP.COLLECT.SERVICE.DAILY,DISP=SHR
//DEP02     DD DSN=RBP2.B033.DP.ECPFDS.DAILY,DISP=SHR
//DEP03     DD DSN=RBP2.B033.DDS.DAILY.RPT(0),DISP=SHR
