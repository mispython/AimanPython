//EIDEPFLN JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=64M                     J0148452
//*---------------------------------------------------------------------
//* PROGRAM  : EIDEPFLN
//* ESMR     : 2016-4001 (AAB)
//* DESC     : AUTO-MAP OVER THE BORROWER'S CREDIT AND COLLATERAL INFO
//*            UPON RECEIPT OF THE BATCH FILE FROM EPF TO REDUCE THE
//*            OUTSTANDING BALANCE WITH THE BANK UNDER THE E-WITHDRAWAL
//*            HL SCHEME
//*---------------------------------------------------------------------
//EIDEPFLN EXEC SAS609
//FVAL     DD DSN=RBP2.B033.LN.EPF.FVAL.GOOD(0),DISP=SHR
//LN       DD DSN=SAP.PBB.MNILN.DAILY(0),DISP=SHR
//ILN      DD DSN=SAP.PIBB.MNILN.DAILY(0),DISP=SHR
//ELDS     DD DSN=SAP.ELDS.ELAA(0),DISP=SHR
//CISLN    DD DSN=SAP.PBB.CISBEXT.LN.DAILY,DISP=SHR
//EPF      DD DSN=SAP.PBB.EPF.SASDATA,DISP=OLD
//OUTPUT   DD DSN=SAP.EPF.CUSTLIST.TEXT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//            DCB=(LRECL=500,RECFM=FB,BLKSIZE=5000)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SORTWK04 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SORTWK05 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SORTWK06 DD UNIT=SYSDA,SPACE=(CYL,(1000))
//SYSIN    DD *

OPTIONS YEARCUTOFF=1960 NOCENTER NODATE NONUMBER MISSING='' COMPRESS=YES
        SORTPARM='HIPRMAX=0,MOSIZE=0' NOSORTBLKMODE;

DATA EPF.REPTDATE(KEEP=REPTDATE);
   REPTDATE=TODAY();
   CALL SYMPUT('REPTDAY',PUT(DAY(REPTDATE),Z2.));
RUN;

DATA EPFVAL EPF.EPFVAL&REPTDAY;
   INFILE FVAL;
   INPUT @001 RECORDTY           2.
         @003 MEMNAME1         $40.
         @043 MEMNAME2         $40.
         @083 ICNO             $20.
         @103 EPFNO             19.
         @122 WITHTRAN          19.
         @141 ACCTNO20         $20.
         @141 ACCTNO            10.
         @151 NOTENO             5.
         @161 LNREFNO20        $30.
         @191 WITHSCHEME       $10.
         @201 OLDICNO          $20.
         @221 OTHICNO          $20.
         @241 REJCODE           $2.
         ;
   SEQID = _N_;
RUN;
PROC SORT DATA=EPFVAL NODUPKEY; BY ACCTNO NOTENO; RUN;

%LET CVAR=(KEEP=CUSTNAME ACCTNO NEWIC NEWICIND OLDIC SECCUST);

PROC SORT DATA=CISLN.LOAN OUT=CISINFO &CVAR; BY ACCTNO SECCUST; RUN;

PROC SQL;
   CREATE TABLE TEMP AS
   SELECT T1.ACCTNO20, T1.ACCTNO, T1.NOTENO, T1.SEQID, T2.CUSTNAME,
          T2.NEWIC, T2.NEWICIND, T2.OLDIC, T2.SECCUST
   FROM EPFVAL T1 LEFT JOIN CISINFO T2 ON (T1.ACCTNO=T2.ACCTNO);
RUN;

DATA EPFCIS SECCIS;
   SET TEMP;
   IF NEWICIND IN ('PP','PL','ML') THEN OTHERID = NEWIC;
   IF SECCUST = '901' THEN OUTPUT EPFCIS;
   ELSE                    OUTPUT SECCIS;
RUN;

PROC SORT DATA=EPFCIS; BY ACCTNO NOTENO; RUN;
PROC SORT DATA=SECCIS; BY ACCTNO NOTENO; RUN;

DATA SECCIS1(RENAME=(CUSTNAME=CUSTNAME2 NEWIC=NEWIC2
                     OLDIC=OLDIC2 OTHERID=OTHERID2))
     SECCIS2(RENAME=(CUSTNAME=CUSTNAME3 NEWIC=NEWIC3
                     OLDIC=OLDIC3 OTHERID=OTHERID3));
   SET SECCIS(KEEP=ACCTNO NOTENO CUSTNAME NEWIC OLDIC OTHERID);
   BY ACCTNO NOTENO;
   IF FIRST.ACCTNO OR FIRST.NOTENO THEN SEQNO = 1;
   ELSE                                 SEQNO + 1;
   IF SEQNO <= 2; *EPF REQUIRE UP TO 2 SECONDARY BORROWERS;
   IF FIRST.ACCTNO OR FIRST.NOTENO THEN OUTPUT SECCIS1;
   ELSE OUTPUT SECCIS2;
RUN;
PROC SORT DATA=SECCIS1; BY ACCTNO NOTENO; RUN;
PROC SORT DATA=SECCIS2; BY ACCTNO NOTENO; RUN;

DATA EPFCIS;
   MERGE EPFCIS(IN=A) SECCIS1 SECCIS2;
   BY ACCTNO NOTENO;
   IF A;
RUN;
PROC SORT; BY ACCTNO NOTENO; RUN;

DATA ELDSSAS;
   SET LN.LNNOTE(KEEP=ACCTNO NOTENO VINNO ISSXDTE)
      ILN.LNNOTE(KEEP=ACCTNO NOTENO VINNO ISSXDTE);
   RENAME VINNO=AANO;
RUN;
PROC SORT; BY AANO; RUN;

PROC SORT DATA=ELDS.ELBNMAX(KEEP=AANO APVDTE1 AMOUNT APPAMTSC SPADT)
           OUT=ELDS NODUPKEY; BY AANO;
RUN;

DATA ELDSSAS;
   MERGE ELDSSAS(IN=A) ELDS;
   BY AANO;
   IF A;
   IF APVDTE1 IN (.,0) THEN APVDTE1 = ISSXDTE;
   IF SPADT   IN (.,0) THEN SPADT   = APVDTE1;
   IF APPAMTSC NOT IN (.,0) THEN AMOUNT = APPAMTSC;
RUN;
PROC SORT; BY ACCTNO NOTENO; RUN;

DATA EPFCIS;
   MERGE EPFCIS(IN=A) ELDSSAS;
   BY ACCTNO NOTENO;
   IF A;
   IF AMOUNT IN (.,0) THEN AMOUNT = 0;
RUN;
PROC SORT; BY SEQID; RUN;

DATA EPF.EPFOUT&REPTDAY;
   SET EPFCIS;
   FILE OUTPUT;
   PUT @001  ACCTNO20       $20.
       @021  CUSTNAME       $80.
       @101  NEWIC          $15.
       @116  OLDIC          $15.
       @131  OTHERID        $20.
       @151  CUSTNAME2      $80.
       @231  NEWIC2         $15.
       @246  OLDIC2         $15.
       @261  OTHERID2       $20.
       @281  CUSTNAME3      $80.
       @361  NEWIC3         $15.
       @376  OLDIC3         $15.
       @391  OTHERID3       $20.
       @411  APVDTE1   YYMMDDN8.
       @419  SPADT     YYMMDDN8.
       @427  AMOUNT          17.2
       ;
RUN;
