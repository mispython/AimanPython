*+--------------------------------------------------------------+
 |  PROGRAM : EIBMNPL2                                          |
 |  DATE    : 12.01.98                                          |
 |  REPORT  : TOTAL OVERDUE LOANS                               |
 |            - DETAILS OF ALL BRANCHES FOR CHECKING            |
 +--------------------------------------------------------------+;
OPTION NOCENTER NODATE NONUMBER;
*;
DATA LOAN1;
   KEEP BRCH ACCTNO NAME PRODUCT CUSTCD SECTORCD COLLCD NOTENO
        STATECD RISKRTE BALANCE APPRLIMT BLDATE SECURE DAYS;
   FORMAT BLDATE DDMMYY8.;
   SET BNM.LOAN&REPTMON&NOWK;
   IF _N_ = 1 THEN SET REPTDATE;
   IF ACCTYPE = 'LN' AND BRANCH ^= . AND BALANCE >= 1.00 AND
     PRODUCT NOT IN (517,500);
   IF BLDATE > 0 THEN DAYS = REPTDATE - BLDATE;
   IF OLDNOTEDAYARR > 0 AND 98000<=NOTENO<=98999 THEN DO;
      IF DAYS < 0 THEN DAYS = 0;
      DAYS = SUM(DAYS,OLDNOTEDAYARR);
   END;
   IF RISKRTE NOT IN (1,2,3,4) THEN IF DAYS < 30 THEN DELETE;
   BRCH = PUT(BRANCH,BRCHCD.);
*;
PROC SORT DATA=LOAN1;
   BY BRCH DAYS RISKRTE;
PROC PRINTTO PRINT=ODTLLIST;
*;
PROC SORT DATA=BNM.LOAN&REPTMON&NOWK OUT=LOAN;
   BY ACCTNO;
   WHERE ACCTYPE = 'OD';
*;
PROC SORT DATA=OD.OVERDFT NODUPKEY
          OUT=OD (KEEP=ACCTNO EXCESSDT TODDATE RISKCODE);
   BY ACCTNO;
   WHERE EXCESSDT > 0 OR TODDATE > 0;
*;
DATA LOAN2;
   KEEP BRCH ACCTNO NAME PRODUCT CUSTCD SECTORCD COLLCD
        STATECD RISKCODE BALANCE APPRLIMT BLDATE DAYS EXCESDT TODDT;
   FORMAT BLDATE DDMMYY8.;
   MERGE LOAN (IN=AA) OD;
   BY ACCTNO;
   IF _N_ = 1 THEN SET REPTDATE;
   IF AA AND PRODUCT NOT IN (517,500);
   IF EXCESSDT > 0 THEN DO;
     EXCDAY = SUBSTR(PUT(EXCESSDT,Z11.),3,2);
     EXCMONTH = SUBSTR(PUT(EXCESSDT,Z11.),1,2);
     EXCYEAR = SUBSTR(PUT(EXCESSDT,Z11.),5,4);
     EXCDATE = MDY(EXCMONTH,EXCDAY,EXCYEAR);
   END;
   EXCESDT = PUT(EXCDATE,DDMMYY8.);
   IF TODDATE > 0 THEN DO;
     TODDAY = INPUT(SUBSTR(PUT(TODDATE,Z11.),3,2),2.);
     TODMONTH = INPUT(SUBSTR(PUT(TODDATE,Z11.),1,2),2.);
     TODYEAR = INPUT(SUBSTR(PUT(TODDATE,Z11.),5,4),4.);
     TODDT1= MDY(TODMONTH,TODDAY,TODYEAR);
   END;
   TODDT = PUT(TODDT1,DDMMYY8.);
   IF EXCESSDT NE 0 AND TODDATE NE 0 THEN DO;
   IF EXCDATE <= TODDT1 THEN
      BLDATE = INPUT(SUBSTR(PUT(EXCESSDT,Z11.),1,8),MMDDYY8.);
   IF EXCDATE > TODDT1 THEN
      BLDATE = INPUT(SUBSTR(PUT(TODDATE,Z11.),1,8),MMDDYY8.);
   END;
   ELSE IF EXCESSDT > 0 THEN
      BLDATE = INPUT(SUBSTR(PUT(EXCESSDT,Z11.),1,8),MMDDYY8.);
   ELSE IF TODDATE > 0 THEN
      BLDATE = INPUT(SUBSTR(PUT(TODDATE,Z11.),1,8),MMDDYY8.);
   IF BLDATE > 0 THEN DAYS = REPTDATE - BLDATE + 1;
   IF RISKCODE NOT IN ('1','2','3','4') THEN IF DAYS < 30 THEN DELETE;
   BRCH = PUT(BRANCH,BRCHCD.);
*;
PROC SORT DATA=LOAN2;
   BY BRCH DAYS RISKCODE;
OPTION LINESIZE = 136;
%MACRO PRT;
PROC PRINT DATA=LOAN1 LABEL;
  BY BRCH;
  PAGEBY BRCH;
  VAR BRCH ACCTNO NAME PRODUCT CUSTCD SECTORCD COLLCD NOTENO
      STATECD RISKRTE BALANCE APPRLIMT BLDATE SECURE DAYS;
LABEL BRCH   = 'BRANCH'
      RISKRTE = 'RISKCODE';
   TITLE1 'TOTAL OVERDUE LOANS DETAILS';
   TITLE2 'AS AT' &RDATE '(LOANS)';
PROC PRINT DATA=LOAN2 LABEL;
  BY BRCH;
  PAGEBY BRCH;
  VAR BLDATE NAME CUSTCD PRODUCT RISKCODE COLLCD SECTORCD STATECD ACCTNO
      BALANCE APPRLIMT EXCESDT TODDT DAYS BRCH;
  TITLE1 'TOTAL OVERDUE LOANS DETAILS';
  TITLE2 'AS AT' &RDATE '(O/D)';
LABEL BRCH = 'BRANCH';
%MEND PRT;
PROC PRINTTO PRINT=PRINT;
%PRT;
PROC PRINTTO PRINT=ODTLLIST;
%PRT;
*;
