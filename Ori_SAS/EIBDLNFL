//EIBDLNFL JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=64M
/*JOBPARM S=S1M1
//**********************************************************************
//* DAILY APPEND LOANS INFORMATION FOR KEEP
//* TOTAL PAYMENT-MIGRATED A/C FIELD IN LND_LN,ILND_LN,LN_HP,ILN_HP,
//* HPWO,IHPWO DATASETS IN SAS DATAWAREHOUSE
//* ESMR : 2012-3139(DROP) 2013-396
//**********************************************************************
//*
//EIBDLNFL EXEC SAS609
//LNFILE  DD DSN=RBP2.B033.LN4SCFIL(0),DISP=SHR
//LNMIG    DD DSN=SAP.PBB.LNMIG,DISP=OLD
//BNM1     DD DSN=SAP.PBB.MNILN.DAILY(0),DISP=SHR
//SASLIST  DD SYSOUT=X
//SYSIN    DD *

DATA REPTDATE (KEEP=REPTDATE);
  SET BNM1.REPTDATE;
  CALL SYMPUT('REPTYEAR', PUT(REPTDATE, YEAR2.));
  CALL SYMPUT('REPTMON', PUT(MONTH(REPTDATE), Z2.));
  CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE), Z2.));
  CALL SYMPUT('RDATE', PUT(REPTDATE, DDMMYY8.));
  CALL SYMPUT('DATE',PUT(REPTDATE,Z5.));
RUN;
DATA TOTPAY;
   INFILE LNFILE;
   INPUT @001 ACCTNO 11.
         @015 NOTENO 5.
         @080 TOT_MIGR 15.2
         ;
   DATE=&DATE;
RUN;

PROC APPEND DATA=TOTPAY BASE=LNMIG.TOTPAY FORCE;RUN;

PROC SORT DATA=LNMIG.TOTPAY;
  BY ACCTNO NOTENO DESCENDING DATE;
RUN;

PROC SORT DATA=LNMIG.TOTPAY NODUPKEY;BY ACCTNO NOTENO;RUN;

