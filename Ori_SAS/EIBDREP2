//EIBDREP2 JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=128M                    JOB43848
/*JOBPARM S=S1M1
//SAS609    EXEC SAS609
//LOAN      DD DSN=SAP.PBB.REPO.SASDATA(0),DISP=SHR
//LOANP     DD DSN=SAP.PBB.REPO.SASDATA(-1),DISP=SHR
//LOANQ     DD DSN=SAP.PBB.REPO.SASDATA(-2),DISP=SHR
//LN        DD DSN=SAP.PBB.MNILN.DAILY(0),DISP=SHR
//LNTXT     DD DSN=RBP2.B033.EXT.LN5SC.INPMIS,DISP=SHR
//COMBO     DD DSN=RBP2.B033.EXT.LN5SC.OUTMIS(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,10),RLSE),UNIT=SYSDA,
//             DCB=(LRECL=500,RECFM=FB,BLKSIZE=0)
//SORTWK01  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK02  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK03  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK04  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK05  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK06  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK07  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK08  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK09  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK10  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK11  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK12  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK13  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK14  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK15  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK16  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK17  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK18  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK19  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SORTWK20  DD UNIT=SYSDA,SPACE=(CYL,(1000,1000))
//SYSIN     DD *

OPTIONS NOCENTER YEARCUTOFF=1950 LS=132 SORTPARM='HIPRMAX=0,MOSIZE=0'
        COMPRESS=Y NOSORTBLKMODE;

DATA REPTDATE (KEEP=REPTDATE);
  SET LN.REPTDATE;
  MM2 = MONTH(INTNX('MONTH',REPTDATE,-1,'E'));
  MM3 = MONTH(INTNX('MONTH',REPTDATE,-2,'E'));
  CALL SYMPUT('REPTYEAR', PUT(REPTDATE, YEAR2.));
  CALL SYMPUT('REPTMON', PUT(MONTH(REPTDATE), Z2.));
  CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE), Z2.));
  CALL SYMPUT('RDATE', PUT(REPTDATE, Z5.));
  CALL SYMPUT('REPTMON2', PUT(MM2, Z2.));
  CALL SYMPUT('REPTMON3', PUT(MM3, Z2.));
RUN;
DATA REPODATE;
  INFILE LNTXT;
  INPUT @002 ACCTNO    10.
        @012 NOTENO    5.
        @017 PROJDT    11.
        @028 REPODT    11.
        @039 NOTETYPE  $3.
        @042 STATUS    $1.
        @043 REMARK    $50.
        ;
        IF REPODT GT 0 THEN DO;
          DD=SUBSTR(PUT(REPODT,Z11.),3,2);
          MM=SUBSTR(PUT(REPODT,Z11.),1,2);
          YY=SUBSTR(PUT(REPODT,Z11.),5,4);
        END;
        REPTDATE = MDY(MM,DD,YY);
        REPTDATE = REPTDATE-1;
        IF STATUS = 'N' AND REMARK = 'LOAN ACCOUNT NOT FOUND'
        THEN DELETE;
RUN;
PROC SORT DATA=REPODATE; BY ACCTNO NOTENO REPTDATE; RUN;

DATA _NULL_;
   IF   CNT=0 THEN CALL SYMPUT('PROCESS',PUT('N',$1.));
   ELSE            CALL SYMPUT('PROCESS',PUT('Y',$1.));
   SET REPODATE NOBS=CNT;
RUN;

%MACRO EXECUTE;
%IF "&PROCESS" = "Y" %THEN %DO;

PROC MEANS DATA=REPODATE NWAY NOPRINT;
   VAR REPTDATE;
   OUTPUT OUT=REPOSSES MIN=STDATE MAX=LTDATE;
RUN;

DATA _NULL_;
   SET REPOSSES;
   CALL SYMPUT('STDATE',STDATE);
   CALL SYMPUT('LTDATE',LTDATE);
RUN;

DATA REPO;
   SET LOAN.REPOLN&REPTMON LOANP.REPOLN&REPTMON2 LOANQ.REPOLN&REPTMON3;
   WHERE &STDATE<=REPTDATE<=&LTDATE;
RUN;

PROC SORT DATA=REPO; BY ACCTNO NOTENO REPTDATE; RUN;
DATA ALL;
    MERGE REPO(IN=A) REPODATE(IN=B);
    BY ACCTNO NOTENO REPTDATE;
    IF A AND B;
    IF LOANTYPE IN (380,381,700,705,993,996,128,130,983) THEN DO;
      PRINOUT = CURBAL - (INTEARN4+REBATE);
    END;
    IF LOANTYPE IN (720,725,131,132) THEN DO;
      PRINOUT = CURBAL;
    END;
    REBATES = INTEARN4+REBATE;
    TTAMTPAY = APPVALUE + (ORGBAL - NETPROC);
    LESSDEPO = (APPVALUE - NETPROC) + (ORGBAL - CURBAL);
    IF LOANTYPE IN (130,381,705) THEN LESSDEPO = SUM(LESSDEPO,ECSRRSRV);
    LESSSTAT = REBATE + INTEARN4;
    ADDARRS = FEETOT2;

  CURBAL=CURBAL*100;
  APPVALUE=APPVALUE*100;
  NETPROC=NETPROC*100;
  ORGBAL=ORGBAL*100;
  REBATE=REBATE*100;
  INTEARN4=INTEARN4*100;
  PAYAMT=PAYAMT*100;
  TOTBILL=TOTBILL*100;
  PRINOUT=PRINOUT*100;
  REBATES=REBATES*100;
  TOTNPAID=TOTNPAID*100;
  FEETOT2=FEETOT2*100;
  TTAMTPAY=TTAMTPAY*100;
  LESSDEPO=LESSDEPO*100;
  LESSSTAT=LESSSTAT*100;
  ADDARRS=ADDARRS*100;
  OVERINT=OVERINT*100;
  PAYOFF=PAYOFF*100;
  ZERO=0;
  FILE COMBO;
    PUT @001 ZERO      1.
        @002 ACCTNO    10.
        @012 NOTENO    5.
        @017 PROJDT    11.
        @028 REPODT    11.
        @039 NOTETYPE  $3.
        @042 STATUS    $1.
        @043 REMARK    $65.
        @108 PAYOFF    15.
        @123 APPVALUE  15.
        @138 NETPROC   15.
        @153 ORGBAL    15.
        @168 REBATE    15.
        @183 INTEARN4  15.
        @198 PAYAMT    15.
        @213 LOANTYPE  5.
        @218 BILLPAY   7.
        @225 TOTBILL   15.
        @240 PRINOUT   15.
        @255 REBATES   15.
        @270 TOTNPAID  15.
        @285 FEETOT2   15.
        @300 TTAMTPAY  15.
        @315 LESSDEPO  15.
        @330 LESSSTAT  15.
        @345 ADDARRS   15.
        @360 OVERINT   15.
        @375 REPTDATE  6.
        ;
 RUN;

 %END;
 %MEND EXECUTE;
 %EXECUTE;
