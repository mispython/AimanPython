*------------------------------------------------*
*  LOANS - FL/HL USE REPAYMENT DATE              *
*        - OD/RC USE EXPIRY DATE                 *
*------------------------------------------------*;
PROC SORT DATA=BNM1.LOAN&REPTMON&NOWK OUT=NOTEX;
WHERE (PAIDIND NOT IN ('P','C') OR EIR_ADJ NE .) AND
      CUSTCD IN ('41','42','43','44','46','47','48','49',
                 '51','52','53','54','65','66','67','68','69');
BY ACCTNO;RUN;
DATA NOTE (KEEP=PART ITEM REMMTH AMOUNT);
   LENGTH ITEM $6;
   %DCLVAR
   SET NOTEX;
   IF _N_ = 1 THEN DO;
      SET REPTDATE;
      RPYR  = YEAR(REPTDATE);
      RPMTH = MONTH(REPTDATE);
      RPDAY = DAY(REPTDATE);
      IF MOD(RPYR,4) = 0 THEN RD2 = 29;
   END;
   IF SUBSTR(PRODCD,1,2) = '34' OR PRODUCT IN (225,226);
   IF ACCTYPE = 'OD' THEN DO;
      IF PRODUCT IN (151,152,181) THEN DELETE;
      REMMTH = 0.1;
      AMOUNT = BAL_AFT_EIR;
      PART = '2-RM';
      IF CUSTCD IN ('77','78','95','96') THEN
           ITEM = 'A1.07';
      ELSE ITEM = 'A1.03';
      IF PRODCD='34240' THEN DO;
         IF CUSTCD IN ('77','78','95','96') THEN ITEM='A1.08B';
                                            ELSE ITEM='A1.04A';
      END;
      OUTPUT;
   END;
*;
   IF ACCTYPE = 'LN';
   PROD = PUT(PRODUCT,LIQPFMT.);
   IF PRODUCT NOT IN &FCY THEN DO;
   IF CUSTCD IN ('77','78','95','96') THEN
      SELECT (PROD);
         WHEN ('HL') ITEM = 'A1.05';
         WHEN ('RC') ITEM = 'A1.08A';
         OTHERWISE   ITEM = 'A1.08';
      END;
   ELSE SELECT (PROD);
      WHEN ('FL','HL') ITEM = 'A1.01';
      WHEN ('RC') ITEM = 'A1.02';
      OTHERWISE   ITEM = 'A1.04';
   END;
   END;
   IF PRODUCT = 100 THEN
      ITEM = 'A1.05'; /* HARDCODE BY MAZNI */

   IF BLDATE > 0 THEN DAYS = REPTDATE - BLDATE;
   IF EXPRDATE - REPTDATE < 8 THEN REMMTH = 0.1;
   ELSE DO;
      /*  CONVERT PAYFREQ CODE TO MONTHS  */
      SELECT (PAYFREQ);
         WHEN ('1') FREQ = 1;
         WHEN ('2') FREQ = 3;
         WHEN ('3') FREQ = 6;
         WHEN ('4') FREQ = 12;
         OTHERWISE;
      END;
      IF PAYFREQ IN ('5','9',' ') OR PRODUCT IN (350,910,925) THEN
         BLDATE = EXPRDATE;
      ELSE IF BLDATE <= 0 THEN DO;
         BLDATE = ISSDTE;
         DO WHILE (BLDATE <= REPTDATE);
            %NXTBLDT
         END;
      END;
      IF PAYAMT < 0 THEN PAYAMT = 0;
      IF BLDATE > EXPRDATE | BAL_AFT_EIR <= PAYAMT THEN
         BLDATE = EXPRDATE;
      DO WHILE (BLDATE <= EXPRDATE);
         MATDT = BLDATE;
         %REMMTH
         IF REMMTH > 12 OR BLDATE = EXPRDATE THEN LEAVE;

         IF REMMTH > 0.255 AND (BLDATE-REPTDATE) < 8
                                             THEN REMMTH=0.255;

         AMOUNT = PAYAMT;
         BAL_AFT_EIR = BAL_AFT_EIR - PAYAMT;
         IF PRODUCT IN &FCY THEN DO;
            IF PROD='FL' THEN ITEM='B1.01';
            IF PROD='RC' THEN ITEM='B1.02';
            PART = '2-FC'; OUTPUT;
         END;
         ELSE DO;
            PART = '2-RM'; OUTPUT;
         END;
         IF DAYS > 89 OR LOANSTAT ^= 1 THEN REMMTH = 13;
         IF PRODUCT IN &FCY THEN DO;
            IF PROD='FL' THEN ITEM='B1.01';
            IF PROD='RC' THEN ITEM='B1.02';
            PART = '1-FC'; OUTPUT;
         END;
         ELSE DO;
            PART = '1-RM'; OUTPUT;
         END;
         %NXTBLDT
         IF BLDATE > EXPRDATE | BAL_AFT_EIR <= PAYAMT THEN
            BLDATE = EXPRDATE;
      END;
   END;
   AMOUNT = BAL_AFT_EIR;
   IF PRODUCT IN &FCY THEN DO;
      IF PROD='FL' THEN ITEM='B1.01';
      IF PROD='RC' THEN ITEM='B1.02';
      PART = '2-FC'; OUTPUT;
   END;
   ELSE DO;
      PART = '2-RM'; OUTPUT;
   END;

   IF DAYS > 89 OR LOANSTAT ^= 1 THEN REMMTH = 13;
   IF PRODUCT IN &FCY THEN DO;
      IF PROD='FL' THEN ITEM='B1.01';
      IF PROD='RC' THEN ITEM='B1.02';
      PART = '1-FC'; OUTPUT;
   END;
   ELSE DO;
      PART = '1-RM'; OUTPUT;
   END;
