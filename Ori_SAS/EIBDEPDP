//EIBDEPDP JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=8M
/*JOBPARM S=S1M1
//* TO RUN DAILY TO ACCUMULATE DP DATA (ESMR: 2011-1379)
//*
//GETFILE  EXEC SAS609
//DPLD      DD DSN=RBP2.B033.LN.BNM.LOANDISB.RPT(0),DISP=SHR
//DPLP      DD DSN=RBP2.B033.MIS.BNM.LOANPYMT.RPT(0),DISP=SHR
//DPCC      DD DSN=RBP2.B033.UC.BNM.CRDTPYMT.RPT(0),DISP=SHR
//LOAN      DD DSN=SAP.PBB.MNILN.DAILY(0),DISP=SHR
//BNMLD     DD DSN=SAP.PBB.EPCU.LOANDISB,DISP=OLD
//BNMLP     DD DSN=SAP.PBB.EPCU.LOANPYMT,DISP=OLD
//BNMCC     DD DSN=SAP.PBB.EPCU.CRDTPYMT,DISP=OLD
//SASLIST  DD SYSOUT=X
//PGM      DD DSN=SAP.BNM.PROGRAM,DISP=SHR
//SYSIN    DD *

OPTION NOCENTER;
DATA REPTDATE (KEEP=REPTDATE);
  SET LOAN.REPTDATE;
  CALL SYMPUT('REPTYEAR', PUT(REPTDATE, YEAR2.));
  CALL SYMPUT('REPTMON', PUT(MONTH(REPTDATE), Z2.));
  CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE), Z2.));
  CALL SYMPUT('RDATE', PUT(REPTDATE, Z5.));
RUN;

OPTIONS YEARCUTOFF=1930 NOCENTER NODATE;
*;
DATA DPLD;
 INFILE DPLD MISSOVER;
 INPUT @001   ACCTNO          11.
       @013   TRANAMT         11.2
       @024   TRANDT       MMDDYY6.
       @033   TRANTME         10.
       @043   ONLTRAN         10.
       @053   CHEQNO          10.
       @063   CURRCODE        $3.
       ;
 REPTDATE=&RDATE;
RUN;
PROC PRINT DATA=DPLD(OBS=10);RUN;

DATA DPLP;
 INFILE DPLP MISSOVER;
 INPUT @001   ACCTNO          11.
       @013   TRANAMT         11.2
       @024   TRANDT       MMDDYY6.
       @033   TRANTME         10.
       @043   ONLTRAN         10.
       @053   CHEQNO          10.
       @063   CURRCODE        $3.
       ;
 REPTDATE=&RDATE;
RUN;
PROC PRINT DATA=DPLP(OBS=10);RUN;

DATA DPCC;
 INFILE DPCC MISSOVER;
 INPUT @001   ACCTNO          11.
       @013   TRANAMT         11.2
       @024   TRANDT       MMDDYY6.
       @033   TRANTME         10.
       @043   ONLTRAN         10.
       @053   CHEQNO          10.
       @063   CURRCODE        $3.
       ;
 REPTDATE=&RDATE;
RUN;
PROC PRINT DATA=DPCC(OBS=10);RUN;

%MACRO ACCUM;
%IF "&REPTDAY" EQ "01" %THEN
    %DO;
      DATA BNMLD.DPLD&REPTMON;
        SET DPLD;
      RUN;
      DATA BNMLP.DPLP&REPTMON;
        SET DPLP;
      RUN;
      DATA BNMCC.DPCC&REPTMON;
        SET DPCC;
      RUN;
    %END;
%ELSE %DO;
      DATA BNMLD.DPLD&REPTMON;
        SET BNMLD.DPLD&REPTMON;
        IF REPTDATE EQ "&RDATE" THEN DELETE;
      RUN;
      PROC APPEND DATA=DPLD
                  BASE=BNMLD.DPLD&REPTMON;RUN;

      DATA BNMLP.DPLP&REPTMON;
        SET BNMLP.DPLP&REPTMON;
        IF REPTDATE EQ "&RDATE" THEN DELETE;
      RUN;
      PROC APPEND DATA=DPLP
                  BASE=BNMLP.DPLP&REPTMON;RUN;

      DATA BNMCC.DPCC&REPTMON;
        SET BNMCC.DPCC&REPTMON;
        IF REPTDATE EQ "&RDATE" THEN DELETE;
      RUN;
      PROC APPEND DATA=DPCC
                  BASE=BNMCC.DPCC&REPTMON;RUN;
%END;
%MEND ACCUM;
%ACCUM;
