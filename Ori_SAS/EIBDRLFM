*------------------------------------------------*
*  FCY CURRENT                                   *
*------------------------------------------------*;
DATA FCYCA (KEEP=BNMCODE AMOUNT AMTUSD AMTSGD AMTHKD AMTAUD)
     LCR.FCYCA&REPTDAY(KEEP=BNMCODE BRANCH ACCTNO AMOUNT CURCODE CUSTCD
                            PRODUCT REMMTH REM30D INTRATE BILLERIND)
     CLSFCYCA(KEEP=BRANCH ACCTNO NAME AMOUNT CUSTCODE PRODUCT OPENIND
                   CURCODE MYRAMOUNT RENAME=(CUSTCODE=CUSTCD));
   SET DEPOSIT.CURRENT;
   LENGTH CUSTCD $2.;
   CUSTCD=PUT(CUSTCODE, DDCUSTCD.);
   IF (400<=PRODUCT<=444) OR PRODUCT IN (450:454);
   IF PRODUCT=413 THEN DELETE;
   AMTUSD=0; AMTSGD=0; AMTHKD=0; AMTAUD=0;
   IF CUSTCD IN ('77','78','95','96') THEN CUST = '08';
   ELSE CUST = '09';
   BNMCODE = '96313'||CUST||'01'||'0000Y';
   IF PRODUCT IN (400,420,440,450) THEN AMTUSD=CURBAL;
   IF PRODUCT IN (403,423) THEN AMTSGD=CURBAL;
   IF PRODUCT IN (406,426) THEN AMTHKD=CURBAL;
   IF PRODUCT IN (402,422,442,452) THEN AMTAUD=CURBAL;
   IF CURCODE NE 'MYR' THEN DO;
      FORATE = PUT(CURCODE,$FORATE.);
      MYRAMOUNT = CURBAL * FORATE;
   END;
   RENAME CURBAL=AMOUNT;
   OUTPUT FCYCA LCR.FCYCA&REPTDAY;
   IF OPENIND IN ('B','C','P') AND CURBAL NE 0 THEN OUTPUT CLSFCYCA;
