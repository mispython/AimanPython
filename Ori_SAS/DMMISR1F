*;
OPTIONS NOCENTER NODATE NONUMBER MISSING=0;
*;
TITLE1 'REPORT ID : DMMISR1F';
TITLE2 'PUBLIC BANK BERHAD';
TITLE3 'SALES ADMINISTRATION & SUPPORT';
TITLE4 "BANK'S TOTAL FOREIGN CURRENCY DEPOSITS (RM)";
TITLE5 'AS AT ' &XDATE;
RUN;
*;
PROC REPORT DATA=MIS.DYFCY&REPTMON NOWD HEADLINE SPLIT='*';
COLUMN REPTDATE TOTFDFY TOTFCFY TOTFYFD TOFFDFIC TOTCAFY TOTCAFYI
       TOTFYCA TOTFCY TOFFDIDC TOFFDNDC TOFCAFIC TOFCAFII TOTFCAFI
       TOTFCYFI TOFCAIDC TOFCANDC TOFCAIDI TOFCANDI TOTFCAID TOTFCAND
       RTOTFDFY RTOTFCFY RTOTFYFD RTFFDFIC RTOTCAFY RTOTCAFI RTOTFYCA
       RTOTFCY RTFFDIDC RTFFDNDC RTFCAFIC RTFCAFII RTTFCAFI RTTFCYFI
       RTFCAIDC RTFCANDC RTFCAIDI RTFCANDI RTTFCAID RTTFCAND;

  DEFINE REPTDATE / GROUP FORMAT=DDMMYY8. 'DATE';
  DEFINE TOTFDFY  / NOPRINT;
  DEFINE RTOTFDFY / COMPUTED FORMAT=COMMA17.
                   'FCY FD*BALANCE*(EXCL.FI)';
  DEFINE TOTFCFY  / NOPRINT;
  DEFINE RTOTFCFY / COMPUTED FORMAT=COMMA17.
                   'FCY FD*FOREIGN*COMPANIES';
  DEFINE TOTFYFD  / NOPRINT;
  DEFINE RTOTFYFD / COMPUTED FORMAT=COMMA14.
                   'FCY FD*TOTAL';
  DEFINE TOFFDFIC / NOPRINT;
  DEFINE RTFFDFIC / COMPUTED FORMAT=COMMA14.
                   'FCY FD-C FI';
  DEFINE TOTCAFY  / NOPRINT;
  DEFINE RTOTCAFY / COMPUTED FORMAT=COMMA14.
                   'FCY CA-C*BALANCE*(EXCL.FI)';
  DEFINE TOTCAFYI / NOPRINT;
  DEFINE RTOTCAFI / COMPUTED FORMAT=COMMA14.
                   'FCY CA-I*BALANCE*(EXCL.FI)';
  DEFINE TOTFYCA  / NOPRINT;
  DEFINE RTOTFYCA / COMPUTED FORMAT=COMMA14.
                   'FCY CA*TOTAL';
  DEFINE TOTFCY   / NOPRINT;
  DEFINE RTOTFCY  / COMPUTED FORMAT=COMMA14.
                   'TOTAL*FCY*BALANCE';
  DEFINE TOFFDIDC / NOPRINT;
  DEFINE RTFFDIDC / COMPUTED FORMAT=COMMA14.
                   'FCY FD-C*INDV';
  DEFINE TOFFDNDC / NOPRINT;
  DEFINE RTFFDNDC / COMPUTED FORMAT=COMMA14.
                   'FCY FD-C*NON-INDV';
  DEFINE TOFCAFIC / NOPRINT;
  DEFINE RTFCAFIC / COMPUTED FORMAT=COMMA14.
                   'FCY CA-C FI';
  DEFINE TOFCAFII / NOPRINT;
  DEFINE RTFCAFII / COMPUTED FORMAT=COMMA14.
                   'FCY CA-I FI';
  DEFINE TOTFCAFI / NOPRINT;
  DEFINE RTTFCAFI / COMPUTED FORMAT=COMMA14.
                   'TOTAL*FCY CA FI';
  DEFINE TOTFCYFI / NOPRINT;
  DEFINE RTTFCYFI / COMPUTED FORMAT=COMMA14.
                   'TOTAL*FCY FI';
  DEFINE TOFCAIDC / NOPRINT;
  DEFINE RTFCAIDC / COMPUTED FORMAT=COMMA14.
                   'FCY CA-C*INDV';
  DEFINE TOFCANDC / NOPRINT;
  DEFINE RTFCANDC / COMPUTED FORMAT=COMMA14.
                   'FCY CA-C*NON-INDV';
  DEFINE TOFCAIDI / NOPRINT;
  DEFINE RTFCAIDI / COMPUTED FORMAT=COMMA14.
                   'FCY CA-I*INDV';
  DEFINE TOFCANDI / NOPRINT;
  DEFINE RTFCANDI / COMPUTED FORMAT=COMMA14.
                   'FCY CA-I*NON-INDV';
  DEFINE TOTFCAID / NOPRINT;
  DEFINE RTTFCAID / COMPUTED FORMAT=COMMA14.
                   'TOTAL*FCY CA INDV';
  DEFINE TOTFCAND / NOPRINT;
  DEFINE RTTFCAND / COMPUTED FORMAT=COMMA14.
                   'TOTAL*FCY CA NON-INDV';
  COMPUTE RTOTFDFY;
    RTOTFDFY=ROUND(TOTFDFY.SUM,1);
  ENDCOMP;
  COMPUTE RTOTFCFY;
    RTOTFCFY=ROUND(TOTFCFY.SUM,1);
  ENDCOMP;
  COMPUTE RTOTFYFD;
    RTOTFYFD=ROUND(TOTFYFD.SUM,1);
  ENDCOMP;
  COMPUTE RTFFDFIC;
    RTFFDFIC=ROUND(TOFFDFIC.SUM,1);
  ENDCOMP;
  COMPUTE RTOTCAFY;
    RTOTCAFY=ROUND(TOTCAFY.SUM,1);
  ENDCOMP;
  COMPUTE RTOTCAFI;
    RTOTCAFI=ROUND(TOTCAFYI.SUM,1);
  ENDCOMP;
  COMPUTE RTOTFYCA;
    RTOTFYCA=ROUND(TOTFYCA.SUM,1);
  ENDCOMP;
  COMPUTE RTOTFCY;
    RTOTFCY=ROUND(TOTFCY.SUM,1);
  ENDCOMP;
  COMPUTE RTFFDIDC;
    RTFFDIDC=ROUND(TOFFDIDC.SUM,1);
  ENDCOMP;
  COMPUTE RTFFDNDC;
    RTFFDNDC=ROUND(TOFFDNDC.SUM,1);
  ENDCOMP;
  COMPUTE RTFCAFIC;
    RTFCAFIC=ROUND(TOFCAFIC.SUM,1);
  ENDCOMP;
  COMPUTE RTFCAFII;
    RTFCAFII=ROUND(TOFCAFII.SUM,1);
  ENDCOMP;
  COMPUTE RTTFCAFI;
    RTTFCAFI=ROUND(TOTFCAFI.SUM,1);
  ENDCOMP;
  COMPUTE RTTFCYFI;
    RTTFCYFI=ROUND(TOTFCYFI.SUM,1);
  ENDCOMP;
  COMPUTE RTFCAIDC;
    RTFCAIDC=ROUND(TOFCAIDC.SUM,1);
  ENDCOMP;
  COMPUTE RTFCANDC;
    RTFCANDC=ROUND(TOFCANDC.SUM,1);
  ENDCOMP;
  COMPUTE RTFCAIDI;
    RTFCAIDI=ROUND(TOFCAIDI.SUM,1);
  ENDCOMP;
  COMPUTE RTFCANDI;
    RTFCANDI=ROUND(TOFCANDI.SUM,1);
  ENDCOMP;
  COMPUTE RTTFCAID;
    RTTFCAID=ROUND(TOTFCAID.SUM,1);
  ENDCOMP;
  COMPUTE RTTFCAND;
    RTTFCAND=ROUND(TOTFCAND.SUM,1);
  ENDCOMP;
