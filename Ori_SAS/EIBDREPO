//EIBDREPO JOB MSGCLASS=X,MSGLEVEL=(1,1),REGION=64M                     JOB43848
/*JOBPARM S=S1M2
//SAS609    EXEC SAS609
//ACCTFILE  DD DSN=RBP2.SAS.B033.ACCTFILE,DISP=SHR
//LN        DD DSN=SAP.PBB.MNILN.DAILY(0),DISP=SHR
//OITXT     DD DSN=RBP2.B033.LNHPINTO.INTOUT(0),DISP=SHR
//LOAN      DD DSN=SAP.PBB.REPO.SASDATA(0),DISP=OLD
//PGM       DD DSN=SAP.BNM.PROGRAM,DISP=SHR
//SORTWK01  DD UNIT=SYSDA,SPACE=(CYL,800)
//SORTWK02  DD UNIT=SYSDA,SPACE=(CYL,800)
//SORTWK03  DD UNIT=SYSDA,SPACE=(CYL,800)
//SORTWK04  DD UNIT=SYSDA,SPACE=(CYL,800)
//SORTWK05  DD UNIT=SYSDA,SPACE=(CYL,800)
//SYSIN     DD *

OPTIONS NOCENTER YEARCUTOFF=1950 LS=132;

DATA REPTDATE (KEEP=REPTDATE);
  SET LN.REPTDATE;
  CALL SYMPUT('REPTYEAR', PUT(REPTDATE, YEAR2.));
  CALL SYMPUT('REPTMON', PUT(MONTH(REPTDATE), Z2.));
  CALL SYMPUT('REPTDAY', PUT(DAY(REPTDATE), Z2.));
  CALL SYMPUT('RDATE', PUT(REPTDATE, Z5.));
RUN;
*;
%INC PGM(PBBLNFMT);
DATA LNFILE;
  INFILE ACCTFILE;
  INPUT @001 ACCTNO    PD6.
        @081 NOTENO    PD3.
        @085 LOANTYPE  PD2.
        @121 CURBAL    PD8.2
        @145 APPVALUE  PD8.2
        @262 ORGBAL    PD8.2
        @270 NETPROC   PD8.2
        @278 TOTFEE    PD8.2
        @303 REBATEX   PD8.2
        @416 INTEARN4X PD8.2
        @424 PAYAMT    PD8.2
        @441 FEETOTAL  PD8.2
        @449 FEETOT2   PD8.2
        @1116 ECSRRSRV PD8.2
        @1194 OVERFEE  PD8.2
        ;
        REPTDATE=&RDATE;
        IF LOANTYPE IN &HP;
RUN;
*;
DATA OI(DROP=YY MM DD);
  INFILE OITXT;
  INPUT @002 ACCTNO    11.
        @013 NOTENO    5.
        @019 YY        $4.
        @023 MM        $2.
        @025 DD        $2.
        @037 OVERINT   15.2
        @054 PAYOFF    15.2
        @071 TOTNPAID  15.2
        @088 TOTBILL   15.2
        @105 BILLPAY    7.
        @105 BILLCNT    7.
        @112 BILLSIGN  $1.
        @114 REBATE    15.2
        @131 INTEARN4  15.2
        ;
        IF BILLSIGN = '-' THEN BILLPAY = 0;
        REPTDATE = MDY(MM,DD,YY);
RUN;
PROC SORT DATA=OI;     BY ACCTNO NOTENO REPTDATE; RUN;
PROC SORT DATA=LNFILE; BY ACCTNO NOTENO REPTDATE; RUN;
*;
DATA LNFILE;
    MERGE LNFILE(IN=A) OI(IN=B);
    BY ACCTNO NOTENO REPTDATE;
    IF A;
RUN;

%MACRO ACCUM;
%IF "&REPTDAY" EQ "01" %THEN
    %DO;
      DATA LOAN.REPOLN&REPTMON;
        SET LNFILE;
      RUN;
    %END;
%ELSE %DO;
      DATA LOAN.REPOLN&REPTMON;
        SET LOAN.REPOLN&REPTMON;
        IF REPTDATE EQ "&RDATE" THEN DELETE;
      RUN;
      DATA LOAN.REPOLN&REPTMON;
        SET LOAN.REPOLN&REPTMON LNFILE;
      RUN;
%END;
%MEND ACCUM;
%ACCUM;
