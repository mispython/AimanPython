trigger: none

pool:
  name: DWH-BGNVMBLD108

resources:
  repositories:
    - repository: sharedTemplates
      type: git
      name: 'MIS/pipeline-templates'
      ref: refs/heads/main

steps:
- template: templates/Pipeline-GitDiff.yml@sharedTemplates
  parameters:
    sonarProjectKey: 'MIS_MIS_AZiHuZxBe6JhXmPgx7c1'
    cliSources: '.'
    SonarQubeEndPoint: 'SonarQube'
    scannerMode: 'cli'
    configMode: 'manual'

- task: CopyFiles@2
  inputs:
    SourceFolder: '$(Build.SourcesDirectory)'
    Contents: '**'
    TargetFolder: '$(Build.ArtifactStagingDirectory)'

- task: PublishBuildArtifacts@1
  inputs:
    PathtoPublish: '$(Build.ArtifactStagingDirectory)'
    ArtifactName: 'drop'
    publishLocation: 'Container'
