    "PREBANK": pl.Int64,
    "MICRPRE": pl.Int64,
    "CHKTYPE": pl.Int64,
    "BRCODE": pl.Int64,
    "UICCODE": pl.Utf8,
}

BR_SCHEMA = {
    "MICRPAY": pl.Int64,
    "BRANCH": pl.Int64,
}

