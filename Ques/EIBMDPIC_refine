# =============================================================================
# FIXED-WIDTH FLAT FILE PARSERS
# All @positions are 1-based in SAS; Python uses 0-based slicing [pos-1 : pos-1+len].
# =============================================================================
# The production feeds are fixed-width byte records.  Some environments deliver
# them as EBCDIC (cp037) while UAT/debug copies are often ASCII/UTF-8.  Do not
# hard-code one codec and silently turn parse failures into zero; that creates
# meaningless rows and can multiply joins on MICRPAY=0.
DEFAULT_ENCODINGS = ("utf-8", "cp037", "latin1")
FILE_ENCODING = os.getenv("EIBMDPIC_ENCODING", "auto").strip().lower()
MAX_PARSE_ERROR_RATE = float(os.getenv("EIBMDPIC_MAX_PARSE_ERROR_RATE", "0.20"))
PREVIEW_ROWS = int(os.getenv("EIBMDPIC_PREVIEW_ROWS", "10"))


def _read_sample_lines(filepath: Path, limit: int = 50) -> list[bytes]:
    """Read non-empty sample records for encoding detection and validation."""
    sample = []
    with open(filepath, "rb") as fh:
        for raw_line in fh:
            line = raw_line.rstrip(b"\r\n")
            if line:
                sample.append(line)
            if len(sample) >= limit:
                break
    return sample


def _chunk(line: bytes, start1: int, length: int) -> bytes:
    """Extract raw bytes from a fixed-width record using SAS 1-based positions."""
    s = start1 - 1
    return line[s: s + length]


def _decode_chunk(line: bytes, start1: int, length: int, encoding: str) -> str:
    return _chunk(line, start1, length).decode(encoding, errors="replace")


def _slice_str(line: bytes, start1: int, length: int, encoding: str) -> str | None:
    """Extract a character field; all-blank fields remain null, not empty strings."""
    value = _decode_chunk(line, start1, length, encoding).strip()
    return value or None


def _parse_num(raw: str) -> int | None:
    raw = raw.strip()
    if not raw:
        return None
    if raw.isdigit() or (raw.startswith(("+", "-")) and raw[1:].isdigit()):
        return int(raw)
    return None


def _slice_num(line: bytes, start1: int, length: int, encoding: str) -> int | None:
    """Extract a display numeric field; invalid values remain null, not zero."""
    return _parse_num(_decode_chunk(line, start1, length, encoding))


def _slice_num_float(
    line: bytes, start1: int, length: int, encoding: str, decimals: int = 0
) -> float | None:
    """
    Extract a display numeric with implied decimals (e.g. SAS 10.2 informat).
    Invalid values remain null so bad layouts/codecs are visible in validation.
    """
    raw = _decode_chunk(line, start1, length, encoding).strip()
    if not raw:
        return None
    try:
        value = float(raw)
    except ValueError:
        return None
    # If SAS informat specifies implied decimals and no decimal point in data
    if "." not in raw and decimals:
        value /= 10 ** decimals
    return value


def _choose_encoding(filepath: Path, numeric_fields: tuple[tuple[int, int], ...]) -> str:
    """Pick the codec that makes fixed-width numeric fields look most valid."""
    if FILE_ENCODING != "auto":
        return FILE_ENCODING

    sample_lines = _read_sample_lines(filepath)
    if not sample_lines:
        return DEFAULT_ENCODINGS[0]

    best_encoding = DEFAULT_ENCODINGS[0]
    best_score = -1
    for encoding in DEFAULT_ENCODINGS:
        score = 0
        for line in sample_lines:
            for start1, length in numeric_fields:
                raw = _decode_chunk(line, start1, length, encoding).strip()
                if not raw or raw.isdigit() or (raw.startswith(("+", "-")) and raw[1:].isdigit()):
                    score += 1
        if score > best_score:
            best_encoding = encoding
            best_score = score
    return best_encoding


def _print_parse_quality(name: str, df: pl.DataFrame, key_columns: list[str]) -> None:
    """Print null/duplicate quality checks so bad input is obvious immediately."""
    print(f"[{name}] rows parsed: {len(df)}")
    if df.is_empty():
        return
    for column in key_columns:
        null_count = df.select(pl.col(column).is_null().sum()).item()
        if null_count:
            print(f"[{name}] WARNING: {column} has {null_count:,} null values")


def _reject_bad_parse(name: str, df: pl.DataFrame, required_columns: list[str]) -> None:
    """Fail fast when required fixed-width fields cannot be parsed reliably."""
    if df.is_empty():
        return
    for column in required_columns:
        null_count = df.select(pl.col(column).is_null().sum()).item()
        error_rate = null_count / len(df)
        if error_rate > MAX_PARSE_ERROR_RATE:
            raise ValueError(
                f"{name}: {column} is null in {null_count:,}/{len(df):,} rows "
                f"({error_rate:.1%}). Check file encoding/layout, or set "
                "EIBMDPIC_ENCODING to utf-8, cp037, or latin1."
            )


def _dedupe_lookup(df: pl.DataFrame, dataset: str, key: str) -> pl.DataFrame:
    """Drop null lookup keys and keep one row per key to avoid Cartesian joins."""
    before = len(df)
    cleaned = df.filter(pl.col(key).is_not_null()).unique(key, keep="first")
    removed = before - len(cleaned)
    if removed:
        print(f"[{dataset}] WARNING: removed {removed:,} null/duplicate {key} lookup rows")
    return cleaned


def _safe_date(year: int | None, month: int | None, day: int | None):
    """Return a Python date or None when source fields are not a valid date.

    SAS date functions produce a missing value for invalid components.  Using
    None gives Polars a null date instead of raising a ComputeError for values
    such as (0, 0, 0).
    """
    if year is None or month is None or day is None:
        return None
    try:
        return date(year, month, day)
    except ValueError:
        return None


