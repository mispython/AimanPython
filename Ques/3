def _safe_date(year: int, month: int, day: int):
    """Return a Python date or None when source fields are not a valid date.

    SAS date functions produce a missing value for invalid components.  Using
    None gives Polars a null date instead of raising a ComputeError for values
    such as (0, 0, 0).
    """
    try:
        return date(year, month, day)
    except ValueError:
        return None


