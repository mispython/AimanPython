def _write_page(
    report_file,
    title_lines: list[str],
    header_lines: list[str],
    data_lines: list[str],
    add_form_feed: bool,
) -> bool:

    page_lines = title_lines + header_lines + data_lines

    if len(page_lines) > PAGE_SIZE:
        raise ValueError(
            f"PAGE_SIZE={PAGE_SIZE} exceeded: page has {len(page_lines)} lines."
        )

    if add_form_feed and page_lines:

        # Remove ONLY the trailing newline from the previous row
        # before starting a new page.
        report_file.seek(report_file.tell() - 1)

        report_file.write("\f")
        report_file.write(page_lines[0])

        remaining_lines = page_lines[1:]

    else:
        remaining_lines = page_lines

    for line in remaining_lines:
        report_file.write(line)

    return True
