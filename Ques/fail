# A filename carrying the report date (<PREFIX>*<yymmdd>*.txt) is used when
# present; otherwise the undated <PREFIX>.txt is used.
# ============================================================
def resolve_input_file(prefix: str) -> Path:
    """Resolve the daily input file for a prefix (dated if available, else undated)."""
    dated_matches = sorted(INPUT_DIR.glob(f"{prefix}*{REPTDATE_YYMMDD}*.txt"))
    if dated_matches:
        return dated_matches[-1]

    plain_file = INPUT_DIR / f"{prefix}.txt"
    if plain_file.exists():
        return plain_file

    raise FileNotFoundError(f"Input file for {prefix} not found in {INPUT_DIR}")


