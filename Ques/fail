# Input files
PIBB_INPUT_FILE = INPUT_DIR / "WOFFTXTI.txt"   # SAP.PIBB.FTPLNS.WOFFTXT
PBB_INPUT_FILE  = INPUT_DIR / "WOFFTXT.txt"    # SAP.PBB.FTPLNS.WOFFTXT

