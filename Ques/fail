def sas_to_parquet(sas_path: Path, cache_path: Path, tag: str) -> None:
    """Stream a .sas7bdat into Parquet using a schema-locked chunked writer.
       Always creates a Parquet file -- even if the SAS dataset is empty.
    """
    print(f"  [{tag}] Converting {sas_path.name} -> {cache_path.name} ...")
    writer = None
    schema = None
    total = 0

    reader = pd.read_sas(sas_path, encoding="latin1", chunksize=CHUNK_ROWS)
    try:
        for chunk in reader:
            # Force text columns to string so an all-null first chunk doesn't lock a null type
            for col in chunk.columns[chunk.dtypes == object]:
                chunk[col] = chunk[col].astype("string")
            table = pa.Table.from_pandas(chunk, preserve_index=False)

            if writer is None:
                schema = table.schema
                writer = pq.ParquetWriter(cache_path, schema, compression="snappy")
            else:
                cast_arrays = []
                for field in schema:
                    col = table.column(field.name)
                    if col.type != field.type:
                        try:
                            col = col.cast(field.type, safe=False)
                        except Exception as e:
                            print(f"  [{tag}] WARNING: cannot cast '{field.name}': {e} -> nulls")
                            col = pa.nulls(len(col), type=field.type)
                    cast_arrays.append(col)
                table = pa.Table.from_arrays(cast_arrays, schema=schema)

            writer.write_table(table)
            total += len(chunk)
            del chunk, table
            gc.collect()
    finally:
        if writer is not None:
            writer.close()

    if writer is None:
        # No data at all -- still write a Parquet file carrying the column definitions
        df_empty = pd.read_sas(sas_path, encoding="latin1")
        for col in df_empty.columns[df_empty.dtypes == object]:
            df_empty[col] = df_empty[col].astype("string")
        pq.write_table(pa.Table.from_pandas(df_empty, preserve_index=False),
                       cache_path, compression="snappy")

    print(f"  [{tag}] Done -- {total:,} rows converted.")


def ensure_cached(sas_path: Path, tag: str, entity_filter: bool = False) -> Path:
    """Convert a .sas7bdat to a temporary Parquet file once per run and return its path.

    entity_filter=True keeps only ENTITY_CD = 'PIBB' rows in the Parquet file.
    """
    key = (str(sas_path), entity_filter)
    if key in _PQ_REGISTRY:
        print(f"  [{tag}] Already converted this run -- reusing temporary Parquet.")
        return _PQ_REGISTRY[key]

    if not sas_path.exists():
        raise FileNotFoundError(f"[{tag}] Input file not found: {sas_path}")

    pq_path = CACHE_DIR / f"{sas_path.stem}.parquet"

    if entity_filter:
        raw_path = CACHE_DIR / f"{sas_path.stem}_raw.parquet"
        sas_to_parquet(sas_path, raw_path, tag)
        con = duckdb.connect(database=":memory:")
        try:
            con.execute(f"""
                COPY (
                    SELECT * FROM read_parquet('{raw_path.as_posix()}')
                    WHERE TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = '{ENTITY_CD_FILTER}'
                ) TO '{pq_path.as_posix()}' (FORMAT PARQUET, COMPRESSION SNAPPY)
            """)
            kept = con.execute(
                f"SELECT COUNT(*) FROM read_parquet('{pq_path.as_posix()}')"
            ).fetchone()[0]
        finally:
            con.close()
        raw_path.unlink()
        print(f"  [{tag}] ENTITY_CD = '{ENTITY_CD_FILTER}' filter kept {kept:,} rows.")
    else:
        sas_to_parquet(sas_path, pq_path, tag)

    _PQ_REGISTRY[key] = pq_path
    return pq_path




