python3 - <<'PY'
import re
from pathlib import Path

sas = Path("/path/to/expected_FISS.txt").read_text().splitlines()
py  = Path("/path/to/your_FISS.txt").read_text().splitlines()

def parse(lines):
    hdr = lines[0].strip()
    d = {}
    for ln in lines[1:]:
        if not ln.strip():
            continue
        p = ln.split(";")
        d[p[0]] = tuple(int(x) for x in p[1:6])
    return hdr, d

hs, ds = parse(sas)
hp, dp = parse(py)
print("headers :", hs, "vs", hp, "match:", hs == hp)
print("codes in SAS, not Python:", sorted(set(ds) - set(dp)))
print("codes in Python, not SAS:", sorted(set(dp) - set(ds)))
diff = [k for k in ds.keys() & dp.keys() if ds[k] != dp[k]]
print(f"{len(diff)} matching codes with differing amounts:")
for k in diff[:20]:
    print(f"  {k}  SAS={ds[k]}  PY={dp[k]}")
PY
