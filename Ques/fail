PARQUET_REGISTRY: dict = {}


def to_parquet_once(tag: str, sas_path: Path) -> Path:
    """Return the temp parquet for *tag*, converting the SAS file only the first time."""
    if tag in PARQUET_REGISTRY:
        return PARQUET_REGISTRY[tag]
    if not sas_path.exists():
        raise FileNotFoundError(f"[{tag}] Input file not found: {sas_path}")
    parquet_path = TMP_PATH / f"{tag.lower()}.parquet"
    sas_to_parquet(sas_path, parquet_path, tag)
    PARQUET_REGISTRY[tag] = parquet_path
    return parquet_path


