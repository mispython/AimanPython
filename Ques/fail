def _rtrim(s) -> str:
    return (s or "").rstrip(" ")


def _format_output_line(row: dict, n_cards: int) -> str:
    fields = [
        _rtrim(row["NEWIC"]),
        _rtrim(row["PRIPHONE"]),
        _rtrim(row["SECPHONE"]),
        _rtrim(row["MOBIPHON"]),
        _rtrim(row["ACCTNO"]),
        _rtrim(row["BUSSREG"]),
    ]
    for idx in range(1, n_cards + 1):
        fields.append(_rtrim(row.get(f"CARD{idx}")))
    return "|".join(fields)


