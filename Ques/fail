    )




    def _int_str(v) -> str:
        if v is None:
            return ""
        try:
            return str(int(v))
        except Exception:
            return str(v)

    def _header_block() -> list:
        return [
            f"{'':>6} {'BRANCH':>7}  {'MNI NO':>12}  {'DEPOSITOR':<26}  "
            f"{'CIS NO':>8}  {'CUSTCD':>7}  {'CURRENT BALANCE':>18}  {'PRODUCT':>8}",
