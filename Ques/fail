def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM for the given SOURCE_SYSTEM_CD from the control file."""
    if not CTL_BATCH_DTTM.exists():
        raise FileNotFoundError(f"Batch date control file not found: {CTL_BATCH_DTTM}")
    ctl = pd.read_sas(str(CTL_BATCH_DTTM), encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {CTL_BATCH_DTTM}")
    return pd.Timestamp(hit.iloc[0]).date()


def get_sftp_info(sftp_id: str, host_ip: str):
    """Read exactly one SFTP row (matched on SFTP_ID + HOST_IP) from the control file."""
    if not CTL_SFTP_INFO.exists():
        raise FileNotFoundError(f"SFTP control file not found: {CTL_SFTP_INFO}")
    ctl = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    ctl.columns = [str(c).upper().strip() for c in ctl.columns]

    clean = lambda v: "".join(str(v).split()) if pd.notna(v) else ""
    ids   = ctl["SFTP_ID"].map(clean)
    hosts = ctl["HOST_IP"].map(clean).str.lower()
    rows  = ctl[(ids == sftp_id) & (hosts == host_ip.lower())]
    if len(rows) != 1:
        raise RuntimeError(
            f"Expected exactly one SFTP row for '{sftp_id}@{host_ip}'; found {len(rows)}"
        )

    row = rows.iloc[0]
    pw, ip = clean(row["SFTP_PW"]), clean(row["HOST_IP"])
    host_key = clean(row["HOST_KEY"]) if "HOST_KEY" in ctl.columns else ""
    if not pw or not ip:
        raise RuntimeError(f"SFTP row for '{sftp_id}@{host_ip}' has blank SFTP_PW / HOST_IP")
    return sftp_id, pw, ip, host_key




