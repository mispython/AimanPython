TEMP_PAGE_LEN     = 60
TEMP_TOP_MARGIN   = 4     # blank lines before header
TEMP_BOTTOM_BLANK = 2     # blank lines before "(Continued)"
TEMP_DATA_ROWS_PER_PAGE = (
    TEMP_PAGE_LEN - TEMP_TOP_MARGIN - 1  # header line
    - 1                                   # blank after header
    - TEMP_BOTTOM_BLANK - 1               # "(Continued)" line
)  # = 51


class _TempPager:
    """Vertical pager for ODTLLIST.TEXT: no ASA byte, plain blank-line
    page breaks. Each page = 60 lines: 4 blank top margin, header line,
    1 blank, up to 51 data rows, 2 blank, then '(Continued)' if more
    branches remain for this column chunk."""

    def __init__(self, header_line: str):
        self.header_line = header_line
        self.lines: list = []
        self.rows_on_page = 0

    def _new_page(self) -> None:
        self.lines.extend([""] * TEMP_TOP_MARGIN)
        self.lines.append(self.header_line)
        self.lines.append("")
        self.rows_on_page = 0

    def start(self) -> None:
        self._new_page()

    def add_row(self, row: str) -> None:
        if self.rows_on_page >= TEMP_DATA_ROWS_PER_PAGE:
            self.lines.extend([""] * TEMP_BOTTOM_BLANK)
            self.lines.append("(Continued)")
            self._new_page()
        self.lines.append(row)
        self.rows_on_page += 1




def _write_temp_output(loan4_padded: list, out_path: Path) -> None:
    riskrates = list(range(0, 15))
    branches = sorted({r["BRANCH"] for r in loan4_padded})

    def _crosstab(field: str) -> dict:
        agg = {}
        for r in loan4_padded:
            val = r[field]
            key = (r["BRANCH"], r["RISKRATE"])
            n, s = agg.get(key, (0, None))
            if val is not None:
                n += 1
                s = (s or 0.0) + val
            agg[key] = (n, s)
        return agg

    group_width = len(TEMP_SEP) + TEMP_N_WIDTH + len(TEMP_SEP) + TEMP_SUM_WIDTH
    max_groups = max(1, (LINESIZE_TEMP - TEMP_LABEL_WIDTH) // group_width)
    chunks = [riskrates[i:i + max_groups] for i in range(0, len(riskrates), max_groups)]

    all_lines = []
    for field in ("BALANCE", "RISKBAL"):
        cross = _crosstab(field)
        for group in chunks:
            header = " " * TEMP_LABEL_WIDTH
            for rr in group:
                cell = str(rr).rjust(TEMP_SUM_WIDTH)
                header += TEMP_SEP + " " * TEMP_N_WIDTH + TEMP_SEP + cell

            pager = _TempPager(header)
            pager.start()
            for b in branches:
                row = b.ljust(TEMP_LABEL_WIDTH)
                for rr in group:
                    n, s = cross.get((b, rr), (0, None))
                    row += TEMP_SEP + _n_format(n) + TEMP_SEP + _best_format(s)
                pager.add_row(row)
            all_lines.extend(pager.lines)

    with open(out_path, "w", encoding="latin1") as fh:
        for ln in all_lines:
            fh.write(ln + "\n")
