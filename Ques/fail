def _extract_fmtname_from_line(line: str) -> str | None:
    """Return the FMTNAME (column 1-7) if present and non‑blank, else None."""
    if len(line) > 7:
        fmt = line[0:7].strip()   # ASA char is at index 0, so actual content starts at 1
        # Wait: our _line() prepends an ASA character (space) at index 0.
        # So the FMTNAME is at column 1 (0‑based index 1) to column 7.
        # Let's re‑think: our line string starts with an ASA char (space or '1').
        # The content begins at position 1. So FMTNAME occupies positions 1‑7 (0‑based indices 1‑7).
        if len(line) > 8:
            fmt = line[1:8].strip()
            return fmt if fmt else None
    return None



def _render_report_rmel(df: pl.DataFrame) -> list[tuple[str | None, str]]:
    """Return list of (fmtname, line) for A-RMEL and B-RMEA groups."""
    rows = []
    subset = df.filter(pl.col("FMTNAME").is_in(["A-RMEL", "B-RMEA"])).sort(
        ["FMTNAME", "SIGN", "BNMCODE"]
    )
    if subset.is_empty():
        return rows

    for fmtname in subset["FMTNAME"].unique(maintain_order=True).sort().to_list():
        grp = subset.filter(pl.col("FMTNAME") == fmtname)
        amounx_sum = 0.0
        totalx_sum = 0.0
        first_row = True
        for row in grp.iter_rows(named=True):
            buf = _new_buf()
            current_fmt = None
            if first_row:
                current_fmt = row["FMTNAME"]
                _put(buf, 1, str(row["FMTNAME"] or ""))
                first_row = False
            # else leave column 1 blank (current_fmt remains None)
            _put(buf, 10, str(row["BNMCODE"] or ""))
            _put(buf, 26, str(row["DESC"] or "")[:40])
            _put(buf, 68, str(row["SIGN"] or ""))
            _put(buf, 74, _fmt_comma(row["AMOUNT"], 22, 2))
            _put(buf, 98, _fmt_comma(row["TOTAL"], 22, 2))
            rows.append((current_fmt, _line(buf, " ")))
            amounx_sum += row["AMOUNX"] or 0.0
            totalx_sum += row["TOTALX"] or 0.0

        # Dashed line after group
        buf = _new_buf()
        _put(buf, 3, "-" * 119)
        rows.append((None, _line(buf, " ")))

        # Total line
        buf = _new_buf()
        _put(buf, 12, f"TOTAL FOR {fmtname:<7s}")
        _put(buf, 74, _fmt_comma(amounx_sum, 24, 2))
        _put(buf, 98, _fmt_comma(totalx_sum, 24, 2))
        rows.append((None, _line(buf, " ")))

        # Dashed line under total
        buf = _new_buf()
        _put(buf, 74, "-" * 24)
        _put(buf, 98, "-" * 24)
        rows.append((None, _line(buf, " ")))

    return rows



def _render_report_rest(df: pl.DataFrame) -> list[tuple[str | None, str]]:
    """Return list of (fmtname, line) for all other FMTNAME groups."""
    rows = []
    subset = df.filter(~pl.col("FMTNAME").is_in(["A-RMEL", "B-RMEA"])).sort(
        ["FMTNAME", "SIGN", "BNMCODE"]
    )
    current_fmt = None
    first_row = True
    for row in subset.iter_rows(named=True):
        buf = _new_buf()
        fmt_to_print = None
        if row["FMTNAME"] != current_fmt:
            current_fmt = row["FMTNAME"]
            fmt_to_print = current_fmt
            _put(buf, 1, str(current_fmt or ""))
        # else leave blank
        _put(buf, 10, str(row["BNMCODE"] or ""))
        _put(buf, 26, str(row["DESC"] or "")[:40])
        _put(buf, 68, str(row["SIGN"] or ""))
        _put(buf, 74, _fmt_comma(row["AMOUNT"], 22, 2))
        _put(buf, 98, _fmt_comma(row["TOTAL"], 22, 2))
        rows.append((fmt_to_print, _line(buf, " ")))
    return rows



def _paginate_report(
    rows: list[tuple[str | None, str]],
    title_lines: list[str],
    header_lines: list[str],
    page_size: int = 60,
) -> list[str]:
    """
    Paginate the body rows (with optional fmtname) into pages of up to `page_size` lines.
    Each page includes titles, header, and the data rows.
    If a group continues across pages, the fmtname is reprinted on the next page.
    """
    # Count how many lines are used by titles and header
    header_count = len(title_lines) + len(header_lines)
    # We also need to account for the blank line after header? In our current, there is no blank line, but there is a dashed line in header.
    # Actually, header_lines includes the dashed line.
    # So usable lines per page = page_size - header_count

    out_lines = []
    current_page_lines = []
    current_fmt = None   # the fmtname of the last data row that had a non‑None fmtname

    def flush_page():
        nonlocal current_page_lines, current_fmt
        if not current_page_lines:
            return
        # Start new page with titles and header
        out_lines.extend(title_lines)
        out_lines.extend(header_lines)
        # Now add the body lines for this page
        # Before adding, if the first row has a None fmtname, we need to reprint the current_fmt
        if current_page_lines and current_page_lines[0][0] is None:
            # Insert a group header line with the current_fmt
            fmt = current_fmt if current_fmt is not None else ""
            buf = _new_buf()
            _put(buf, 1, fmt)
            out_lines.append(_line(buf, " "))
        # Add all rows (we only need the line string)
        for _, line in current_page_lines:
            out_lines.append(line)
        current_page_lines = []

    for fmt, line in rows:
        # Check if we need to start a new page
        # We count how many lines we already have in current_page_lines
        # Including the header lines which will be added on flush
        # We need to check if adding this line would exceed page_size (including titles and header)
        if len(current_page_lines) + header_count >= page_size:
            # Flush current page before adding this line
            flush_page()
            # Now current_page_lines is empty, and we can add this line
            # But we need to remember the current fmt for the new page
            # If fmt is not None, update current_fmt; else keep previous
            if fmt is not None:
                current_fmt = fmt
            current_page_lines.append((fmt, line))
        else:
            # Just add to current page
            if fmt is not None:
                current_fmt = fmt
            current_page_lines.append((fmt, line))

    # Flush any remaining lines
    if current_page_lines:
        flush_page()

    return out_lines



