def summarize(df: pl.DataFrame, class_cols: list[str], var_cols: list[str]) -> pl.DataFrame:
    """PROC SUMMARY NWAY MISSING equivalent -- missing (not 0) when all values are missing."""
    return df.group_by(class_cols, maintain_order=True).agg([_ssum(c) for c in var_cols])




