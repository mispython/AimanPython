import duckdb
from datetime import date
from PBBDPFMT import fdprod_format

con = duckdb.connect(":memory:")
df = con.execute("""
    SELECT
        CAST(ACCOUNT_TYPE_CD AS INTEGER) AS ACCTTYPE,
        CAST(CUSTOMER_CD     AS INTEGER) AS CUSTCD,
        CAST(CURR_BAL        AS DOUBLE)  AS CURBAL,
        CAST(MATURE_DT       AS DATE)    AS MATDT,
        CAST(OPEN_IND        AS VARCHAR) AS OPENIND,
        CAST(INT_PLAN        AS INTEGER) AS INTPLAN
    FROM read_parquet('/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/input/cache/EIBDLIQP/fd_pbb.parquet')
""").pl()
con.close()

reptdate = date(2026, 9, 16)
rpyr, rpmth, rpday = 2026, 9, 16
rd_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

def remfmt(v):
    if v <= 0.1: return '01'
    if v <= 1:   return '02'
    if v <= 3:   return '03'
    if v <= 6:   return '04'
    if v <= 12:  return '05'
    return '06'

def remmth(matdt):
    mdyr, mdmth, mdday = matdt.year, matdt.month, matdt.day
    days = rd_days[rpmth - 1]
    if mdday > days: mdday = days
    remy = mdyr - rpyr
    remm = mdmth - rpmth
    remd = mdday - rpday
    return remy*12 + remm + remd/days

from collections import defaultdict
buckets = defaultdict(float)
counts  = defaultdict(int)

for r in df.iter_rows(named=True):
    if r["ACCTTYPE"] in (397, 398): continue
    if r["CURBAL"] is None or r["CURBAL"] <= 0: continue
    bic = fdprod_format(r["INTPLAN"])
    if bic != '95311': continue
    cust = '08' if r["CUSTCD"] in (77, 78, 95, 96) else '09'
    matdt = r["MATDT"]
    if r["OPENIND"] == 'D' or (matdt is not None and (matdt - reptdate).days < 8):
        rem = 0.1
    else:
        rem = remmth(matdt)
    b = remfmt(rem)
    key = f"95311{cust}{b}0000Y"
    buckets[key] += r["CURBAL"]
    counts[key]  += 1

for k in sorted(buckets):
    print(f"{k};{int(buckets[k]/1000):>12}   n={counts[k]:>8}")
