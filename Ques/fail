import re
from itertools import zip_longest
from pathlib import Path

EXPECTED = Path(r"<path to the expected SAS output file>")
ACTUAL = Path(r"/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/output/EIBMRBDP/EIBMRB09.txt")


def junk_codes(path: Path, limit: int = 40) -> list:
    data = path.read_bytes()
    start = data.index(b"\n", data.index(b";NO.;RM")) + 1     # after group (A) header
    end = data.index(b"   W01 ;")                             # first valid reason code
    region = b"\n" + data[start:end]
    return [m.group(1) for m in re.finditer(rb"\n   (.*?) ;0 ;0 ;0", region, re.DOTALL)][:limit]


for i, (exp, act) in enumerate(zip_longest(junk_codes(EXPECTED), junk_codes(ACTUAL)), 1):
    print(f"{i:02d} EXP={exp.hex(' ') if exp is not None else '-':<20} "
          f"ACT={act.hex(' ') if act is not None else '-'}")
