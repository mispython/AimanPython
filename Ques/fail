def sas_to_parquet(sas_path: Path, parquet_path: Path, tag: str) -> None:
    """Convert a large .sas7bdat to Parquet in streaming chunks."""
    print(f"  [{tag}] Converting {sas_path.name} -> temporary parquet ...")
    writer = None
    schema = None
    total = 0

    try:
        for chunk in pd.read_sas(sas_path, encoding="latin1", chunksize=CHUNK_ROWS):
            if ROW_LIMIT and total >= ROW_LIMIT:
                break
            if ROW_LIMIT:
                chunk = chunk.iloc[: ROW_LIMIT - total]

            table = pa.Table.from_pandas(chunk, preserve_index=False)

            if schema is None:
                # Never lock a 'null' type from a chunk that was blank for a text column
                fields = [
                    pa.field(f.name, pa.string()) if pa.types.is_null(f.type) else f
                    for f in table.schema
                ]
                schema = pa.schema(fields)
                table = table.cast(schema, safe=False)
                writer = pq.ParquetWriter(parquet_path, schema, compression="snappy")
            else:
                arrays = []
                for field in schema:
                    col = table.column(field.name)
                    if col.type != field.type:
                        try:
                            col = col.cast(field.type, safe=False)
                        except Exception as exc:
                            raise RuntimeError(
                                f"[{tag}] Cannot cast '{field.name}' from {col.type} "
                                f"to {field.type}: {exc}"
                            ) from exc
                    arrays.append(col)
                table = pa.Table.from_arrays(arrays, schema=schema)

            writer.write_table(table)
            total += len(chunk)
            del chunk, table
            gc.collect()
    finally:
        if writer is not None:
            writer.close()

    print(f"  [{tag}] Done - {total:,} rows.")


@contextmanager
def temp_parquet(sas_path: Path, tag: str):
    """Yield the path of a temporary Parquet copy of *sas_path*; removed on exit."""
    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp:
        parquet_path = Path(tmp) / f"{tag.lower()}.parquet"
        sas_to_parquet(sas_path, parquet_path, tag)
        yield parquet_path




