import re
from datetime import date
from calendar import monthrange
import polars as pl

from REPTDATE import get_reptdate_values

# ============================================================================
# STEP 1: REPORT CONTEXT
# ============================================================================
def derive_report_context() -> dict:
    # reptdate = get_reptdate_values(year_format="%Y").reptdate
    reptdate = date(2026, 9, 30)             # DEBUG override

    return {
        "reptdate":  reptdate,
        "reptyear":  reptdate.strftime("%Y"),
        "reptmon":   reptdate.strftime("%m"),
        "reptyear2": reptdate.strftime("%y"),
        "rdate":     reptdate.strftime("%d/%m/%y"),
        "reptmth":   reptdate.strftime("%b").upper(),   # e.g. SEP
    }

CTX = derive_report_context()
REPTYEAR_I = int(CTX["reptyear"])
REPTMON_I  = int(CTX["reptmon"])
print(f"Report month: {CTX['reptmth']} {CTX['reptyear']}  (RDATE {CTX['rdate']})")

# ============================================================================
# STEP 2: BUILD THE EXPECTED FILE LIST FOR THE MONTH
# ============================================================================
# 1. Number of daily files depends on the month (28/29/30/31 days)
days_in_month = monthrange(REPTYEAR_I, REPTMON_I)[1]

def _daily_file_for(d: date) -> Path:
    """fcyfd{yymmdd}.sas7bdat  e.g. fcyfd260915.sas7bdat"""
    return INPUT_MISFD_DIR / f"fcyfd{d.strftime('%y%m%d')}.sas7bdat"

expected_days = [date(REPTYEAR_I, REPTMON_I, dd) for dd in range(1, days_in_month + 1)]
daily_files   = [_daily_file_for(d) for d in expected_days]

# 2. Fail loudly if any expected file is missing — do NOT silently skip
missing = [f.name for f in daily_files if not f.exists()]
if missing:
    raise FileNotFoundError(
        f"Missing {len(missing)} daily file(s) for {CTX['reptmth']} {CTX['reptyear']}:\n  "
        + "\n  ".join(missing)
    )

# 3. Filename -> report date (guaranteed clean yymmdd per your confirmation)
_NAME_RE = re.compile(r"^fcyfd(\d{2})(\d{2})(\d{2})$", re.IGNORECASE)

def _reptdate_from_name(path: Path) -> date:
    m = _NAME_RE.match(path.stem)
    if not m:                                                    # shouldn't happen, but stay safe
        raise ValueError(f"Filename does not match fcyfd<yymmdd>: {path.name}")
    yy, mm, dd = (int(x) for x in m.groups())
    # yymmdd pivot: assume 2000-2099 (matches your YEARCUTOFF=1950 conventions)
    return date(2000 + yy, mm, dd)

# Sanity: every parsed date must be within the report month
parsed = [_reptdate_from_name(f) for f in daily_files]
assert parsed[0].month  == REPTMON_I and parsed[0].year  == REPTYEAR_I
assert parsed[-1].month == REPTMON_I and parsed[-1].year == REPTYEAR_I
assert parsed == expected_days, "File list does not cover every day of the month"

print(f"  Found {len(daily_files)} daily files for {days_in_month}-day month.")

# ============================================================================
# STEP 3: AGGREGATE ONE DAY
# ============================================================================
def _aggregate_one_day(reptdate: date, sas_path: Path) -> pl.DataFrame:
    """Read one daily SAS file, apply SAS WHERE + IF, return per-CURCODE summary."""
    pq_path = _load_cached(sas_path, f"daily_{sas_path.stem}")

    df = _read_pq(
        pq_path,
        "TRIM(CURCODE) AS CURCODE, CAST(CURBAL AS DOUBLE) AS CURBAL, OPENDT, CLOSEDAT",
        "COALESCE(TRIM(CURCODE), '') <> 'MYR' AND CURBAL > 0",
    )
    # Convert SAS date numerics -> Date
    df = df.with_columns(
        _sas_date(df, "OPENDT").alias("OPENDT"),
        _sas_date(df, "CLOSEDAT").alias("CLOSEDAT"),
    )

    # Same-year AND same-month closeout on accounts opened this report month
    same_month_closed = (
        _in_report_month("OPENDT")
        & (pl.col("CLOSEDAT").dt.year()  == pl.col("OPENDT").dt.year())
        & (pl.col("CLOSEDAT").dt.month() == pl.col("OPENDT").dt.month())
    ).fill_null(False)
    df = df.filter(~same_month_closed)

    # CURBAL /= 1000  (RM 000) and aggregate
    return (
        df.with_columns((pl.col("CURBAL") / 1000).alias("CURBAL"))
          .group_by("CURCODE")
          .agg(pl.col("CURBAL").sum(), pl.len().alias("N"))
          .with_columns(pl.lit(reptdate).cast(pl.Date).alias("REPTDATE"))
          .select("REPTDATE", "CURCODE", "CURBAL", "N")
    )

# ============================================================================
# STEP 4: LOOP AND CONCAT
# ============================================================================
print("\nAggregating daily files...")
summaries = []
for d, f in zip(expected_days, daily_files):
    s = _aggregate_one_day(d, f)
    summaries.append(s)
    print(f"  {d.isoformat()}  {len(s):3d} currencies  {int(s['N'].sum()):,} accounts")

summary = pl.concat(summaries)
print(f"\nCombined: {len(summary):,} rows across {summary['REPTDATE'].n_unique()} dates "
      f"and {summary['CURCODE'].n_unique()} currencies.")

# ============================================================================
# STEP 5: RENDER
# ============================================================================
report_lines = _render_report(summary) if not summary.is_empty() else []

with open(OUTPUT_FILE, "w", encoding="latin1") as fh:
    for ln in report_lines:
        fh.write(ln + "\n")

print(f"\nOutput : {OUTPUT_FILE}")
print(f"Lines  : {len(report_lines):,}")
