CISDP_SA_CACHE     = CACHE_DIR / "cisdp_sa.parquet"        # raw cache: cisr1sa
CISDP_FD_CACHE     = CACHE_DIR / "cisdp_fd.parquet"        # raw cache: cisr1fd
CISDP_CACHE        = CACHE_DIR / "cisdp_deposit.parquet"   # combined SA + FD (passed to DALWPBBD)




def _build_cisdp_combined(sa_cache: Path, fd_cache: Path, out_cache: Path, tag: str) -> Path:
    """Combine the CIS savings (cisr1sa) and FD (cisr1fd) extracts into the
    single CISDP (ACCTNO, CUSTNO) dataset that DALWPBBD expects.

    One row per ACCTNO is kept (SA takes priority over FD) so the later
    DALWPBBD left join (BY ACCTNO; IF A) can never duplicate FCY rows.
    The cache folder is temporary, so the combined file is rebuilt every run.
    """
    print(f"  [{tag}] Combining {sa_cache.name} + {fd_cache.name} -> {out_cache.name} ...")
    con = duckdb.connect(database=":memory:")
    try:
        con.execute(f"""
            COPY (
                SELECT ACCTNO, CUSTNO
                FROM (
                    SELECT CAST(ACCTNO AS BIGINT)  AS ACCTNO,
                           CAST(CUSTNO AS VARCHAR) AS CUSTNO,
                           1 AS SRC
                    FROM read_parquet('{sa_cache.as_posix()}')
                    UNION ALL
                    SELECT CAST(ACCTNO AS BIGINT)  AS ACCTNO,
                           CAST(CUSTNO AS VARCHAR) AS CUSTNO,
                           2 AS SRC
                    FROM read_parquet('{fd_cache.as_posix()}')
                )
                QUALIFY ROW_NUMBER() OVER (PARTITION BY ACCTNO ORDER BY SRC) = 1
            ) TO '{out_cache.as_posix()}' (FORMAT PARQUET)
        """)
        total = con.execute(
            f"SELECT COUNT(*) FROM read_parquet('{out_cache.as_posix()}')"
        ).fetchone()[0]
    finally:
        con.close()
    print(f"  [{tag}] Done - {total:,} combined rows.")
    return out_cache




