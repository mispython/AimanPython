print("\nStep 11: Writing split customer extract + SFTP file list...")


def _rtrim(s) -> str:
    return (s or "").rstrip(" ")


def _format_output_line(row: dict, n_cards: int) -> str:
    fields = [
        _rtrim(row["NEWIC"]),
        _rtrim(row["PRIPHONE"]),
        _rtrim(row["SECPHONE"]),
        _rtrim(row["MOBIPHON"]),
        _rtrim(row["ACCTNO"]),
        _rtrim(row["BUSSREG"]),
    ]
    for idx in range(1, n_cards + 1):
        fields.append(_rtrim(row.get(f"CARD{idx}")))
    return "|".join(fields)


NOBS = len(ciscard_df)
NUMFILE = ceil(NOBS / OBSNUM) if NOBS else 0
print(f"  NOBS: {NOBS:,}   OBSNUM: {OBSNUM:,}   NUMFILE: {NUMFILE}")

sftp_lines = []
current_fh = None
current_no = 0
rows_written = 0

for idx, row in enumerate(ciscard_df.iter_rows(named=True)):
    processed = process_row(row, N_CARDS)

    file_no = idx // OBSNUM + 1
    if file_no != current_no:
        if current_fh:
            current_fh.close()
            print(f"  Written EIBWDLPS_C{current_no:03d}.txt ({rows_written:,} rows)")
        current_no = file_no
        rows_written = 0
        out_path = OUTPUT_DIR / f"EIBWDLPS_C{file_no:03d}.txt"
        current_fh = open(out_path, "w", encoding="latin1")

    current_fh.write(_format_output_line(processed, N_CARDS) + "\n")
    rows_written += 1

if current_fh:
    current_fh.close()
    print(f"  Written EIBWDLPS_C{current_no:03d}.txt ({rows_written:,} rows)")

for i in range(1, NUMFILE + 1):
    no = f"{i:03d}"
    files_str = f"//SAP.PBB.DLP.C{no}.TEXT  DLP{no}.CSV"
    sftp_lines.append(f"PUT {files_str}")

with open(SFTP_OUTPUT_FILE, "w", encoding="latin1") as fh:
    for ln in sftp_lines:
        fh.write(ln + "\n")
print(f"  Written {SFTP_OUTPUT_FILE.name} ({len(sftp_lines)} lines)")

print("\nEIBWDLPS complete.")




