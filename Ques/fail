    return (
        _read_sas7bdat(lncomm_path, row_limit=row_limit)
        .select(["ACCTNO", "COMMNO", "CCOLLTRL"])
        .with_columns([
            pl.col("ACCTNO").cast(pl.Float64).cast(pl.Int64),
