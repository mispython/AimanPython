def _build_section_header(section: dict) -> list[str]:
    """Build the multi-line header for a section, with labels centered."""
    cols = section["columns"]
    headers = section["headers"]   # list of lists (depth x columns)
    depth = len(headers)
    lines = []
    for d in range(depth):
        parts = []
        for i, var in enumerate(cols):
            label = headers[d][i] if d < len(headers) and i < len(headers[d]) else ""
            width = COL_WIDTHS[var]
            parts.append(label.center(width))
        lines.append((" " * 1).join(parts))  # single space gap
    # rule line
    total_width = sum(COL_WIDTHS[var] for var in cols) + (len(cols) - 1) * 1
    lines.append("-" * total_width)
    return lines

def _format_section_value(col: dict, value) -> str:
    """Format a single value for a given column definition."""
    if col["type"] == "date":
        return value.strftime("%d/%m/%Y").rjust(col["width"]) if value else "0".rjust(col["width"])
    if col["type"] == "comma":
        return _fmt_comma(value, col["width"], 0)
    if col["type"] == "num2":
        return _fmt_num(value, col["width"], 2)
    return str(value or "").rjust(col["width"])

def _build_section_detail(row: dict, cols: list) -> str:
    """Build a detail line for a given list of column definitions."""
    parts = []
    for var in cols:
        col_def = next(c for c in REPORT_COLUMNS if c["var"] == var)
        parts.append(_format_section_value(col_def, row.get(var)))
    return (" " * 1).join(parts)

