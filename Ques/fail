def _sas_to_parquet(sas_path: Path, cache_path: Path, tag: str) -> None:
    print(f"  [{tag}] Converting {sas_path.name} -> {cache_path.name} ...")
    
    # 1. Get column names and dtypes from the SAS file (even if empty)
    empty_df = pd.read_sas(sas_path, encoding="latin1", nrows=0)
    if len(empty_df.columns) == 0:
        # No columns? Write an empty file with no schema? But SAS files always have columns.
        # As a fallback, we create an empty Parquet file without schema (but that's unusual).
        # We'll just create an empty DataFrame with no columns and write it.
        empty_table = pa.Table.from_pandas(pd.DataFrame())
        pq.write_table(empty_table, cache_path)
        print(f"  [{tag}] Done - 0 rows cached (empty file with no columns).")
        return

    # Build PyArrow schema from the empty DataFrame
    fields = []
    for col, dtype in empty_df.dtypes.items():
        if dtype == 'object':
            pa_type = pa.string()
        elif pd.api.types.is_integer_dtype(dtype):
            pa_type = pa.int64()
        elif pd.api.types.is_float_dtype(dtype):
            pa_type = pa.float64()
        else:
            pa_type = pa.from_numpy_dtype(dtype)
        fields.append(pa.field(col, pa_type))
    schema = pa.schema(fields)

    # Write the empty table (ensures the file exists)
    empty_table = pa.Table.from_pandas(empty_df, schema=schema, preserve_index=False)
    pq.write_table(empty_table, cache_path)

    # 2. Now read the actual data in chunks and append (or overwrite)
    writer = None
    total = 0
    reader = pd.read_sas(sas_path, encoding="latin1", chunksize=CHUNK_ROWS)
    for chunk in reader:
        if writer is None:
            # Create new writer (overwrites the empty file we just wrote)
            writer = pq.ParquetWriter(cache_path, schema, compression="snappy")
        table = pa.Table.from_pandas(chunk, schema=schema, preserve_index=False)
        writer.write_table(table)
        total += len(chunk)
        del chunk, table
        gc.collect()

    if writer is not None:
        writer.close()
    # If writer is None, we already wrote the empty file, so nothing more to do.

    print(f"  [{tag}] Done - {total:,} rows cached.")
