def read_sabal(reptdate_value: date) -> pl.DataFrame:
    """
    Convert DYPOSXBR to a temporary Parquet file, read it via DuckDB
    (WHERE REPTDATE = &RDATE, ORDER BY BRANCH), then delete the temp file.
    """
    sas_date_num = _to_sas_date_value(reptdate_value)
    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp:
        tmp_parquet = Path(tmp) / f"{DYPOSXBR_SAS.stem}.parquet"
        sas_to_parquet(DYPOSXBR_SAS, tmp_parquet, "DYPOSXBR")

        con = duckdb.connect(database=":memory:")
        try:
            query = f"""
                SELECT
                    CAST(BRANCH AS BIGINT) AS BRANCH,
                    TOTSAVG, TOTSAVGI, SACNT, ISACNT
                FROM read_parquet('{tmp_parquet.as_posix()}')
                WHERE CAST(REPTDATE AS DOUBLE) = {sas_date_num}
                ORDER BY BRANCH
            """
            return con.execute(query).pl()
        finally:
            con.close()
    # temp folder and Parquet file are removed here




# ============================================================
# SFTP TO DATA REPORT REPOSITORY (DRR)
# //RUNSFTP EXEC COZBATCH ... cd "<remote dir>" ; PUT <file> <remote name>
# ============================================================
def read_sftp_credentials(host_desc: str) -> dict:
    """Look up SFTP_ID / SFTP_PW / HOST_IP for HOST_DESC in the control file."""
    info = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    for col in ("SFTP_ID", "SFTP_PW", "HOST_IP", "HOST_DESC"):
        info[col] = info[col].fillna("").astype(str).str.strip()
    hit = info.loc[info["HOST_DESC"] == host_desc]
    if hit.empty:
        raise ValueError(f"HOST_DESC '{host_desc}' not found in {CTL_SFTP_INFO}")
    row = hit.iloc[0]
    return {"user": row["SFTP_ID"], "password": row["SFTP_PW"], "host": row["HOST_IP"]}


def sftp_put(local_path: Path, remote_dir: str, remote_name: str) -> None:
    """Upload local_path to remote_dir/remote_name on the DRR server."""
    cred = read_sftp_credentials(SFTP_HOST_DESC)
    transport = paramiko.Transport((cred["host"], SFTP_PORT))
    try:
        transport.connect(username=cred["user"], password=cred["password"])
        sftp = paramiko.SFTPClient.from_transport(transport)
        try:
            sftp.chdir(remote_dir)
            sftp.put(str(local_path), remote_name)
        finally:
            sftp.close()
    finally:
        transport.close()
    print(f"[EIMISR01] SFTP OK -> {SFTP_HOST_DESC} : {remote_dir}/{remote_name}")




