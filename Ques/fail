def _create_isbase() -> None:
    """
    EIBMSISD step, run at the start of every EIIWSTAF run:
        DATA SGM.STBASE SGM.SVBASE SGM.ISBASE;
            ACCTNO=9999999999;
            NOTENO=99999;
    ISBASE is always recreated (replaced) with the single seed observation,
    no availability check. The append later in the program adds to this
    freshly created dataset.
    """
    INPUT_ISBASE_DIR.mkdir(parents=True, exist_ok=True)
    seed = pl.DataFrame({"ACCTNO": [9999999999.0], "NOTENO": [99999.0]})
    _write_isbase(seed)
    print(f"  [ISBASE] Recreated {INPUT_ISBASE_FILE} (EIBMSISD step)")




