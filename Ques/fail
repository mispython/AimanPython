def _sas_sum_minus(a: str, b: str) -> pl.Expr:
    """ROUND(SUM(a, -1*b), 0.01): missing only when both are missing."""
    return (
        pl.when(pl.col(a).is_null() & pl.col(b).is_null()).then(None)
          .otherwise((pl.col(a).fill_null(0.0) - pl.col(b).fill_null(0.0)) * 100)
    ).round(0) / 100


