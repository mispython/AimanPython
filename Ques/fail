def _load_cached(sas_path: Path, tag: str) -> Path:
    """Convert a .sas7bdat to a TEMPORARY Parquet file once per run and return
    its path. A repeated request for the same input reuses the existing
    temporary file instead of converting again."""
    key = sas_path.resolve()
    if key in _PARQUET_REGISTRY:
        print(f"  [{tag}] Already converted - reusing temporary Parquet.")
        return _PARQUET_REGISTRY[key]
    if not sas_path.exists():
        raise FileNotFoundError(f"[{tag}] Input not found: {sas_path}")
    parquet_path = TMP_DIR / f"{sas_path.stem}.parquet"
    _sas_to_parquet(sas_path, parquet_path, tag)
    _PARQUET_REGISTRY[key] = parquet_path
    return parquet_path




