REPTYR      = RDATE.strftime("%y")              # YEAR2.  e.g. "26"
REPTMON     = RDATE.strftime("%m")              # Z2.     zero-padded month
REPTDAY     = RDATE.strftime("%d")              # Z2.     zero-padded day
