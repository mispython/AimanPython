def _render_pivot_report(
    df: pl.DataFrame,
    title_lines: list[str],
    row_col: str,
    all_label: str,
    class_col: str,
    value_specs: list[tuple],   # list of (column_name, label, width, decimals)
    rts: int,
    class_vals: list,
    page_num: int = 1,
) -> list[str]:
    """
    Render a PROC TABULATE grid with fixed width, borders, and spanning headers.
    value_specs: each tuple (col_name, label, width, decimals)
    class_vals: list of values to use as columns (subset of class_col)
    page_num: used only to add extra blank line before the first page.
    """
    if df.is_empty() or not class_vals:
        return []

    lines = list(title_lines)
    if page_num == 1:
        lines.append("")                # blank line before first table

    # ---- Determine column widths ----
    num_classes = len(class_vals)
    num_sub = len(value_specs)
    total_value_cols = num_classes * num_sub

    # Each sub-column width is given in value_specs
    sub_widths = [w for (_, _, w, _) in value_specs]
    # Total value area width = sum of sub-column widths + (total_value_cols - 1) for pipes
    value_area_width = sum(sub_widths) + (total_value_cols - 1)

    # Row label column width: we want total line width = 132
    # Total line = "|" + row_label_width + "|" + value_area_width + "|"
    # => row_label_width = 132 - 2 - value_area_width
    row_label_width = 132 - 2 - value_area_width
    # But we also respect rts as a hint; if row_label_width > rts, we may reduce?
    # For safety, we set row_label_width = min(row_label_width, rts) but we need exact 132.
    # We'll use the computed width to ensure 132.
    # However, for variance with 3 sub-columns and 6 days: sub_widths = [16,16,16] => total = 16*18+17 = 305, too big.
    # That would require row_label_width negative. So we need to reduce sub-column widths.
    # In the original variance output, the sub-columns are narrower (maybe 10 or 11).
    # We'll compute a scale factor to fit within 132.
    # For now, we just use the widths as given and if total > 132, we'll reduce row_label_width to a minimum.
    # Actually the original had separate widths for variance (e.g., 15 for KAPITI, 15 for WALKER, 15 for VARIANCE?)
    # We'll trust the caller to supply appropriate widths.
    # But we can enforce a minimum row_label_width (e.g., 20) and if value_area_width > 132-2-20, we reduce sub_widths proportionally.
    if row_label_width < 10:
        # Too many columns; reduce sub-column widths proportionally
        # Compute scaling factor to make row_label_width = 10
        target_value_area = 132 - 2 - 10  # 120
        scale = target_value_area / (sum(sub_widths) + (total_value_cols - 1))
        # Adjust sub_widths
        new_sub_widths = [max(5, int(w * scale)) for w in sub_widths]  # keep at least 5
        # Recompute value_area_width
        value_area_width = sum(new_sub_widths) + (total_value_cols - 1)
        row_label_width = 132 - 2 - value_area_width
        # Update sub_widths for formatting
        sub_widths = new_sub_widths
    else:
        row_label_width = min(row_label_width, rts)  # cap at rts

    # ---- Helper to build a cell string of exact width ----
    def pad_left(s, width):
        return s.rjust(width)

    def pad_center(s, width):
        return s.center(width)

    def pad_right(s, width):
        return s.ljust(width)

    # ---- Build border lines ----
    def border_line() -> str:
        # Build a string of '-' with '+' at pipe positions
        # Positions: after row_label_width, and after each sub-column group
        parts = []
        # First part: row label area
        parts.append('-' * row_label_width)
        # Then value area: for each sub-column, dashes of its width
        for i, sw in enumerate(sub_widths):
            parts.append('-' * sw)
        # Join with '+'
        return '|' + '+'.join(parts) + '|'

    # ---- Build spanning header row (ELDAY) ----
    def span_header_row() -> str:
        # Row label cell: spaces
        label_cell = ' ' * row_label_width
        # Value area: center "ELDAY" over all sub-columns (including pipes)
        # The value area width includes the pipes between sub-columns
        total_value_width = value_area_width
        header_text = 'ELDAY'
        left_pad = (total_value_width - len(header_text)) // 2
        right_pad = total_value_width - len(header_text) - left_pad
        value_cell = ' ' * left_pad + header_text + ' ' * right_pad
        return '|' + label_cell + '|' + value_cell + '|'

    # ---- Build class header row (e.g., DAYA spanning its sub-columns) ----
    def class_header_row() -> str:
        label_cell = ' ' * row_label_width
        cells = []
        for cv in class_vals:
            # For each class, we need to span its sub-columns
            # The width of this group = sum of sub_widths for this class + (num_sub-1) pipes
            group_width = sum(sub_widths) + (num_sub - 1)
            cv_str = str(cv)
            # Center the class label within the group
            left = (group_width - len(cv_str)) // 2
            right = group_width - len(cv_str) - left
            cells.append(' ' * left + cv_str + ' ' * right)
        # Join cells with '|' (no outer pipes yet)
        value_part = '|'.join(cells)
        return '|' + label_cell + '|' + value_part + '|'

    # ---- Build sub-header row (e.g., KAPITI, WALKER, VARIANCE) ----
    def sub_header_row() -> str:
        label_cell = ' ' * row_label_width
        cells = []
        for _ in class_vals:
            for (_, label, width, _) in value_specs:
                # Center the label within its sub-column width
                cells.append(pad_center(label, width))
        value_part = '|'.join(cells)
        return '|' + label_cell + '|' + value_part + '|'

    # ---- Build data row for a given row value ----
    def data_row(row_val: str) -> str:
        label_cell = pad_right(str(row_val), row_label_width)[:row_label_width]
        cells = []
        for cv in class_vals:
            sub_df = df.filter((pl.col(row_col) == row_val) & (pl.col(class_col) == cv))
            for (col, label, width, dec) in value_specs:
                val = float(sub_df[col].sum()) if len(sub_df) > 0 else 0.0
                fmt = _fmt_comma(val, width, dec)
                cells.append(fmt)
        value_part = '|'.join(cells)
        return '|' + label_cell + '|' + value_part + '|'

    # ---- Build total row ----
    def total_row() -> str:
        label_cell = pad_right(all_label, row_label_width)[:row_label_width]
        cells = []
        for cv in class_vals:
            sub_df = df.filter(pl.col(class_col) == cv)
            for (col, label, width, dec) in value_specs:
                val = float(sub_df[col].sum()) if len(sub_df) > 0 else 0.0
                fmt = _fmt_comma(val, width, dec)
                cells.append(fmt)
        value_part = '|'.join(cells)
        return '|' + label_cell + '|' + value_part + '|'

    # ---- Assemble the grid ----
    lines.append(border_line())
    lines.append(span_header_row())
    lines.append(border_line())   # separator after spanning header
    lines.append(class_header_row())
    lines.append(sub_header_row())
    lines.append(border_line())   # separator before data

    row_vals = sorted(df[row_col].drop_nulls().unique().to_list())
    for rv in row_vals:
        lines.append(data_row(rv))

    lines.append(border_line())   # separator before total
    lines.append(total_row())
    lines.append(border_line())   # bottom border

    return lines




