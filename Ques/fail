def write_xlsx(template_rows: list[TemplateRow], totlcr: pl.DataFrame, output_path: Path) -> None:
    """Write the NSFR report to .xlsx: title row, then one row per template item
    (description + 3 maturity buckets as ABS numeric values, COMMA20.2 style)."""
    totlcr_map = {
        row["item"]: (row["utnma1"], row["utnma2"], row["utnma3"])
        for row in totlcr.iter_rows(named=True)
    }

    wb = Workbook()
    ws = wb.active
    ws.title = "NSFR"

    ws.append(["PUBLIC INVESTMENT BANK BERHAD"])
    ws["A1"].font = Font(bold=True)

    for trow in template_rows:
        values = totlcr_map.get(trow.item, (None, None, None))
        ws.append([trow.desc.rstrip()] + [abs(v) if v is not None else None for v in values])

    for row in ws.iter_rows(min_row=2, min_col=2, max_col=4):
        for cell in row:
            cell.number_format = "#,##0.00"
    ws.column_dimensions["A"].width = 80
    for col in ("B", "C", "D"):
        ws.column_dimensions[col].width = 22

    wb.save(output_path)




