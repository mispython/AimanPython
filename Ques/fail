    if PAGE_SIZE - lines_on_page < BREAK_LINES:
        lines_on_page = _new_page()
    output_lines.append(_blank_cols("-" * 15))
    output_lines.append(_blank_cols(_fmt_comma15_2(cust_total)))
    output_lines.append("")
    lines_on_page += BREAK_LINES

