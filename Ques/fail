import pyreadstat
from pathlib import Path

D = Path("/stgsrcsys/host/uat/AII/EIBDUNDP")
probe = 1595256021

for f in sorted(D.glob("*.sas7bdat")):
    n = f.name.lower()
    if not (n.startswith("fd") or n.startswith("ifd")):
        continue
    try:
        df, _ = pyreadstat.read_sas7bdat(str(f))
        if "ACCTNO" not in df.columns:
            continue
        hit = df[df["ACCTNO"].astype("float").astype("int64") == probe]
        if len(hit):
            print(f"{f.name} : FOUND  CURBAL={hit.iloc[0]['CURBAL']}  total_rows={len(df)}")
        else:
            print(f"{f.name} : -")
    except Exception as e:
        print(f"{f.name} : ERROR {e}")
