def _read_rows(parquet_path: Path, select_sql: str) -> list:
    """Read a Parquet cache through DuckDB with explicit CASTs and return
    a plain list of dict rows. ..."""
    con = duckdb.connect(database=":memory:")

    src_cols = {
        row[0]
        for row in con.execute(
            f"DESCRIBE SELECT * FROM read_parquet('{parquet_path.as_posix()}') AS src"
        ).fetchall()
    }

    def _fix(m):
        col, typ, alias = m.group(1), m.group(2), m.group(3)
        if col in src_cols:
            return m.group(0)
        return f"CAST(NULL AS {typ}) AS {alias}"

    fixed_sql = re.sub(
        r"CAST\(src\.(\w+) AS ([A-Z0-9]+(?:\([0-9,]+\))?)\)(?:\s+AS\s+(\w+))?",
        _fix,
        select_sql,
    )

    df = con.execute(
        f"SELECT {fixed_sql} FROM read_parquet('{parquet_path.as_posix()}') AS src"
    ).pl()
    con.close()

    # SAS fixed-width CHAR columns are space-padded on disk; SAS character
    # comparisons treat trailing blanks as insignificant, so strip them here
    # to preserve that semantic before any downstream equality/IN checks
    # (PRODCD == '54120', ACCTYPE == 'LN', CUSTCD IN (...), etc.).
    str_cols = [c for c, dt in zip(df.columns, df.dtypes) if dt == pl.Utf8]
    if str_cols:
        df = df.with_columns([pl.col(c).str.strip_chars() for c in str_cols])

    return df.to_dicts()
