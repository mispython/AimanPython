import duckdb
con = duckdb.connect(":memory:")
rows = con.execute("""
    SELECT
        TRIM(UPPER(CAST(CURRENCY_CD AS VARCHAR))) AS CUR,
        COUNT(*)                                  AS N,
        SUM(CAST(CURR_BAL AS DOUBLE))             AS RAW_SUM
    FROM read_parquet('/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/input/cache/EIBDLIQP/fd_pbb.parquet')
    WHERE CAST(INT_PLAN AS INTEGER) IN (
        421, 423, 425, 427, 429, 430, 432, 433, 435, 436, 446,
        470, 472, 474, 476, 478, 480, 482, 484, 486, 488, 490, 492, 494, 496, 498,
        548, 550, 552, 554, 556, 558, 560, 561, 562, 563, 564, 565, 566, 567,
        569, 571, 573, 574, 576, 578, 579
    )
    GROUP BY 1
    ORDER BY RAW_SUM DESC
""").fetchall()
for cur, n, s in rows:
    print(f"  {cur:6} n={n:<8} raw_sum={s:>20,.2f}")
con.close()
