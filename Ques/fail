def _diagnose_housing_loans() -> None:
    """Print how many rows survive each filter condition (cumulative) for LNNOTE and LOAN."""
    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp:
        ln_pq = Path(tmp) / "LNNOTE.parquet"
        lo_pq = Path(tmp) / "LOAN.parquet"
        _sas_to_parquet(INPUT_LNNOTE_FILE, ln_pq, "LNNOTE")
        _sas_to_parquet(INPUT_LOAN_FILE, lo_pq, "LOAN")
        con = duckdb.connect(database=":memory:")
        try:
            print("\n--- DIAG: ENTITY_CD values ---")
            print("LNNOTE:\n", con.execute(f"""
                SELECT ENTITY_CD, COUNT(*) AS n FROM read_parquet('{ln_pq.as_posix()}')
                GROUP BY 1 ORDER BY 2 DESC LIMIT 10""").pl())
            print("LOAN:\n", con.execute(f"""
                SELECT ENTITY_CD, COUNT(*) AS n FROM read_parquet('{lo_pq.as_posix()}')
                GROUP BY 1 ORDER BY 2 DESC LIMIT 10""").pl())

            print("\n--- DIAG: column types ---")
            print(con.execute(f"""
                SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_parquet('{ln_pq.as_posix()}'))
                WHERE column_name IN ('ACCTNO','NOTENO','REVERSED','PAIDIND','FLAG1','LOANTYPE',
                                      'RISKRATE','CUSTCODE','ORGTYPE','ENTITY_CD')""").pl())
            print(con.execute(f"""
                SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_parquet('{lo_pq.as_posix()}'))
                WHERE column_name IN ('ACCTNO','NOTENO','PRODUCT','APPRLIMT','NETPROC','BRANCH','ENTITY_CD')""").pl())

            print("\n--- DIAG: LNNOTE cumulative filter counts ---")
            print(con.execute(f"""
                WITH f AS (
                    SELECT
                        (TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = 'PIBB')            AS c_entity,
                        (COALESCE(CAST(REVERSED AS VARCHAR), '') <> 'Y')                     AS c_rev,
                        (COALESCE(CAST(PAIDIND AS VARCHAR), '') <> 'P')                      AS c_paid,
                        (NOTENO IS NOT NULL AND (NOTENO < 100
                            OR NOTENO BETWEEN 20000 AND 29999
                            OR (NOTENO BETWEEN 30000 AND 39999
                                AND COALESCE(CAST(FLAG1 AS VARCHAR), '') = 'F')))            AS c_note,
                        (CAST(LOANTYPE AS INTEGER) IN {_LNNOTE_LOANTYPES})                   AS c_type,
                        (COALESCE(CAST(RISKRATE AS VARCHAR), '') NOT IN ('1','2','3','4'))   AS c_risk,
                        (CAST(CUSTCODE AS INTEGER) IN (77,78,95,96))                         AS c_cust,
                        (CAST(ORGTYPE AS VARCHAR) IN ('E','M','N','S'))                      AS c_org
                    FROM read_parquet('{ln_pq.as_posix()}')
                )
                SELECT COUNT(*)                                                                       AS total,
                       COUNT(*) FILTER (WHERE c_entity)                                               AS entity,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev)                                     AS rev,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid)                          AS paid,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid AND c_note)               AS noteno,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid AND c_note AND c_type)    AS loantype,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid AND c_note AND c_type
                                          AND c_risk)                                                 AS risk,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid AND c_note AND c_type
                                          AND c_risk AND c_cust)                                      AS cust,
                       COUNT(*) FILTER (WHERE c_entity AND c_rev AND c_paid AND c_note AND c_type
                                          AND c_risk AND c_cust AND c_org)                            AS org
                FROM f""").pl())

            print("\n--- DIAG: LOAN cumulative filter counts ---")
            print(con.execute(f"""
                WITH f AS (
                    SELECT
                        (TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = 'PIBB')            AS c_entity,
                        ((PRODUCT IN {_SLOAN_PRODUCT_A} AND APPRLIMT >= 150000)
