# STEP 10: PROC SUMMARY DATA=PBIF2 NWAY; CLASS ITEM REMMTH; VAR AMOUNT;
# OUTPUT OUT=PBIF3(DROP=_TYPE_ _FREQ_) SUM=;
# CLASS REMMTH groups by the FORMATTED value; output is ordered by ITEM then
# by the bucket's position in REMFMT (ascending REMMTH), not alphabetically.
# ============================================================================
print("\nStep 10: Final summary by ITEM / REMMTH bucket...")

pbif3 = (
    pbif2_filtered
    .with_columns(
        pl.col("REMMTH_BUCKET")
          .map_elements(_REMFMT_LABELS.index, return_dtype=pl.Int64)
          .alias("_RANK")
    )
    .group_by(["ITEM", "REMMTH_BUCKET", "_RANK"])
    .agg(pl.col("AMOUNT").sum().alias("AMOUNT"))
    .sort(["ITEM", "_RANK"])
    .drop("_RANK")
)

print(pbif3)




# ----------------------------------------------------------------------------
# List-style PUT layout:  PUT @1 ITEM ';' REMMTH ';' AMOUNT +(-1) ';'
#   ITEM   : $ITEMF. -> padded to the format's default width (longest label, max 40)
#   REMMTH : REMFMT. -> padded to the format's default width (longest label = 15)
#   one blank follows each list-output variable (AMOUNT's is removed by +(-1))
#   AMOUNT : unformatted numeric -> BEST12., written without leading blanks
# ----------------------------------------------------------------------------
ITEMF_WIDTH  = 40
REMFMT_WIDTH = 15


def _best12(value) -> str:
    """SAS BEST12. as written by list output (no leading blanks)."""
    if value is None or value != value:
        return "."
    if value == 0:
        return "0"
    sign = 1 if value < 0 else 0
    int_digits = len(str(int(abs(value))))
    if sign + int_digits <= 12:
        decimals = max(0, 12 - sign - int_digits - 1)
        text = f"{value:.{decimals}f}"
        if len(text) > 12 and decimals > 0:      # rounding carried into a new digit
            text = f"{value:.{decimals - 1}f}"
        if "." in text:
            text = text.rstrip("0").rstrip(".")
        return text
    mant, exp = f"{value:.5E}".split("E")       # too large for 12 chars -> E notation
    return f"{mant.rstrip('0').rstrip('.')}E{int(exp)}"


def _format_detail_line(item_code: str, remmth_label: str, amount) -> str:
    item_txt   = _itemf(item_code)[:ITEMF_WIDTH].ljust(ITEMF_WIDTH)
    remmth_txt = remmth_label[:REMFMT_WIDTH].ljust(REMFMT_WIDTH)
    return f"{item_txt} ;{remmth_txt} ;{_best12(amount)};"




for row in pbif3.iter_rows(named=True):
    line = _format_detail_line(row["ITEM"], row["REMMTH_BUCKET"], row["AMOUNT"])
    output_lines.append(line.ljust(LRECL)[:LRECL])




