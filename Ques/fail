def _date_expr(con, parquet: Path, col: str) -> str:
    """DuckDB expression returning a DATE whether the column landed as TIMESTAMP/DATE,
    a raw SAS datetime (seconds since 1960) or a raw SAS date (days since 1960)."""
    col_type = con.execute(
        f"DESCRIBE SELECT {col} FROM read_parquet('{parquet.as_posix()}')"
    ).fetchone()[1].upper()
    if col_type.startswith(("TIMESTAMP", "DATE")):
        return f"CAST({col} AS DATE)"
    num = f"CAST({col} AS DOUBLE)"
    return (
        f"CASE WHEN {col} IS NULL OR ISNAN({num}) THEN NULL "
        f"WHEN {num} > 100000000 THEN CAST(TIMESTAMP '1960-01-01 00:00:00' "
        f"+ to_seconds(CAST(ROUND({num}) AS BIGINT)) AS DATE) "
        f"ELSE DATE '1960-01-01' + CAST(FLOOR({num}) AS INTEGER) END"
    )




