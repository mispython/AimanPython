# Production Path
INPUT_DIR  = Path("/dwh")
OUTPUT_DIR = Path("/host/mis/output/report") / "EIBWCTCS"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# SAP.PBB.EPCU.CTCS.TXT(0) -- the weekly flat-file input
TXTFILE_PATH = INPUT_DIR / "EPCU_CTCS.TXT"

# Control table holding the batch date per source system
CTL_DIR             = INPUT_DIR
CTL_BATCH_TABLE     = "ctl_dwh_batch_dttm"
BATCH_SOURCE_SYSTEM = "DP"

# SAS session / librefs (CTCS libref = location of CTCS.CTCS&REPTMON)
SAS_CFGNAME  = "default"
CTL_LIBREF   = "CTL"
CTCS_LIBREF  = "CTCS"

sas = saspy.SASsession(cfgname=SAS_CFGNAME)
atexit.register(sas.endsas)          # session always closed, even on sys.exit(77) or an error
sas.saslib(CTL_LIBREF,  path=str(CTL_DIR))
sas.saslib(CTCS_LIBREF, path=str(OUTPUT_DIR))




# ============================================================================
# REPORT DATE FROM SOURCE_SYSTEM_CD = 'DP' BATCH DATE
# Replaces LOAN.REPTDATE of the original SAS program.
# ============================================================================
SAS_EPOCH = date(1960, 1, 1)


def sas_date_number(d: date) -> float:
    """SAS date value (days since 01JAN1960), as stored by &RDATE / YYMMDD8."""
    return float((d - SAS_EPOCH).days)


def get_dp_batch_date(sas_session) -> date:
    """Read BATCH_DTTM of the DP source system from ctl_dwh_batch_dttm."""
    ds = sas_session.sasdata(
        CTL_BATCH_TABLE,
        CTL_LIBREF,
        dsopts={"where": f"SOURCE_SYSTEM_CD='{BATCH_SOURCE_SYSTEM}'"},
    )
    df = ds.to_df()
    df.columns = [str(c).upper() for c in df.columns]

    if df.empty or pd.isna(df["BATCH_DTTM"].iloc[0]):
        raise ValueError(
            f"NO BATCH_DTTM FOUND FOR SOURCE_SYSTEM_CD='{BATCH_SOURCE_SYSTEM}' "
            f"IN {CTL_BATCH_TABLE}"
        )

    value = df["BATCH_DTTM"].iloc[0]
    if pd.api.types.is_number(value):    # raw SAS datetime (seconds since 1960)
        return (datetime(1960, 1, 1) + timedelta(seconds=float(value))).date()
    return pd.Timestamp(value).date()




# ============================================================================
# READ HEADER ROW OF TXTFILE TO DERIVE FILEDATE
# ============================================================================
with open(TXTFILE_PATH, "r") as _f:
    _header = _f.readline()

_yy = int(_header[2:6])
_mm = int(_header[6:8])
_dd = int(_header[8:10])
_file_raw_date = date(_yy, _mm, _dd)
_tdate = _file_raw_date - timedelta(days=1)

FILEDAY    = f"{_tdate.day:02d}"
FILEMON    = f"{_tdate.month:02d}"
FILEYEAR   = str(_tdate.year)[-2:]
FILEDATE   = _tdate.strftime("%d/%m/%y")        # DDMMYY8.

# REPTDATE = DP batch date (original: LOAN.REPTDATE)
_reptdate_val: date = get_dp_batch_date(sas)

REPTDAY    = f"{_reptdate_val.day:02d}"
REPTMON    = f"{_reptdate_val.month:02d}"
REPTYEAR   = str(_reptdate_val.year)[-2:]
RDATE_STR  = _reptdate_val.strftime("%d/%m/%y")  # &REPTDATE (DDMMYY8.)
RDATE_NUM  = sas_date_number(_reptdate_val)      # &RDATE

CTCS_TABLE = f"CTCS{REPTMON}"                    # CTCS.CTCS&REPTMON

# Debug report date
print("\n========== CHECKING REPORT DATE ==========\n")
print("RAW HEADER: ", _header)
print("PARSED DATE: ", _file_raw_date)
print("TDATE: ", _tdate)
print("REPTDATE (DP BATCH): ", _reptdate_val)

# ============================================================================
# DATA _NULL_ -- validation: FILEDATE must equal REPTDATE
# ============================================================================
if FILEDATE != RDATE_STR:
    print(f"THE SAP.PBB.EPCU.CTCS IS NOT DATED {RDATE_STR}")
    sys.exit(77)




# ============================================================================
# DATA CTCS -- parse transaction rows (skip header, skip TOTAL)
# Numeric fields are stored as SAS numerics; TRANDT and REPTDATE are SAS date
# numbers without a format, as in the original (INPUT YYMMDD8. / REPTDATE=&RDATE).
# An unreadable field becomes missing but the row is kept (SAS MISSOVER).
# ============================================================================
CTCS_SCHEMA = {
    "TRANDT":   pl.Float64,
    "ACCTNO":   pl.Float64,
    "NOTENO":   pl.Float64,
    "CHEQNO":   pl.Float64,
    "TRANAMT":  pl.Float64,
    "IND":      pl.String,
    "PRODIND":  pl.String,
    "TRANCD":   pl.String,
    "REPTDATE": pl.Float64,
}


def _num(text: str) -> Optional[float]:
    text = text.strip()
    if not text:
        return None
    try:
        return float(text)
    except ValueError:
        return None


def _amount(text: str) -> Optional[float]:
    """10.2 informat: implied 2 decimals unless the field has a decimal point."""
    text = text.strip()
    if not text:
        return None
    try:
        value = float(text)
    except ValueError:
        return None
    return value if "." in text else value / 100.0


def _trandt(text: str) -> Optional[float]:
    """YYMMDD8. informat (YYYYMMDD) -> SAS date number."""
    text = text.strip()
    if len(text) != 8:
        return None
    try:
        return sas_date_number(date(int(text[0:4]), int(text[4:6]), int(text[6:8])))
    except ValueError:
        return None


_records: list[dict] = []

with open(TXTFILE_PATH, "r") as _f:
    next(_f, None)                                   # FIRSTOBS=2
    for _line in _f:
        _line = _line.rstrip("\r\n")
        if _line[0:5].strip() == "TOTAL":            # CHECK NE 'TOTAL'
            continue
        _records.append({
            "TRANDT":   _trandt(_line[8:16]),        # @009  YYMMDD8.
            "ACCTNO":   _num(_line[17:27]),          # @018  10.
            "NOTENO":   _num(_line[28:33]),          # @029  5.
            "CHEQNO":   _num(_line[34:40]),          # @035  6.
            "TRANAMT":  _amount(_line[41:51]),       # @042  10.2
            "IND":      _line[52:54].strip(),        # @053  $2.
            "PRODIND":  _line[55:56].strip(),        # @056  $1.
            "TRANCD":   _line[57:59].strip(),        # @058  $2.
            "REPTDATE": RDATE_NUM,                   # REPTDATE=&RDATE
        })

ctcs_new = pl.DataFrame(_records, schema=CTCS_SCHEMA)




# ============================================================================
# %MACRO APPEND
# ============================================================================
def read_ctcs_accumulator() -> pl.DataFrame:
    """SET CTCS.CTCS&REPTMON -- the original fails if the dataset does not exist."""
    if not sas.exist(CTCS_TABLE, libref=CTCS_LIBREF):
        raise FileNotFoundError(
            f"DATASET {CTCS_LIBREF}.{CTCS_TABLE} DOES NOT EXIST IN {OUTPUT_DIR}"
        )
    pdf = sas.sasdata(CTCS_TABLE, CTCS_LIBREF).to_df()
    pdf.columns = [str(c).upper() for c in pdf.columns]
    return pl.from_pandas(pdf).select(list(CTCS_SCHEMA)).cast(CTCS_SCHEMA)


def write_ctcs_accumulator(df: pl.DataFrame) -> None:
    """DATA CTCS.CTCS&REPTMON; -- replaces the dataset as a .sas7bdat."""
    sas.df2sd(
        df.to_pandas(),
        table=CTCS_TABLE,
        libref=CTCS_LIBREF,
        char_lengths={"IND": 2, "PRODIND": 1, "TRANCD": 2},
    )


if FILEDAY == "08":                                   # 1ST WEEK
    ctcs_out = ctcs_new
else:
    # IF REPTDATE EQ &RDATE THEN DELETE (rows with missing REPTDATE are kept)
    ctcs_existing = read_ctcs_accumulator().filter(
        pl.col("REPTDATE").ne_missing(RDATE_NUM)
    )
    # SET CTCS CTCS.CTCS&REPTMON -> new rows first, then existing
    ctcs_out = pl.concat([ctcs_new, ctcs_existing], how="vertical")

write_ctcs_accumulator(ctcs_out)




print(f"CTCS dataset written: {OUTPUT_DIR / (CTCS_TABLE.lower() + '.sas7bdat')}")
print(f"  New rows this run : {ctcs_new.height}")
print(f"  Total rows stored : {ctcs_out.height}")
print(f"  Report date       : {RDATE_STR}")
print(f"  File date         : {FILEDATE}")

# TO SHOW DATA FOR TESTING PURPOSE ONLY
print("\n ========== PREVIEW ========== \n")
print(ctcs_out)
