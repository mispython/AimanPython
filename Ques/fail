def _render_table_header() -> list[str]:
    lines = []
    buf = _new_buf()
    _put(buf, 1, "  FMTNAME  BNMCODE         DESC                                      SIGN                  AMOUNT                   TOTAL")
    lines.append(_line(buf, " "))
    buf = _new_buf()
    _put(buf, 3, "-" * 119)
    lines.append(_line(buf, " "))
    return lines
