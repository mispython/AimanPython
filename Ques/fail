def _sas_best12_full(v) -> str:
    """PUT var (BEST12.) with NO +(-1) rewind - 12 visible columns."""
    if v is None:
        return ".".rjust(12)
    if isinstance(v, float) and v.is_integer():
        body = str(int(v))
    else:
        body = str(v)
    return body.rjust(12)
