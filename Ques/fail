def _append_isbase(existing_pl: pl.DataFrame, new_rows: list) -> None:
    """PROC APPEND DATA=LNRELS1 BASE=LNHIST.ISBASE -> rewrite isbase.sas7bdat via saspy."""
    if not new_rows:
        print("  PROC APPEND equivalent: no new LNRELS1 rows to append.")
        return
    keys = {"ACCTNO": pl.Float64, "NOTENO": pl.Float64}
    new_df = pl.DataFrame(new_rows).cast(keys)
    base_df = existing_pl.with_columns([pl.col(c).cast(t) for c, t in keys.items()])
    combined = pl.concat([base_df, new_df], how="diagonal")
    _write_isbase(combined)
    print(f"  PROC APPEND equivalent: appended {len(new_rows):,} rows to "
          f"{INPUT_ISBASE_FILE.name} (total rows now {combined.height:,}).")




