# We need to separate the reports into blocks that have their own headers.
# For pivot reports, they have titles and column headers.
# For pibelq_lines, each day is a block with its own titles and headers.

# First, paginate the pivot reports (RENTAS, Variance, Rev Repo) - they have no groups
# We need to identify the header lines for each pivot report.
# Since each pivot report is a continuous list of lines starting with titles and a header,
# we can treat the first few lines as header.

def extract_header_lines(block_lines: list[str], num_title_lines: int) -> list[str]:
    # Assume the header consists of title lines, then the column header line, then dashed line.
    # The exact number varies; we can find the dashed line by searching for "--------"
    # and take everything up to and including that.
    header = []
    for line in block_lines:
        header.append(line)
        if "---" in line:  # dashed line indicates end of header
            break
    return header

# Paginate each pivot report separately
paginated_reports = []
for report_lines in [report1_lines, report2_lines, report3_lines]:
    if not report_lines:
        continue
    header = extract_header_lines(report_lines, 3)  # titles count is approximate
    paginated = _paginate_simple(report_lines, PAGE_SIZE, header)
    paginated_reports.extend(paginated)

# Now handle pibelq_lines: split into day blocks
# Each day block starts with a line containing "DETAIL TOTAL ELIGIBLE LIABILITIES ITEMS FOR : DAY"
day_blocks = []
current_block = []
for line in pibelq_lines:
    if "DETAIL TOTAL ELIGIBLE LIABILITIES ITEMS FOR : DAY" in line and current_block:
        day_blocks.append(current_block)
        current_block = [line]
    else:
        current_block.append(line)
if current_block:
    day_blocks.append(current_block)

# Paginate each day block with group reprinting
paginated_pibelq = []
for block in day_blocks:
    # Extract the header lines (titles + column header + dashed line)
    header = extract_header_lines(block, 3)  # titles vary but we extract dynamically
    paginated_block = _paginate_with_groups(block, PAGE_SIZE, header)
    paginated_pibelq.extend(paginated_block)

# Combine all reports
all_lines = paginated_reports + paginated_pibelq

