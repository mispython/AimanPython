            CASE WHEN ACCTYPE = 'LN' THEN
                CASE WHEN (COALESCE(RLEASAMT, -1e300) <> 0 AND PNOTPC AND ORIBAL > 0
                           AND COALESCE(CJFEE, -1e300) <> COALESCE(ORIBAL, -1e300))
