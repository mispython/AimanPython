_REMFMT_ORDER_INDEX = {label: i for i, label in enumerate(_REMFMT_ORDER)}


def _remmth1_sort_key(label: str) -> int:
    return _REMFMT_ORDER_INDEX.get(label, len(_REMFMT_ORDER))

