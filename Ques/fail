def sftp_upload(local_path: Path, remote_name: str) -> None:
    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(SFTP_ID, SFTP_HOST)

    ssh = paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    print(f"  Connecting to {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    sftp = ssh.open_sftp()
    try:
        try:
            sftp.chdir(SFTP_REMOTE_DIR)
        except IOError:
            sys.exit(f"Aborting: remote folder '{SFTP_REMOTE_DIR}' not found")
        print(f"  SFTP upload: {local_path.name} -> {SFTP_REMOTE_DIR}/{remote_name}")
        sftp.put(str(local_path), remote_name)
    finally:
        sftp.close()
        ssh.close()
    print("  SFTP upload complete.")


