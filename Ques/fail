def _asof_carry(base_df, value_df, value_col):
    """
    Emulate SAS:  MERGE base(IN=A) value(IN=B); BY ACCTNO; IF A;

    - Exact key match  -> value_col is taken from value_df
    - No exact match   -> value_col carries forward from the closest
                          value_df row with ACCTNO <= current ACCTNO
                          (this is the SAS MERGE auto-retain rule for a
                          variable that only exists on the non-matching
                          side of a BY-group merge).
    - No earlier row   -> NULL (SAS missing, prints as 0 via MISSING=0).
    """
    base_sorted  = base_df.sort("ACCTNO", maintain_order=True)
    value_sorted = (
        value_df
        .sort("ACCTNO", maintain_order=True)
        .select(["ACCTNO", value_col])
    )
    return base_sorted.join_asof(
        value_sorted, on="ACCTNO", strategy="backward"
    )




