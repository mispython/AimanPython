import sys
import paramiko




SFTP_CONTROL_FILE = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")

# DRR (Data Report Repository) SFTP target
DRR_HOST_DESC   = "Data Report Repository (DRR)"   # HOST_DESC in ctl_dwh_sftp_info
DRR_REMOTE_FILE = "BODPPR.TXT"                      # original: put SAP.PBB.BOD.PAPERS -> BODPPR.TXT
DRR_REMOTE_DIR  = ""                                # "" = SFTP login directory (no CD in the original job note)




# ============================================================================
# SFTP CONFIGURATION READER  (reads ctl_dwh_sftp_info.sas7bdat directly)
# ============================================================================
def get_sftp_info(host_desc: str):
    """Read one SFTP configuration row from the DWH SFTP control file."""
    if not SFTP_CONTROL_FILE.exists():
        raise FileNotFoundError(f"SFTP control file not found: {SFTP_CONTROL_FILE}")

    ctl = pd.read_sas(SFTP_CONTROL_FILE, format="sas7bdat", encoding="utf-8")
    ctl.columns = [str(c).upper().strip() for c in ctl.columns]

    required = {"HOST_DESC", "SFTP_ID", "SFTP_PW", "HOST_IP"}
    missing_columns = sorted(required.difference(ctl.columns))
    if missing_columns:
        raise RuntimeError("SFTP control file is missing columns: " + ", ".join(missing_columns))

    descriptions = ctl["HOST_DESC"].fillna("").astype(str).str.strip()
    rows = ctl[descriptions.eq(host_desc)]
    if len(rows) != 1:
        raise RuntimeError(f"Expected exactly one SFTP row for '{host_desc}'; found {len(rows)}")

    row = rows.iloc[0]

    # SAS character values can contain fixed-width padding.
    clean = lambda value: "".join(str(value).split()) if pd.notna(value) else ""
    sftp_id  = clean(row["SFTP_ID"])
    sftp_pw  = clean(row["SFTP_PW"])
    host_ip  = clean(row["HOST_IP"])
    host_key = clean(row["HOST_KEY"]) if "HOST_KEY" in ctl.columns else ""

    empty_values = [
        name for name, value in (
            ("SFTP_ID", sftp_id), ("SFTP_PW", sftp_pw), ("HOST_IP", host_ip)
        ) if not value
    ]
    if empty_values:
        raise RuntimeError(f"SFTP row for '{host_desc}' has blank values: {', '.join(empty_values)}")

    return sftp_id, sftp_pw, host_ip, host_key


# ============================================================================
# SFTP UPLOAD TO DRR
# //RUNSFTP EXEC COZBATCH; put SAP.PBB.BOD.PAPERS -> BODPPR.TXT to DRR repository
# ============================================================================
def sftp_upload_to_drr(local_file: Path, remote_filename: str, remote_dir: str = "") -> None:
    """Upload the report file to the DRR server as-is."""
    sftp_id, sftp_pw, host_ip, host_key = get_sftp_info(DRR_HOST_DESC)

    ssh = paramiko.SSHClient()
    # HOST_KEY from ctl_dwh_sftp_info is blank for the DRR row, so strict host-key
    # pinning is not possible; unknown host keys are auto-accepted.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to DRR host {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    sftp = ssh.open_sftp()

    try:
        if remote_dir:
            try:
                sftp.chdir(remote_dir)
            except IOError:
                sys.exit(f"Aborting: Remote DRR folder '{remote_dir}' not found")

        target = f"{remote_dir}/{remote_filename}" if remote_dir else remote_filename
        print(f"  SFTP upload: {local_file.name} -> {target}")
        sftp.put(str(local_file), remote_filename)
    finally:
        sftp.close()
        ssh.close()

    print("  DRR upload complete.")




print("\nUploading report to DRR via SFTP...")
sftp_upload_to_drr(OUTPUT_FILE, DRR_REMOTE_FILE, DRR_REMOTE_DIR)
