PAGE_SIZE = 60



def _paginate_simple(lines: list[str], page_size: int, header_lines: list[str]) -> list[str]:
    """
    Paginate a list of lines where only the header lines (titles + column headers)
    need to be repeated on every page. No group reprinting.
    """
    if not lines:
        return []
    result = []
    # Count header lines: we assume header_lines is already provided
    header_count = len(header_lines)
    # The remaining lines are data lines
    data_lines = lines[header_count:]
    if not data_lines:
        return lines  # nothing to paginate

    # Total lines per page = header_count + data lines
    for i in range(0, len(data_lines), page_size - header_count):
        page_data = data_lines[i:i + page_size - header_count]
        result.extend(header_lines)
        result.extend(page_data)
    return result


def _paginate_with_groups(lines: list[str], page_size: int, header_lines: list[str]) -> list[str]:
    """
    Paginate a list of lines that contains groups (FMTNAME printed only on first row).
    On each new page, reprint the header lines, and if the group continues,
    reprint the FMTNAME for that group at the top of the new page.
    """
    if not lines:
        return []
    header_count = len(header_lines)
    data_lines = lines[header_count:]
    if not data_lines:
        return lines

    # Scan data_lines to find group starts (lines with non-space at column 1)
    group_starts = []   # list of (index, fmtname) where index is in data_lines
    current_fmt = None
    for idx, line in enumerate(data_lines):
        # Check if the line has a non-space in column 1 (FMTNAME)
        if len(line) > 0 and line[0] != ' ':
            # Extract the FMTNAME (first 7 characters)
            current_fmt = line[:7].strip()
            group_starts.append((idx, current_fmt))
        # else: we could store the last fmt for later, but we already have it

    # We'll iterate through data_lines and split into pages
    result = []
    page_start = 0
    while page_start < len(data_lines):
        # Determine the end of this page (up to page_size - header_count lines)
        page_end = min(page_start + (page_size - header_count), len(data_lines))
        # Check if we need to reprint a group header on this new page
        # If page_start > 0 (not first page) and the first line of this page is not a group start,
        # we need to reprint the FMTNAME of the previous group.
        if page_start > 0:
            # Find the last group start before this page
            last_group_idx = -1
            last_group_fmt = None
            for idx, fmt in reversed(group_starts):
                if idx < page_start:
                    last_group_idx = idx
                    last_group_fmt = fmt
                    break
            if last_group_fmt is not None:
                # Check if the first line of this page is a group start
                first_line = data_lines[page_start]
                is_group_start = (len(first_line) > 0 and first_line[0] != ' ')
                if not is_group_start:
                    # We need to reprint the group header before the page content
                    # Create a line with the FMTNAME at column 1, and blank elsewhere
                    buf = _new_buf()
                    _put(buf, 1, last_group_fmt)
                    group_header_line = _line(buf, " ")
                    # Insert it at the beginning of the page data, but after the header lines
                    # So we will include it as the first data line of this page
                    # But we need to adjust page_end to include it, and we must not exceed page_size
                    # We'll insert it by prepending to the page slice
                    page_data = [group_header_line] + data_lines[page_start:page_end]
                    # However, this may cause the page to have more lines than page_size, so we need to trim
                    # We'll set page_end = page_start + (page_size - header_count - 1) to leave room for the group header
                    # But we already computed page_end. Better: we'll adjust page_end before slicing.
                    # We'll do it differently: after we know we need to reprint, we reduce the number of data lines by 1.
                    # So we set page_end = min(page_start + (page_size - header_count - 1), len(data_lines))
                    # and then we prepend the group header.
                    # Let's recalc:
                    max_data_lines = page_size - header_count - 1  # reserve one line for group header
                    page_end = min(page_start + max_data_lines, len(data_lines))
                    page_data = [group_header_line] + data_lines[page_start:page_end]
                else:
                    page_data = data_lines[page_start:page_end]
            else:
                page_data = data_lines[page_start:page_end]
        else:
            page_data = data_lines[page_start:page_end]

        # Add the header lines for this page
        result.extend(header_lines)
        result.extend(page_data)
        page_start = page_end

    return result



