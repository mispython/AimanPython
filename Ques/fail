def _best12(value) -> str:
    """SAS BEST12. (PROC PRINT default for unformatted numerics); '.' for missing."""
    if value is None:
        return "."
    v = float(value)
    if v != v:
        return "."
    if v == int(v) and abs(v) < 1e12:
        return str(int(v))
    for decimals in range(11, -1, -1):
        text = f"{v:.{decimals}f}"
        if len(text) <= 12:
            return text.rstrip("0").rstrip(".") if "." in text else text
    return f"{v:.6E}"




