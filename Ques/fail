    DEPT_CACHE = output_cache_dir / f"DEPT{reptmon}{nowk}.parquet"

    SAVING_SAS_CACHE  = saving_cache
    CURRENT_SAS_CACHE = current_cache
    CISDP_SAS_CACHE   = cisdp_cache

