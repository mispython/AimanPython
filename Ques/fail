# ============================================================================
# CONTROL FILES  (dates: ctl_dwh_batch_dttm | SFTP info: ctl_dwh_sftp_info)
# ============================================================================
CTL_BATCH_DTTM    = Path("/sasdata/dwh/control/ctl_dwh_batch_dttm.sas7bdat")
SFTP_CONTROL_FILE = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")
BATCH_SOURCE      = "DP"


def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM for the given SOURCE_SYSTEM_CD from the control file."""
    if not CTL_BATCH_DTTM.exists():
        raise FileNotFoundError(f"Batch date control file not found: {CTL_BATCH_DTTM}")
    ctl = pd.read_sas(str(CTL_BATCH_DTTM), encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {CTL_BATCH_DTTM}")
    return pd.Timestamp(hit.iloc[0]).date()


def get_sftp_info(host_desc: str):
    """Read one SFTP configuration row directly from the DWH control file."""
    if not SFTP_CONTROL_FILE.exists():
        raise FileNotFoundError(f"SFTP control file not found: {SFTP_CONTROL_FILE}")

    ctl = pd.read_sas(SFTP_CONTROL_FILE, format="sas7bdat", encoding="utf-8")
    ctl.columns = [str(c).upper().strip() for c in ctl.columns]

    required = {"HOST_DESC", "SFTP_ID", "SFTP_PW", "HOST_IP"}
    missing_columns = sorted(required.difference(ctl.columns))
    if missing_columns:
        raise RuntimeError("SFTP control file is missing columns: " + ", ".join(missing_columns))

    descriptions = ctl["HOST_DESC"].fillna("").astype(str).str.strip()
    rows = ctl[descriptions.eq(host_desc)]
    if len(rows) != 1:
        raise RuntimeError(f"Expected exactly one SFTP row for '{host_desc}'; found {len(rows)}")

    row = rows.iloc[0]
    clean = lambda value: "".join(str(value).split()) if pd.notna(value) else ""
    sftp_id = clean(row["SFTP_ID"])
    sftp_pw = clean(row["SFTP_PW"])
    host_ip = clean(row["HOST_IP"])
    host_key = clean(row["HOST_KEY"]) if "HOST_KEY" in ctl.columns else ""

    empty_values = [
        name for name, value in (
            ("SFTP_ID", sftp_id), ("SFTP_PW", sftp_pw), ("HOST_IP", host_ip)
        ) if not value
    ]
    if empty_values:
        raise RuntimeError(f"SFTP row for '{host_desc}' has blank values: {', '.join(empty_values)}")

    return sftp_id, sftp_pw, host_ip, host_key




# ============================================================================
# SFTP STEP  (ask.py, job FTPMRMRP):
#   cd TEXTFILE / cd RETAILBANK
#   PUT //SAP.PIBB.EIIMRMnn.TEXT   EIIMRMnn@%OMM.%OYY..TXT
# ============================================================================
MRM_HOST_DESC   = "EDW DB Server"            # HOST_DESC row in ctl_dwh_sftp_info
MRM_REMOTE_DIRS = ["TEXTFILE", "RETAILBANK"]
_MRM_REPORTS    = ["EIIMRM01", "EIIMRM02", "EIIMRM03", "EIIMRM04"]


def _sftp_step() -> None:
    print("\nStep SFTP: uploading EIIMRM01-04 reports...")
    stamp = get_batch_date(BATCH_SOURCE).strftime("%m%y")      # %OMM.%OYY

    uploads = []
    for name in _MRM_REPORTS:
        local_path = _CREATE_DIRS[0] / f"{name}.txt"
        if not local_path.exists():
            raise FileNotFoundError(f"Report file not found for SFTP: {local_path}")
        uploads.append((local_path, f"{name}@{stamp}.TXT"))

    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(MRM_HOST_DESC)

    ssh = paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    print(f"  Connecting to {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    try:
        sftp = ssh.open_sftp()
        try:
            for remote_dir in MRM_REMOTE_DIRS:
                try:
                    sftp.chdir(remote_dir)
                except IOError:
                    raise RuntimeError(f"Remote folder '{remote_dir}' not found")
            for local_path, remote_name in uploads:
                print(f"  SFTP upload: {local_path.name} -> {'/'.join(MRM_REMOTE_DIRS)}/{remote_name}")
                sftp.put(str(local_path), remote_name)
        finally:
            sftp.close()
    finally:
        ssh.close()
    print("  SFTP upload complete.")




def main() -> int:
    # TYPRUN=SCAN on the original JOB card meant syntax-scan only, no steps
    # actually executed -- documentation-only note; this driver always runs.
    _delete_step()
    _create_step()
    rc = _run_steps()
    if rc == 0:
        try:
            _sftp_step()
        except Exception as exc:
            rc = 8
            print(f"=== SFTP FAILED (RC=8): {exc} ===", file=sys.stderr)
    else:
        print(f"Step SFTP SKIPPED (COND=(4,LT): prior RC={rc} > 4).")
    print(f"\nEIIMRPTS job complete. Final RC={rc}")
    return 0 if rc == 0 else 1




