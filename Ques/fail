RECORD_LENGTH   = 800
LINE_TERMINATOR = "\n"   # JCL: lzopts linerule=$lr (same convention as EIWFRMCR)

# Remote filename: HPTXT%CYYYY.%CMM.%CDD..TXT -> HPTXTYYYYMMDD.TXT
