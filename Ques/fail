# =============================================================================
# MAIN: ONE BANK
# =============================================================================

def run_bank(cfg: BankConfig, loan_parquet: Path, lnnote_parquet: Path,
             lncomm_parquet: Path) -> bool:
    """
    Process one bank (PBB / PIBB). Inputs are the temporary Parquet files.
    Returns True on success, False otherwise.
    """
    print(f"\nProcessing {cfg.bank_code} section...")

    try:
        lnnote1, lnnote2 = build_lnnote_datasets(
            loan_parquet, lnnote_parquet, lncomm_parquet, cfg.entity_op
        )
        print(f"  LNNOTE1 records: {len(lnnote1):,}")
        print(f"  LNNOTE2 records: {len(lnnote2):,}")

        write_lnlisd(lnnote1, cfg.lnlisd_txt)
        print(f"  Written: {cfg.lnlisd_txt}")

        # Flat TEXT file (no date, no extension) = SAP.xxxx.LOANLIST.TEXT sent as LOANLIST / ILOANLIST
        shutil.copyfile(cfg.lnlisd_txt, cfg.lnlisd_flat)
        print(f"  Written flat file: {cfg.lnlisd_flat}")

        write_lnlist_fiss(lnnote1, RDATE, cfg.lnlist_txt, cfg.bank_title, mode='w')
        print(f"  Written FISS section: {cfg.lnlist_txt}")

        write_lnlist_sector(lnnote2, RDATE, cfg.lnlist_txt, cfg.bank_title, mode='a')
        print(f"  Appended Sector section: {cfg.lnlist_txt}")

        del lnnote1, lnnote2
        gc.collect()
        print(f"{cfg.bank_code} section complete.")
        return True

    except Exception as e:
        print(f"\n[ERROR] {cfg.bank_code} failed: {type(e).__name__}: {e}")
        return False


