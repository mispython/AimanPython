import pyreadstat
import polars as pl
from pathlib import Path

CARD_SAS = Path("/stgsrcsys/host/uat/AII/EIBDUNDP/host_unicard260902.sas7bdat")
CARD_PARQUET = Path("/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/input/cache/EIBDUNDP/host_unicard260902.parquet")

zhong = ['040223101535', '940614075809', 'E64283528',
         'EF1567003', 'EJ8129732', 'EK9320493']

print("=== SOURCE .sas7bdat ===")
df, _ = pyreadstat.read_sas7bdat(str(CARD_SAS))
sub = df[df["NEWIC"].astype(str).str.strip().isin(zhong)]
print(sub[["NEWIC", "MONITOR", "SOURCE", "ACCTYPE", "CLOSECD"]].to_string())
