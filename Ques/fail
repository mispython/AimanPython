import pyreadstat
from pathlib import Path

D = Path("/stgsrcsys/host/uat/AII/EIBDUNDP")
TARGET_ACCT   = 1595256021
TARGET_CURBAL = 11630.87

for f in sorted(D.glob("*.sas7bdat")):
    try:
        df, _ = pyreadstat.read_sas7bdat(str(f))
    except Exception as e:
        print(f"{f.name:40s}  SKIP ({e})")
        continue

    if "ACCTNO" not in df.columns:
        print(f"{f.name:40s}  no ACCTNO column, rows={len(df)}")
        continue

    df["_A"] = df["ACCTNO"].astype("float").astype("int64")

    hit_exact  = df[df["_A"] == TARGET_ACCT]
    hit_near   = df[(df["_A"] >= 1595256000) & (df["_A"] <= 1595256100)]

    hit_curbal = None
    if "CURBAL" in df.columns:
        hit_curbal = df[df["CURBAL"].astype("float").between(TARGET_CURBAL - 0.5,
                                                              TARGET_CURBAL + 0.5)]

    tag = []
    if len(hit_exact):   tag.append(f"EXACT={len(hit_exact)}")
    if len(hit_near):    tag.append(f"NEAR={len(hit_near)}")
    if hit_curbal is not None and len(hit_curbal):
        tag.append(f"CURBAL={len(hit_curbal)}")

    print(f"{f.name:40s}  rows={len(df):>10,}  {'  '.join(tag) if tag else '-'}")

    if len(hit_exact):
        print("   exact rows:")
        print(hit_exact[["ACCTNO"] + (["CURBAL"] if "CURBAL" in df.columns else [])].to_string())
    if len(hit_near):
        print("   nearby rows:")
        print(hit_near[["ACCTNO"] + (["CURBAL"] if "CURBAL" in df.columns else [])].head(10).to_string())
    if hit_curbal is not None and len(hit_curbal):
        print("   balance-match rows:")
        print(hit_curbal[["ACCTNO"] + (["CURBAL"] if "CURBAL" in df.columns else [])].head(10).to_string())
