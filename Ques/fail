DATA CISCA;
   	SET RS_CIS.CISR1CA&REPTMON&NOWK&REPTYY;
   	IF SECCUST=901;
	IF (3000000000<=ACCTNO<=3999999999) THEN OUTPUT CISCA;
RUN;
PROC SORT DATA=CISCA NODUPKEY; BY ACCTNO; RUN;

DATA CISFD;
   	SET RS_CIS.CISR1FD&REPTMON&NOWK&REPTYY;
   	IF SECCUST=901;
	IF (1000000000<=ACCTNO<=1999999999) THEN OUTPUT CISFD;
   IF (7000000000<=ACCTNO<=7999999999) THEN OUTPUT CISFD;

RUN;
PROC SORT DATA=CISFD NODUPKEY; BY ACCTNO; RUN;
