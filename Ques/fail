def _find_input(directory: Path, stem: str) -> Path:
    """Return the file in *directory* whose name starts with *stem*."""
    matches = sorted(directory.glob(f"{stem}*"))
    if not matches:
        raise FileNotFoundError(f"Input file not found in {directory} (expected prefix '{stem}')")
