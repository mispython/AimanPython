CHUNK_ROWS = 500_000
TEMP_DIR   = None   # None = system temp; set a path if the default temp area is too small

# Report configuration
PAGE_SIZE = 60   # Default PS=60 (OPTIONS PS= not explicitly set in SAS source)




def sas_to_parquet(src: Path, dst: Path, chunk_rows: int = CHUNK_ROWS) -> None:
    """Chunked .sas7bdat -> Parquet. Schema is locked on the first chunk."""
    writer, schema = None, None
    try:
        for chunk in pd.read_sas(str(src), encoding="latin1", chunksize=chunk_rows):
            # Force text columns to string so an all-null first chunk doesn't lock a null type
            for col in chunk.columns[chunk.dtypes == object]:
                chunk[col] = chunk[col].astype("string")
            table = pa.Table.from_pandas(chunk, preserve_index=False)
            if writer is None:
                schema = table.schema
                writer = pq.ParquetWriter(str(dst), schema, compression="snappy")
            else:
                table = table.cast(schema)
            writer.write_table(table)
    finally:
        if writer is not None:
            writer.close()


def _read_sas7bdat(path: Path) -> pl.DataFrame:
    """Read one .sas7bdat file via a temporary Parquet cache and return a Polars DataFrame.

    The sas7bdat is converted to a temporary Parquet file, read through DuckDB,
    and the temporary file is deleted when the read is done.
    """
    if not path.exists():
        raise FileNotFoundError(f"Missing required input file: {path}")

    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp:
        tmp_parquet = Path(tmp) / f"{path.stem}.parquet"
        sas_to_parquet(path, tmp_parquet)

        con = duckdb.connect()
        try:
            df = con.execute(
                f"SELECT * FROM read_parquet('{tmp_parquet.as_posix()}')"
            ).pl()
        finally:
            con.close()
    # temp folder and Parquet file are removed here

    return df.rename({col: str(col).upper().strip() for col in df.columns})




