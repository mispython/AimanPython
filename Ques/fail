def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM for the given SOURCE_SYSTEM_CD from the control file."""
    ctl = pd.read_sas(str(CTL_BATCH_DTTM), encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {CTL_BATCH_DTTM}")
    return pd.Timestamp(hit.iloc[0]).date()


# ============================================================================
# HELPER: SFTP INFO FROM CONTROL FILE + UPLOAD
# ============================================================================
def get_sftp_info(host_desc: str) -> dict:
    """Read SFTP_ID / SFTP_PW / HOST_IP for the given HOST_DESC from the control file."""
    ctl = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    for col in ("SFTP_ID", "SFTP_PW", "HOST_IP", "HOST_DESC"):
        ctl[col] = ctl[col].fillna("").astype(str).str.strip()
    hit = ctl.loc[ctl["HOST_DESC"] == host_desc]
    if hit.empty:
        raise ValueError(f"HOST_DESC '{host_desc}' not found in {CTL_SFTP_INFO}")
    row = hit.iloc[0]
    return {"user": row["SFTP_ID"], "password": row["SFTP_PW"], "host": row["HOST_IP"]}


def sftp_put(host_desc: str, remote_dir: str, local_path: Path,
             remote_name: str, port: int = 22) -> None:
    """Upload local_path to remote_dir/remote_name on the host identified by host_desc."""
    info = get_sftp_info(host_desc)
    transport = paramiko.Transport((info["host"], port))
    try:
        transport.connect(username=info["user"], password=info["password"])
        sftp = paramiko.SFTPClient.from_transport(transport)
        try:
            sftp.chdir(remote_dir)
            sftp.put(str(local_path), remote_name)
        finally:
            sftp.close()
    finally:
        transport.close()


# ============================================================================
# HELPER: STREAM .sas7bdat -> TEMPORARY PARQUET (schema locked on first chunk)
# ============================================================================
def sas_to_parquet(src: Path, dst: Path, chunk_rows: int = CHUNK_ROWS) -> None:
    """Chunked .sas7bdat -> Parquet. Schema is locked on the first chunk."""
    writer, schema = None, None
    try:
        for chunk in pd.read_sas(str(src), encoding="latin1", chunksize=chunk_rows):
            # Force text columns to string so an all-null first chunk doesn't lock a null type
            for col in chunk.columns[chunk.dtypes == object]:
                chunk[col] = chunk[col].astype("string")
            table = pa.Table.from_pandas(chunk, preserve_index=False)
            if writer is None:
                schema = table.schema
                writer = pq.ParquetWriter(str(dst), schema, compression="snappy")
            else:
                table = table.cast(schema)
            writer.write_table(table)
        if writer is None:
            # Source has no rows: still write the schema so read_parquet works
            empty = pd.read_sas(str(src), encoding="latin1")
            for col in empty.columns[empty.dtypes == object]:
                empty[col] = empty[col].astype("string")
            table = pa.Table.from_pandas(empty, preserve_index=False)
            writer = pq.ParquetWriter(str(dst), table.schema, compression="snappy")
            writer.write_table(table)
    finally:
        if writer is not None:
            writer.close()


def convert_input(sas_path: Path, tag: str) -> Path:
    """Convert one .sas7bdat input to a temporary parquet file and return its path."""
    if not sas_path.exists():
        raise FileNotFoundError(f"[{tag}] input not found: {sas_path}")
    dst = TMP_DIR / f"{tag}.parquet"
    print(f"  [{tag}] Converting {sas_path.name} -> temporary parquet ...")
    sas_to_parquet(sas_path, dst)
    return dst




