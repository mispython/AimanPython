# ============================================================================
# STEP 12: GENERATE OUTPUT FILE (fixed‑width, spaces, no tabs)
# ============================================================================
print("\nStep 12: Generating output file...")

report_df = sdfall.filter(pl.col("REPTDATE") <= reptdate)
rows = report_df.to_dicts()

# SAS format widths (from the original PUT statement)
WIDTHS = {
    "date": 11,              # DDMMYY10. + leading space
    "branch": 12,            # BEST12.
    "acctno": 12,            # BEST12.
    "custname": 40,          # $40.
    "product": 12,           # BEST12.
    "opening": 16,           # COMMA16.2
    "txncode": 12,           # BEST12.
    "desc": 40,              # $40.
    "debit": 16,             # COMMA16.2
    "credit": 16,            # COMMA16.2
    "balance": 16,           # COMMA16.2
}

# Helper functions to format each field
def fmt_date(d):
    return (" " + d.strftime("%d/%m/%Y")).rjust(WIDTHS["date"])

def fmt_num12(v):
    if v is None or pd.isna(v):
        return " " * WIDTHS["branch"]
    return f"{int(round(float(v)))}".rjust(WIDTHS["branch"])

def fmt_text(v, width):
    if v is None or pd.isna(v):
        return " " * width
    return f"{str(v).strip()[:width]:<{width}s}"

def fmt_comma(v, width):
    if v is None or pd.isna(v):
        return " " * width
    return f"{float(v):,.2f}".rjust(width)

# Build the rows (as formatted strings)
header = [
    "Date".rjust(WIDTHS["date"]),
    "Branch".rjust(WIDTHS["branch"]),
    "SDF Account Number".rjust(WIDTHS["acctno"]),
    "Customer Name".ljust(WIDTHS["custname"]),
    "Product".rjust(WIDTHS["product"]),
    "Opening Balance".rjust(WIDTHS["opening"]),
    "Transaction Code".rjust(WIDTHS["txncode"]),
    "Description".ljust(WIDTHS["desc"]),
    "Debit".rjust(WIDTHS["debit"]),
    "Credit".rjust(WIDTHS["credit"]),
    "Outstanding Balance".rjust(WIDTHS["balance"]),
]

data_lines = []
for row in rows:
    line = [
        fmt_date(row["REPTDATE"]),
        fmt_num12(row["BRANCH"]),
        fmt_num12(row["ACCTNO"]),
        fmt_text(row["CUSTNAME"], WIDTHS["custname"]),
        fmt_num12(row["PRODUCT"]),
        fmt_comma(row["PCURBAL"], WIDTHS["opening"]),
        fmt_num12(row["TRANCODE"]),
        fmt_text(row["TRANDESC"], WIDTHS["desc"]),
        fmt_comma(row["DEBIT"], WIDTHS["debit"]),
        fmt_comma(row["CREDIT"], WIDTHS["credit"]),
        fmt_comma(row["CURBAL"], WIDTHS["balance"]),
    ]
    data_lines.append("".join(line))   # join with no separator (spaces are inside each field)

# Title and blank line
output_lines = []
output_lines.append(f"Special Deposit Facility (SDF) RM Account as at {RDATE}")
output_lines.append("")
output_lines.append("".join(header))
output_lines.extend(data_lines)

# Write to file
with open(OUTPUT_FILE, "w", encoding="utf-8") as fh:
    fh.write("\n".join(output_lines) + "\n")

print(f"\n  Output written : {OUTPUT_FILE}")
print(f"  Total rows    : {len(data_lines)}")
print("\n  --- Output preview ---")
for ln in output_lines[:20]:
    print(ln)
if len(output_lines) > 20:
    print(f"  ... ({len(output_lines) - 20} more lines)")
