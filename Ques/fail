def _sas_to_parquet(
    sas_path: Path,
    cache_path: Path,
    tag: str,
    encoding: str = "latin1",   # <-- ADD THIS
    chunk_size: int = CHUNK_ROWS
) -> None:
    print(f"  [{tag}] Converting {sas_path.name} -> {cache_path.name} ...")

    # ------------------------------------------------------------
    # 1. PEEK at the file to check if it is EMPTY (0 rows)
    #    and to capture the column metadata.
    # ------------------------------------------------------------
    empty_preview = pd.read_sas(sas_path, encoding=encoding, nrows=0)  # <-- USE encoding
    
    # Build PyArrow schema from the column metadata (even if rows = 0)
    fields = []
    for col, dtype in empty_preview.dtypes.items():
        if dtype == 'object':
            pa_type = pa.string()
        elif pd.api.types.is_integer_dtype(dtype):
            pa_type = pa.int64()
        elif pd.api.types.is_float_dtype(dtype):
            pa_type = pa.float64()
        else:
            pa_type = pa.from_numpy_dtype(dtype)
        fields.append(pa.field(col, pa_type))
    schema = pa.schema(fields)

    # ------------------------------------------------------------
    # 2. If the file has ZERO rows, write an empty Parquet file
    #    and exit immediately.
    # ------------------------------------------------------------
    if empty_preview.empty:
        empty_table = pa.Table.from_pandas(empty_preview, schema=schema, preserve_index=False)
        pq.write_table(empty_table, cache_path)
        print(f"  [{tag}] Done - 0 rows cached (empty file).")
        return

    # ------------------------------------------------------------
    # 3. NORMAL case: File has rows -> stream in chunks
    # ------------------------------------------------------------
    writer = None
    total = 0

    reader = pd.read_sas(sas_path, encoding=encoding, chunksize=chunk_size)  # <-- USE encoding & chunk_size
    for chunk in reader:
        if writer is None:
            writer = pq.ParquetWriter(cache_path, schema, compression="snappy")

        table = pa.Table.from_pandas(chunk, schema=schema, preserve_index=False, safe=False)
        writer.write_table(table)
        total += len(chunk)
        del chunk, table
        gc.collect()

    if writer:
        writer.close()

    print(f"  [{tag}] Done - {total:,} rows cached.")
