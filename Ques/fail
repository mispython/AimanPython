def _query_sas(sources: dict, sql: str, **params) -> pl.DataFrame:
    """
    Convert each .sas7bdat in `sources` ({tag: Path}) to a TEMPORARY Parquet
    file, run `sql` on it through DuckDB, then delete the temp files.
    `sql` refers to each converted file as {tag} inside read_parquet('{tag}');
    extra keyword params are substituted into `sql` as well.
    Nothing is kept on disk after the call returns.
    """
    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp:
        paths = {}
        for tag, sas_path in sources.items():
            pq_path = Path(tmp) / f"{tag}.parquet"
            _sas_to_parquet(sas_path, pq_path, tag)
            paths[tag] = pq_path.as_posix()
        con = duckdb.connect(database=":memory:")
        try:
            return con.execute(sql.format(**paths, **params)).pl()
        finally:
            con.close()




