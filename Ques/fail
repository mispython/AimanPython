def read_sas_dataset(file_path: Path) -> pl.DataFrame:
    """Read a .sas7bdat dataset into Polars (blank character values -> null)."""
    df = pl.from_pandas(pd.read_sas(file_path, format="sas7bdat", encoding="latin1"))
    currcode = pl.col("CURRCODE").cast(pl.Utf8).str.strip_chars()
    return df.with_columns(
        pl.when(currcode == "")
        .then(None)
        .otherwise(currcode)
        .alias("CURRCODE")
    )
