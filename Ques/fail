def sftp_upload_text_files(local_files: list) -> None:
    """
    Upload the flat TEXT files to the eCCRIS server (ctl_dwh_sftp_info row
    ECCRIS_HOST_DESC).

    Equivalent of ask.py:
        PUT 'SAP.BANK.ODLIST.TEXT'  ODLIST
        PUT 'SAP.PIBB.ODLIST.TEXT'  IODLIST
    No remote CD in the original, so files land in the login directory.

    Parameters:
        local_files: list of (local_path: Path, remote_filename: str)
    """
    sftp_id, sftp_pw, host_ip, host_key = get_sftp_info(ECCRIS_HOST_DESC)

    ssh = paramiko.SSHClient()
    # NOTE: HOST_KEY from ctl_dwh_sftp_info is blank for this host, so strict
    # host-key pinning is not possible; AutoAddPolicy is used.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to {ECCRIS_HOST_DESC} {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    sftp = ssh.open_sftp()

    try:
        for local_path, remote_name in local_files:
            print(f"  SFTP upload: {local_path.name} -> {remote_name}")
            sftp.put(str(local_path), remote_name)
    finally:
        sftp.close()
        ssh.close()
    print("  eCCRIS upload complete.")


