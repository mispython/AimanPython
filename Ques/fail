def _load_cached(sas_path: Path, tag: str) -> Path:
    # CACHE_DIR is a temp folder (removed at the end of the run). A file read twice
    # (e.g. PBB and PIBB from the same source) is converted only once per run.
    cache_path = CACHE_DIR / f"{sas_path.parent.name}_{sas_path.stem}.parquet"
    if cache_path.exists():
        print(f"  [{tag}] Already converted in this run - reusing.")
    else:
        _sas_to_parquet(sas_path, cache_path, tag)
    return cache_path




