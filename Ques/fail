def _safe_write_parquet(rows, path: Path, schema: dict | None = None):
    """Write a list of dicts to parquet; tolerate an empty list by falling
    back to an explicit schema."""
    if rows:
        pl.DataFrame(rows).write_parquet(path)
    else:
        if schema is None:
            # no columns at all: create an empty, schema-less-but-valid parquet
            pl.DataFrame({"_empty": pl.Series([], dtype=pl.Boolean)}).write_parquet(path)
        else:
            pl.DataFrame({k: pl.Series([], dtype=v) for k, v in schema.items()}).write_parquet(path)




def _sas_put_num(v, fmt_width: int = 12) -> str:
    """Approximate SAS PUT var (BEST12.) then rewind 1 column."""
    s = f"{v:>{fmt_width}}"          # right-justify inside fmt_width
    return s[:-1]                    # the +(-1) overwrites the trailing col




