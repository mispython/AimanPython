def fmt_comma15_2(val):
    """COMMA15.2 right-justified in 15 chars; missing prints '.' (SAS default)"""
    if val is None or is_nan_float(val):
        return '.'.rjust(15)
    return f"{val:,.2f}".rjust(15)

def fmt_comma5_2(val):
    """COMMA5.2 right-justified in 5 chars; missing prints '.' (SAS default)"""
    if val is None or is_nan_float(val):
        return '.'.rjust(5)
    return f"{val:,.2f}".rjust(5)


def _code_text(value) -> str:
    """Default (unformatted) PUT of a code field: text as-is; an integer-valued
    number prints without a trailing '.0' (1.0 -> '1'); missing prints blank."""
    if value is None or is_nan_float(value):
        return ''
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value)


