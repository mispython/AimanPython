def _render_chunk_pages(branches, group, cross, header_text, is_last_chunk) -> list:
    """Renders all pages for one column-chunk. Prints '(Continued)' after
    every page except the very last page of the very last chunk."""
    lines = []
    n_branches = len(branches)
    idx = 0
    while True:
        page_branches = branches[idx: idx + TEMP_DATA_ROWS_PER_PAGE]
        lines.extend([""] * TEMP_TOP_MARGIN)
        lines.append(header_text)
        lines.append("")
        for b in page_branches:
            row = b.ljust(TEMP_LABEL_WIDTH)
            for rr in group:
                n, s = cross.get((b, rr), (0, None))
                row += TEMP_SEP + _n_format(n) + TEMP_SEP + _best_format(s)
            lines.append(row)

        idx += TEMP_DATA_ROWS_PER_PAGE
        more_branches_remain = idx < n_branches
        is_last_page_overall = is_last_chunk and not more_branches_remain

        if not is_last_page_overall:
            lines.extend([""] * TEMP_BOTTOM_BLANK)
            lines.append("(Continued)")

        if not more_branches_remain:
            break

    return lines


def _write_temp_output(loan4_padded: list, out_path: Path) -> None:
    riskrates = list(range(0, 15))
    branches = sorted({r["BRANCH"] for r in loan4_padded})

    def _crosstab(field: str) -> dict:
        agg = {}
        for r in loan4_padded:
            val = r[field]
            key = (r["BRANCH"], r["RISKRATE"])
            n, s = agg.get(key, (0, None))
            if val is not None:
                n += 1
                s = (s or 0.0) + val
            agg[key] = (n, s)
        return agg

    group_width = len(TEMP_SEP) + TEMP_N_WIDTH + len(TEMP_SEP) + TEMP_SUM_WIDTH
    max_groups = max(1, (LINESIZE_TEMP - TEMP_LABEL_WIDTH) // group_width)
    chunks = [riskrates[i:i + max_groups] for i in range(0, len(riskrates), max_groups)]

    all_lines = []
    for field in ("BALANCE", "RISKBAL"):
        cross = _crosstab(field)
        for chunk_idx, group in enumerate(chunks):
            header = " " * TEMP_LABEL_WIDTH
            for rr in group:
                header += TEMP_SEP + " " * TEMP_N_WIDTH + TEMP_SEP + str(rr).rjust(TEMP_SUM_WIDTH)
            is_last_chunk = chunk_idx == len(chunks) - 1
            all_lines.extend(_render_chunk_pages(branches, group, cross, header, is_last_chunk))

    with open(out_path, "w", encoding="latin1") as fh:
        for ln in all_lines:
            fh.write(ln + "\n")




TBLS_CHUNK_BOUNDARIES = [6, 13, 15]   # RISKRATE cols: [0:6), [6:13), [13:15)

def _tbls_chunks(riskrates: list) -> list:
    chunks = []
    start = 0
    for end in TBLS_CHUNK_BOUNDARIES:
        chunks.append(riskrates[start:end])
        start = end
    return chunks
