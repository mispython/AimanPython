
import pyreadstat
import pandas as pd

original_file = r"C:\path\original.sas7bdat"
modified_file = r"C:\path\modified.sas7bdat"

CHUNK_SIZE = 50_000

original_reader = pyreadstat.read_file_in_chunks(
    pyreadstat.read_sas7bdat,
    original_file,
    chunksize=CHUNK_SIZE,
)

modified_reader = pyreadstat.read_file_in_chunks(
    pyreadstat.read_sas7bdat,
    modified_file,
    chunksize=CHUNK_SIZE,
)

total_rows = 0
different_rows = 0
different_cells = 0

for chunk_no, ((original_df, _), (modified_df, _)) in enumerate(
    zip(original_reader, modified_reader), start=1
):
    # Verify row positions and row counts
    if len(original_df) != len(modified_df):
        raise ValueError(
            f"Chunk {chunk_no}: row count differs: "
            f"{len(original_df)} vs {len(modified_df)}"
        )

    # Original columns must still exist in the modified dataset
    missing = [
        col for col in original_df.columns
        if col not in modified_df.columns
    ]
    if missing:
        raise ValueError(f"Missing original columns: {missing}")

    # Compare only original columns, in original column order
    modified_original = modified_df[original_df.columns]

    # Compare values, treating missing values as equal
    equal = (
        original_df.reset_index(drop=True)
        .eq(modified_original.reset_index(drop=True))
        | (
            original_df.reset_index(drop=True).isna()
            & modified_original.reset_index(drop=True).isna()
        )
    )

    changed = ~equal

    rows_changed = int(changed.any(axis=1).sum())
    cells_changed = int(changed.sum().sum())

    different_rows += rows_changed
    different_cells += cells_changed
    total_rows += len(original_df)

    if cells_changed:
        print(f"\nChunk {chunk_no}: {cells_changed} changed cells")
        print(changed.stack()[lambda x: x].head(10))

print("\n=== COMPARISON RESULT ===")
print(f"Rows checked: {total_rows:,}")
print(f"Rows with differences: {different_rows:,}")
print(f"Changed cells: {different_cells:,}")

if different_cells == 0:
    print("PASS: All original column values are unchanged.")
else:
    print("FAIL: Differences found in original columns.")
