def _comma(value, width: int, decimals: int = 2) -> str:
    """COMMAw.d style: comma-separated, right-justified, sign if negative.
    A missing value prints as '.' right-justified (SAS default)."""
    if value is None:
        return ".".rjust(width)
    try:
        v = float(value)
    except (TypeError, ValueError):
        return ".".rjust(width)
    if v != v:  # NaN
        return ".".rjust(width)
    return f"{v:,.{decimals}f}".rjust(width)


def _num(value, width: int) -> str:
    """Plain numeric PUT (e.g. 3., 10., 12.) - right-justified, no commas.
    A missing value prints as '.' right-justified (SAS default)."""
    if value is None:
        return ".".rjust(width)
    try:
        return f"{int(value)}".rjust(width)
    except (TypeError, ValueError):
        return ".".rjust(width)




def _code_columns_sql(con, parquet_path: Path, columns: list) -> str:
    """Build SELECT expressions that return code columns as clean text.

    Character columns pass through unchanged. If a column is stored as a number,
    integer-valued numbers are rendered without a trailing '.0' (1.0 -> '1').
    Missing values stay NULL (printed as blanks by _char).
    """
    described = con.execute(
        f"DESCRIBE SELECT {', '.join(columns)} FROM read_parquet('{parquet_path.as_posix()}')"
    ).fetchall()
    col_types = {row[0]: str(row[1]).upper() for row in described}

    exprs = []
    for col in columns:
        if col_types[col] == "VARCHAR":
            exprs.append(f"CAST({col} AS VARCHAR) AS {col}")
        else:
            exprs.append(
                f"CASE WHEN {col} IS NULL THEN NULL "
                f"WHEN CAST({col} AS DOUBLE) = FLOOR(CAST({col} AS DOUBLE)) "
                f"THEN CAST(CAST({col} AS BIGINT) AS VARCHAR) "
                f"ELSE CAST({col} AS VARCHAR) END AS {col}"
            )
    return ",\n                ".join(exprs)




def generate_od_listing_report(
    cfg: BankConfig,
    loan_parquet: Path,
    deposit_parquet: Path,
) -> bool:
    """
    Generate the OD listing RPS report (by FISS purpose, then by sector) and
    the accompanying fixed-width ODLD text file for one bank.

    Returns:
        True if the report was generated successfully, False otherwise.
    """
    print(f"\n{'=' * 70}")
    print(f"Generating {'Islamic Bank' if cfg.bank_code == 'PIBB' else 'Public Bank'} OD Listing Report")
    print(f"{'=' * 70}")
    print(f"\nReport Date: {REPORT_DATE}")

    # A fresh in-memory DuckDB connection is created for every report run
    # so that registered views from a previous run cannot bleed through.
    con = duckdb.connect(database=":memory:")

    try:
        # PBB = ENTITY_CD != 'PIBB', PIBB = ENTITY_CD = 'PIBB'
        # (null ENTITY_CD is treated as blank, so it stays with PBB)
        entity_cond = f"TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) {cfg.entity_op} 'PIBB'"
        col_sql = _code_columns_sql(con, deposit_parquet, ["COL1", "COL2", "COL3", "COL4", "COL5"])

        print("\nStep 1: Building ODRAFT (deposit accounts with negative balance)...")
        # DATA ODRAFT; SET DEPOSIT.CURRENT; IF CURBAL<0 AND CUSTCODE NE 81;
        # BALANCE = (-1)*CURBAL;
        # SAS treats a missing CURBAL as smaller than any number, so CURBAL<0 is TRUE
        # for missing: those rows are kept and BALANCE stays missing.
        odraft = con.execute(f"""
            SELECT
                CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                CAST(BRANCH   AS INTEGER) AS BRANCH,
                CAST(CUSTCODE AS INTEGER) AS CUSTCODE,
                CAST(APPRLIMT AS DOUBLE)  AS APPRLIMT,
                COALESCE(CAST(NAME AS VARCHAR), '') AS NAME,
                CAST(LIMIT1   AS DOUBLE)  AS LIMIT1,
                CAST(LIMIT2   AS DOUBLE)  AS LIMIT2,
                CAST(LIMIT3   AS DOUBLE)  AS LIMIT3,
                CAST(LIMIT4   AS DOUBLE)  AS LIMIT4,
                CAST(LIMIT5   AS DOUBLE)  AS LIMIT5,
                CAST(RATE1    AS DOUBLE)  AS RATE1,
                CAST(RATE2    AS DOUBLE)  AS RATE2,
                CAST(RATE3    AS DOUBLE)  AS RATE3,
                CAST(RATE4    AS DOUBLE)  AS RATE4,
                CAST(RATE5    AS DOUBLE)  AS RATE5,
                {col_sql},
                CAST(STATE    AS VARCHAR) AS STATE,
                CAST(FLATRATE AS DOUBLE)  AS FLATRATE,
                (-1) * CAST(CURBAL AS DOUBLE) AS BALANCE
            FROM read_parquet('{deposit_parquet.as_posix()}')
            WHERE {entity_cond}
              AND (CAST(CURBAL AS DOUBLE) IS NULL OR CAST(CURBAL AS DOUBLE) < 0)
              AND COALESCE(CAST(CUSTCODE AS INTEGER), -1) <> 81
        """).pl()
        print(f"ODRAFT records: {len(odraft):,}")

        print("\nStep 2: Loading LOAN (ACCTNO, SECTORCD, FISSPURP)...")
        # PROC SORT DATA=LOAN.LOAN&REPTMON&NOWK OUT=LOAN(KEEP=ACCTNO SECTORCD FISSPURP);
        # BY ACCTNO; -- sort is only needed here to prepare the merge key; the
        # explicit join below achieves the same match-merge result, so the
        # physical sort is not reproduced.
        loan = con.execute(f"""
            SELECT
                CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                CAST(SECTORCD AS VARCHAR) AS SECTORCD,
                CAST(FISSPURP AS VARCHAR) AS FISSPURP
            FROM read_parquet('{loan_parquet.as_posix()}')
            WHERE {entity_cond}
        """).pl()
        print(f"LOAN records: {len(loan):,}")

        print("\nStep 3: Merging ODRAFT with LOAN (inner match-merge)...")
        # DATA ODRAFT1; MERGE ODRAFT(IN=A) LOAN(IN=B); BY ACCTNO; IF A AND B;
        odraft1 = odraft.join(loan, on="ACCTNO", how="inner")
        print(f"ODRAFT1 records: {len(odraft1):,}")

        print("\nStep 4: Filtering ODRAFT2 (construction/real estate sectors)...")
        # DATA ODRAFT2; SET ODRAFT1;
        # IF CUSTCD NOT IN ('77','78','95','96') AND
        #   (SUBSTR(SECTORCD,1,1)='5' OR SECTORCD='8310') THEN OUTPUT;
        #
        # The customer code on the deposit dataset is named CUSTCODE (the SAS name
        # CUSTCD is the same field), so the exclusion is applied on CUSTCODE.
        # A missing CUSTCODE is never IN the list, so it is not excluded (as in SAS).
        odraft2 = odraft1.filter(
            ~pl.col("CUSTCODE").fill_null(-1).is_in([77, 78, 95, 96])
            & (
                (pl.col("SECTORCD").str.slice(0, 1) == "5")
                | (pl.col("SECTORCD") == "8310")
            )
        )
        print(f"ODRAFT2 records: {len(odraft2):,}")

        print("\nStep 5: Sorting BY-group keys...")
        # PROC SORT DATA=ODRAFT1; BY BRANCH FISSPURP ACCTNO;
        odraft1_sorted = odraft1.sort(["BRANCH", "FISSPURP", "ACCTNO"])
        # PROC SORT DATA=ODRAFT2; BY BRANCH SECTORCD ACCTNO;
        odraft2_sorted = odraft2.sort(["BRANCH", "SECTORCD", "ACCTNO"])

        del odraft, loan, odraft1, odraft2
        gc.collect()

        print("\nStep 6: Writing ODLD text file (dated) and flat TEXT file...")
        # DATA ODLD; SET ODRAFT1; FILE ODLSD; PUT ...
        with open(cfg.text_output, "w", encoding="latin1") as fh:
            for row in odraft1_sorted.iter_rows(named=True):
                _write_odld_line(fh, row)
        print(f"Text file saved: {cfg.text_output}")

        # Flat TEXT file (no date, no extension) = SAP.xxxx.ODLIST.TEXT sent as ODLIST / IODLIST
        shutil.copyfile(cfg.text_output, cfg.text_flat_output)
        print(f"Flat text file saved: {cfg.text_flat_output}")

        print("\nStep 7: Writing RPS report file...")
        # DATA _NULL_; SET ODRAFT1; BY BRANCH FISSPURP ACCTNO; FILE ODLST; ...
        # DATA _NULL_; SET ODRAFT2; BY BRANCH SECTORCD ACCTNO; FILE ODLST MOD; ...
        with open(cfg.rps_output, "w", encoding="latin1") as fh:
            _process_group_report(
                fh, odraft1_sorted.to_dicts(), "FISSPURP", "FISS PURPOSE",
                _header_lines_fisspurp, cfg.bank_title,
            )
            _process_group_report(
                fh, odraft2_sorted.to_dicts(), "SECTORCD", "SECTOR",
                _header_lines_sector, cfg.bank_title,
            )
        print(f"RPS report saved: {cfg.rps_output}")

        print("\nReport Statistics:")
        print(f"  ODRAFT1 rows (all FISS purpose)                  : {len(odraft1_sorted):,}")
        print(f"  ODRAFT2 rows (construction/real estate, non-indi): {len(odraft2_sorted):,}")

        # print(f"\n========== PREVIEW: {cfg.rps_output.name} ==========\n")
        # with open(cfg.rps_output, "r", encoding="latin1") as f:
        #     print(f.read())
        # print("========== END PREVIEW ==========\n")

        return True

    except Exception as e:
        print(f"\n[ERROR] Report generation failed for {cfg.bank_code}: {type(e).__name__}: {e}")
        return False

    finally:
        con.close()




def _sas_match_merge(left: pl.DataFrame, right: pl.DataFrame, key: str) -> pl.DataFrame:
    """MERGE left(IN=A) right(IN=B); BY key; IF A AND B;  (SAS match-merge semantics)

    One-to-many behaves like a normal inner join. When both sides have duplicate keys,
    SAS pairs rows in order, giving max(m, k) rows per key, and the shorter side keeps
    its last row; a plain join would give m * k rows.
    """
    left  = left.with_columns(pl.int_range(pl.len()).over(key).alias("_SEQ"))
    right = right.with_columns(pl.int_range(pl.len()).over(key).alias("_SEQ"))

    sizes = (
        left.group_by(key).agg(pl.len().cast(pl.Int64).alias("_NL"))
        .join(
            right.group_by(key).agg(pl.len().cast(pl.Int64).alias("_NR")),
            on=key, how="inner",
        )
        .with_columns(pl.max_horizontal("_NL", "_NR").alias("_N"))
    )
    pairs = (
        sizes.with_columns(pl.int_ranges(0, pl.col("_N")).alias("_SEQ"))
        .explode("_SEQ")
        .with_columns(
            pl.min_horizontal(pl.col("_SEQ"), pl.col("_NL") - 1).alias("_LSEQ"),
            pl.min_horizontal(pl.col("_SEQ"), pl.col("_NR") - 1).alias("_RSEQ"),
        )
        .select(key, "_LSEQ", "_RSEQ")
    )
    return (
        pairs
        .join(left.rename({"_SEQ": "_LSEQ"}), on=[key, "_LSEQ"], how="left")
        .join(right.rename({"_SEQ": "_RSEQ"}), on=[key, "_RSEQ"], how="left")
        .drop("_LSEQ", "_RSEQ")
    )




