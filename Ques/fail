def _write_report_file(
    brnref: pd.DataFrame,
    output_file: Path,
    is_islamic: bool,
    report_date: str,
) -> None:
    title1, title2, od_label = _get_report_titles(is_islamic)
    output_file.parent.mkdir(parents=True, exist_ok=True)

    with open(output_file, 'w', encoding='utf-8') as report_file:
        add_form_feed = False

        for brn_code, branch_rows in brnref.groupby('BRN', sort=False):

            primary_header_lines   = _build_primary_header_lines(od_label)
            secondary_header_lines = _build_secondary_header_lines()

            rows       = list(branch_rows.iterrows())
            row_idx    = 0
            total_rows = len(rows)

            subtotal_args = (
                float(branch_rows['APPRLIMT'].sum()),
                int(len(branch_rows)),
                float(branch_rows['LIMITS'].sum()),
            )

            # ── PHASE 1: ALL PRIMARY TABLE PAGES ─────────────────────────────
            # Secondary lines are collected so all primary pages are written
            # before any secondary page, giving the correct page order:
            #   primary p1, primary p2 ... secondary p1, secondary p2 ...
            secondary_chunks        = []
            last_primary_lines_used = 0

            while row_idx < total_rows:
                title_lines = _build_title_lines(
                    title1, title2, report_date, brn_code
                )

                fixed_primary   = len(title_lines) + len(primary_header_lines)
                fixed_secondary = len(title_lines) + len(secondary_header_lines)
                fixed_lines     = max(fixed_primary, fixed_secondary)

                max_data_rows = PAGE_SIZE - fixed_lines

                if max_data_rows <= 0:
                    raise ValueError(
                        f"PAGE_SIZE={PAGE_SIZE} too small for report title/header blocks."
                    )

                rows_this_chunk = min(total_rows - row_idx, max_data_rows)
                chunk           = rows[row_idx: row_idx + rows_this_chunk]

                primary_data_lines = [
                    _build_detail_line(row, show_brn=(idx == 0))
                    for idx, (_, row) in enumerate(chunk)
                ]
                secondary_data_lines = [
                    _build_secondary_line(row)
                    for _, row in chunk
                ]

                add_form_feed = _write_page(
                    report_file,
                    title_lines,
                    primary_header_lines,
                    primary_data_lines,
                    add_form_feed,
                )

                secondary_chunks.append((title_lines, secondary_data_lines))

                # Track how many lines the last primary page consumed
                last_primary_lines_used = fixed_primary + rows_this_chunk

                row_idx += rows_this_chunk

            # ── PHASE 2: ALL SECONDARY TABLE PAGES ───────────────────────────
            last_secondary_lines_used = 0

            for sec_title_lines, sec_data_lines in secondary_chunks:
                add_form_feed = _write_page(
                    report_file,
                    sec_title_lines,
                    secondary_header_lines,
                    sec_data_lines,
                    add_form_feed,
                )
                last_secondary_lines_used = (
                    len(sec_title_lines) + len(secondary_header_lines) + len(sec_data_lines)
                )

            # ── PHASE 3: SUBTOTAL UNDER PRIMARY HEADER ───────────────────────
            # If the subtotal block fits on the last primary data page, write it
            # there (inline). Otherwise open a dedicated page with title + primary
            # header only, then write the subtotal beneath it.
            title_lines = _build_title_lines(title1, title2, report_date, brn_code)

            if (PAGE_SIZE - last_primary_lines_used) >= SUBTOTAL_LINES:
                # Fits inline on the last primary page — no new page needed.
                # The page was already written; just append the subtotal to the
                # file stream (it follows immediately after the last data row).
                _write_branch_subtotal(report_file, *subtotal_args)
            else:
                add_form_feed = _write_page(
                    report_file, title_lines, primary_header_lines, [], add_form_feed
                )
                _write_branch_subtotal(report_file, *subtotal_args)

            # ── PHASE 4: SUBTOTAL UNDER SECONDARY HEADER ─────────────────────
            # Same inline-or-new-page decision, driven by the last secondary page.
            title_lines = _build_title_lines(title1, title2, report_date, brn_code)

            if (PAGE_SIZE - last_secondary_lines_used) >= SUBTOTAL_LINES:
                _write_branch_subtotal(report_file, *subtotal_args)
            else:
                add_form_feed = _write_page(
                    report_file, title_lines, secondary_header_lines, [], add_form_feed
                )
                _write_branch_subtotal(report_file, *subtotal_args)
