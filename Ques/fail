def _fmt_int(value, width: int) -> str:
    """Numeric PUT with a w. format (e.g. 3., 10., 12.): right-justified.
    A missing value prints as '.' right-justified (SAS default)."""
    if value is None or is_nan_float(value):
        return '.'.rjust(width)
    return str(int(value)).rjust(width)[:width]


def write_lnlisd(lnnote1: pl.DataFrame, output_path: Path, is_pbb: bool):
