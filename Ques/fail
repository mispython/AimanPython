PAGE_SIZE = 60
HEADER_LINES = 6

LINES_DETAIL = 1
LINES_SUBGROUP = 3
LINES_GROUP = 3
LINES_BRANCH = 3


def ensure_space(f, linecnt, needed_lines, branch_no, pagecnt, rdate):
    if linecnt + needed_lines > PAGE_SIZE:
        pagecnt += 1
        write_print2_header(f, branch_no, pagecnt, rdate)
        return HEADER_LINES, pagecnt
    return linecnt, pagecnt


def write_print2_header(f, branch_no, pagecnt, rdate):
    f.write(f"1{branch_no:03d}{'':41}P U B L I C   B A N K   B E R H A D{'':36}PAGE NO : {pagecnt}\n")
    f.write(f" {'':44}TELLER TRANSACTIONS BY BRANCH AS AT {rdate}\n")
    f.write(f"0{'':30}<--------------------------AMOUNT----------------------->"
            f"<----------------ITEM COUNT----------------->\n")
    f.write(f" BRH CODE DESCRIPTION         TRAN AMOUNT      CASH IN      CASH OUT      CHEQUE"
            f"   5K   10K   50K  100K  200K  >200K TOTAL\n")
    f.write(f" {'-'*132}\n")


def write_subgroup_total(f, sgroup_num, samt, scshin, scshout, scheq,
                          sitema, sitemb, sitemc, sitemd, siteme, sitemf):
    stlitem = sitema + sitemb + sitemc + sitemd + siteme + sitemf
    f.write(f" {'':30}{'-'*102}\n")
    f.write(
        f" {'':7}TOTAL SUBGROUP {sgroup_num:<4.1f}"
        f"{fit_amount(samt,15)} {fit_amount(scshin,13)} {fit_amount(scshout,13)} {fit_amount(scheq,12)} "
        f"{str(int(sitema)).rjust(5)} {str(int(sitemb)).rjust(6)} {str(int(sitemc)).rjust(6)} "
        f"{str(int(sitemd)).rjust(5)} {str(int(siteme)).rjust(5)} {str(int(sitemf)).rjust(5)} "
        f"{str(int(stlitem)).rjust(6)}\n"
    )
    f.write(f" {'':30}{'-'*102}\n")


def write_group_total(f, group_num, tamt, tcshin, tcshout, tcheq,
                       titema, titemb, titemc, titemd, titeme, titemf):
    ttlitem = titema + titemb + titemc + titemd + titeme + titemf
    f.write(f" {'':30}{'-'*102}\n")
    f.write(
        f" {'':11}TOTAL GROUP {group_num:<3}"
        f"{fit_amount(tamt,15)} {fit_amount(tcshin,13)} {fit_amount(tcshout,13)} {fit_amount(tcheq,12)} "
        f"{str(int(titema)).rjust(5)} {str(int(titemb)).rjust(6)} {str(int(titemc)).rjust(6)} "
        f"{str(int(titemd)).rjust(5)} {str(int(titeme)).rjust(5)} {str(int(titemf)).rjust(5)} "
        f"{str(int(ttlitem)).rjust(6)}\n"
    )
    f.write(f" {'':30}{'='*102}\n")


def write_branch_total(f, branch_no, gamt, gcshin, gcshout, gcheq,
                        gitema, gitemb, gitemc, gitemd, giteme, gitemf):
    gtlitem = gitema + gitemb + gitemc + gitemd + giteme + gitemf
    f.write(f" {'':30}{'-'*102}\n")
    f.write(
        f" {'':10}TOTAL BRANCH {branch_no:03d}"
        f"{fit_amount(gamt,15)} {fit_amount(gcshin,13)} {fit_amount(gcshout,13)} {fit_amount(gcheq,12)} "
        f"{str(int(gitema)).rjust(5)} {str(int(gitemb)).rjust(6)} {str(int(gitemc)).rjust(6)} "
        f"{str(int(gitemd)).rjust(5)} {str(int(giteme)).rjust(5)} {str(int(gitemf)).rjust(5)} "
        f"{str(int(gtlitem)).rjust(6)}\n"
    )
    f.write(f" {'':30}{'='*102}\n")


