def read_sabal(dyposxbr_cache: Path, reptdate_value: date) -> pl.DataFrame:
    con = duckdb.connect(database=":memory:")
    try:
        # SAS dates are stored as days since 1960-01-01
        # Convert the numeric REPTDATE to a proper date for comparison
        query = f"""
            SELECT BRANCH, TOTSAVG, TOTSAVGI, SACNT, ISACNT
            FROM read_parquet('{dyposxbr_cache.as_posix()}')
            WHERE DATE '1960-01-01' + INTERVAL (CAST(REPTDATE AS INTEGER)) DAY = DATE '{reptdate_value.isoformat()}'
            ORDER BY BRANCH
        """
        return con.execute(query).pl()
    finally:
        con.close()


def read_sabal(dyposxbr_cache: Path, reptdate_value: date) -> pl.DataFrame:
    con = duckdb.connect(database=":memory:")
    try:
        query = f"""
            SELECT BRANCH, TOTSAVG, TOTSAVGI, SACNT, ISACNT
            FROM read_parquet('{dyposxbr_cache.as_posix()}')
            WHERE CAST(REPTDATE AS INTEGER) = DATEDIFF('day', DATE '1960-01-01', DATE '{reptdate_value.isoformat()}')
            ORDER BY BRANCH
        """
        return con.execute(query).pl()
    finally:
        con.close()

