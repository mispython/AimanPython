def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM of the given source system from the control table."""
    ds = sas.sasdata(
        Path(CTL_BATCH_TABLE).stem,          # works with or without ".sas7bdat"
        CTL_LIBREF,
        dsopts={"where": f"SOURCE_SYSTEM_CD='{source_system_cd}'"},
    )
    df = ds.to_df()
    df.columns = [str(c).upper() for c in df.columns]

    if df.empty or pd.isna(df["BATCH_DTTM"].iloc[0]):
        raise ValueError(
            f"NO BATCH_DTTM FOUND FOR SOURCE_SYSTEM_CD='{source_system_cd}' "
            f"IN {CTL_BATCH_TABLE}"
        )

    value = df["BATCH_DTTM"].iloc[0]
    if pd.api.types.is_number(value):        # raw SAS datetime (seconds since 1960)
        return (datetime(1960, 1, 1) + timedelta(seconds=float(value))).date()
    return pd.Timestamp(value).date()
