import duckdb
from pathlib import Path

CACHE = Path("/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/input/cache/EIBDUNDP")
TARGET_ACCT   = 1595256021
TARGET_CURBAL = 11630.87

con = duckdb.connect()

for pq in sorted(CACHE.glob("*.parquet")):
    try:
        cols = con.execute(
            f"SELECT column_name FROM (DESCRIBE SELECT * FROM read_parquet('{pq.as_posix()}'))"
        ).fetchall()
        cols = [c[0] for c in cols]
    except Exception as e:
        print(f"{pq.name:50s}  SKIP ({e})")
        continue

    if "ACCTNO" not in cols:
        print(f"{pq.name:50s}  no ACCTNO column")
        continue

    q = f"""
        SELECT
            COUNT(*) FILTER (WHERE CAST(ACCTNO AS BIGINT) = {TARGET_ACCT})                AS exact_hits,
            COUNT(*) FILTER (WHERE CAST(ACCTNO AS BIGINT) BETWEEN 1595256000 AND 1595256100) AS near_hits,
            COUNT(*) FILTER (WHERE ABS(CAST(CURBAL AS DOUBLE) - {TARGET_CURBAL}) < 0.5)  AS curbal_hits,
            COUNT(*)                                                                     AS total_rows
        FROM read_parquet('{pq.as_posix()}')
    """
    if "CURBAL" not in cols:
        q = q.replace(
            f"COUNT(*) FILTER (WHERE ABS(CAST(CURBAL AS DOUBLE) - {TARGET_CURBAL}) < 0.5)  AS curbal_hits,",
            "0 AS curbal_hits,"
        )

    try:
        exact, near, curbal, total = con.execute(q).fetchone()
    except Exception as e:
        print(f"{pq.name:50s}  QUERY ERROR ({e})")
        continue

    flags = []
    if exact:  flags.append(f"EXACT={exact}")
    if near:   flags.append(f"NEAR={near}")
    if curbal: flags.append(f"CURBAL={curbal}")

    print(f"{pq.name:50s}  rows={total:>10,}  {'  '.join(flags) if flags else '-'}")

con.close()
