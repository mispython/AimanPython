# ============================================================================
# STEP 5b — WRITE YEARLY CIT AS .sas7bdat (saspy)
# ============================================================================

def _write_cit_sas7bdat(df_cit_year: pl.DataFrame) -> None:
    """Write the accumulated yearly CIT data as a SAS dataset.

    SAS equivalent: permanent dataset CIT.CIT&REPTYEAR (library CIT).
    Columns: BRANCH, AMOUNT01, NOACCT01, ..., AMOUNT12, NOACCT12.
    An existing dataset of the same name is replaced.
    """
    CIT_DIR_SAS.mkdir(parents=True, exist_ok=True)

    sas = saspy.SASsession()
    try:
        sas.saslib(CIT_SAS_LIBREF, path=str(CIT_DIR_SAS))
        sas_data = sas.df2sd(
            df_cit_year.to_pandas(),
            table=CIT_SAS_TABLE,
            libref=CIT_SAS_LIBREF,
        )
        if sas_data is None:
            raise RuntimeError(
                f"saspy failed to write {CIT_SAS_LIBREF}.{CIT_SAS_TABLE} to {CIT_DIR_SAS}"
            )
    finally:
        sas.endsas()

    print(f"  Written SAS dataset: {CIT_DIR_SAS / (CIT_SAS_TABLE.lower() + '.sas7bdat')}")




