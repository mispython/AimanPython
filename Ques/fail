def _split_al_ob_sp(rows, apply_where_filter=True):
    al, ob, sp = [], [], []
    for r in rows:
        itcode = r["ITCODE"]
        if apply_where_filter and _char_at(itcode, 14) in ("F", "#"):
            continue
        amtind = r["AMTIND"]
        if amtind and amtind != " ":
            if itcode[0:3] == "307":
                sp.append(r)
            elif itcode[0:1] != "5":
                if itcode[0:3] in ("685", "785"):
                    sp.append(r)
                else:
                    al.append(r)
            else:
                ob.append(r)
        else:
            if _char_at(itcode, 2) == "0":
                sp.append(r)
    return al, ob, sp




