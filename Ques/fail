def _sas_ddmmyy8_to_days(raw: str) -> int:
    s = raw.strip()
    if not s:
        return None
    dd = int(s[0:2])
    mm = int(s[2:4])
    yyyy = int(s[4:8])
    return (date(yyyy, mm, dd) - date(1960, 1, 1)).days

