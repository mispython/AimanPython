LRECL = 2000
DLM = "\t"   # SAS DLM='05'X is X'05' = TAB on EBCDIC; after the mainframe text transfer it is a tab




def _fmt_list_value(value: Optional[float]) -> str:
    """List-output of a COMMA20.2 variable: formatted, leading blanks removed.
    Missing (MISSING=' ') prints as a single blank."""
    return " " if value is None else f"{value:,.2f}"


def build_report_lines(template_rows: list[TemplateRow], totlcr: pl.DataFrame) -> list[str]:
    totlcr_map = {
        row["item"]: (row["utnma1"], row["utnma2"], row["utnma3"])
        for row in totlcr.iter_rows(named=True)
    }

    lines: list[str] = [ "PUBLIC INVESTMENT BANK BERHAD".ljust(LRECL) ]
    for trow in template_rows:
        utnma1, utnma2, utnma3 = (
            None if v is None else abs(v)
            for v in totlcr_map.get(trow.item, (None, None, None))
        )
        line = (
            f"{trow.desc:<500}"
            f"{DLM} {_fmt_list_value(utnma1)} "
            f"{DLM} {_fmt_list_value(utnma2)} "
            f"{DLM} {_fmt_list_value(utnma3)} "
            f"{DLM} {DLM}"
        )
        lines.append(line.ljust(LRECL))
    return lines




def _sas_sum(col: str) -> pl.Expr:
    """SAS SUM semantics: ignore missing; all-missing group -> missing (Polars would give 0)."""
    return (
        pl.when(pl.col(col).count() > 0)        # count() = non-null values only
        .then(pl.col(col).sum())
        .otherwise(pl.lit(None, dtype=pl.Float64))
        .alias(col)
    )

def summarize_totlcr(lcrall: pl.DataFrame) -> pl.DataFrame:
    return (
        lcrall.group_by("item")
        .agg([_sas_sum(c) for c in ("utnma1", "utnma2", "utnma3", "utnttl")])
        .sort("item")
    )




