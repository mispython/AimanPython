def _apply_asa(lines):
    """ASA carriage control: '1' = new page (first line and every PAGE_LENGTH lines), ' ' = single space."""
    return [("1" if i % PAGE_LENGTH == 0 else " ") + line for i, line in enumerate(lines)]




