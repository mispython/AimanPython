def sas_to_parquet(sas_path: Path, cache_path: Path, tag: str) -> None:
    print(f"  [{tag}] Converting {sas_path.name} → {cache_path.name} ...")

    writer = None
    total = 0
    rows_read = 0

    reader = pd.read_sas(
        sas_path,
        encoding="latin1",
        chunksize=CHUNK_ROWS,
    )

    for chunk in reader:
        if ROW_LIMIT and rows_read >= ROW_LIMIT:
            break

        if ROW_LIMIT:
            chunk = chunk.iloc[: ROW_LIMIT - rows_read]

        rows_read += len(chunk)

        chunk = chunk.convert_dtypes()

        for col in chunk.columns:
            s = chunk[col]

            if s.dtype.name in ["Float64", "float64"]:
                chunk[col] = s.astype("float64")

            elif s.dtype.name in ["Int64", "int64"]:
                if s.isna().any():
                    chunk[col] = s.astype("float64")
                else:
                    chunk[col] = s.astype("int64")

        table = pa.Table.from_pandas(
            chunk,
            preserve_index=False,
            safe=False
        )

        if writer is None:
            writer = pq.ParquetWriter(
                cache_path,
                table.schema,   # lock schema from FIRST chunk
                compression="snappy"
            )

        # # FORCE schema match every chunk
        # table = table.cast(writer.schema)

        writer.write_table(table)

        total += len(chunk)
        del chunk, table
        gc.collect()

    if writer:
        writer.close()

    print(f"  [{tag}] Done — {total:,} rows cached.")
