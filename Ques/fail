#!/usr/bin/env python3
"""
Program : EIIWREXL.py
Purpose : Extract detail transactions on other RM miscellaneous
          liabilities to non-residents for BNM REXL report (PIBB).

Original job : EIIWREXL
  DELETE step (SAP.PIBB.REXL.TEXT DISP=(MOD,DELETE,DELETE))
      -> handled by opening OUTPUT_FILE in 'w' mode (truncate/recreate)
  %INC PGM(DALWPBBD) / %INC PGM(FALWPBBD)
      -> build_savg_curn_dept() / build_fdwkly_uma() function calls; this
         program owns every input, converts it to a temporary Parquet file
         and passes the Parquet paths into the two %INC programs.
  DATA _NULL_ extract step -> Steps 1-2 below
  SFTP01 DD + RUNSFTP job step -> Step 3 below (paramiko upload to DRR)

Inputs (all .sas7bdat, converted to temporary Parquet, deleted after use):
  PIBB (ENTITY_CD = 'PIBB') : intg_dp_acct_saving, intg_dp_acct_current,
                              intg_dp_acct_uma, enrh_dp_fd_cert (restricted
                              to PIBB accounts via intg_dp_acct_fd)
  No ENTITY_CD              : CISDP
Report date : ctl_dwh_batch_dttm.sas7bdat, SOURCE_SYSTEM_CD = 'SAS'
SFTP info   : ctl_dwh_sftp_info.sas7bdat
"""

import tempfile
from datetime import date
from pathlib import Path

import duckdb
import pandas as pd
import paramiko
import polars as pl
import pyarrow as pa
import pyarrow.parquet as pq

from DALWPBBD import build_savg_curn_dept
from FALWPBBD import build_fdwkly_uma

# ============================================================================
# CONTROL FILE CONFIGURATION
# ============================================================================
CTL_BATCH_DTTM = Path("/sasdata/dwh/control/ctl_dwh_batch_dttm.sas7bdat")
CTL_SFTP_INFO  = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")
BATCH_SOURCE   = "SAS"      # SOURCE_SYSTEM_CD used for the report date

# SFTP target — mirrors JCL: cd "FD-BNM REPORTING/PIBB/BNM RPTG"
SFTP_HOST_DESC  = "Data Report Repository (DRR)"   # HOST_DESC in ctl_dwh_sftp_info
SFTP_PORT       = 22
SFTP_REMOTE_DIR = "FD-BNM REPORTING/PIBB/BNM RPTG"


def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM for the given SOURCE_SYSTEM_CD from the control file."""
    ctl = pd.read_sas(str(CTL_BATCH_DTTM), encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {CTL_BATCH_DTTM}")
    return pd.Timestamp(hit.iloc[0]).date()


def get_sftp_info(host_desc: str) -> dict:
    """Read SFTP_ID / SFTP_PW / HOST_IP for the given HOST_DESC from the control file."""
    ctl = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    for col in ["SFTP_ID", "SFTP_PW", "HOST_IP", "HOST_DESC"]:
        ctl[col] = ctl[col].astype(str).str.strip()
    hit = ctl.loc[ctl["HOST_DESC"] == host_desc]
    if hit.empty:
        raise ValueError(f"HOST_DESC '{host_desc}' not found in {CTL_SFTP_INFO}")
    row = hit.iloc[0]
    return {"HOST": row["HOST_IP"], "USER": row["SFTP_ID"], "PASSWORD": row["SFTP_PW"]}


# ============================================================================
# REPORT DATE / WEEK NUMBER
# DATA REPTDATE; SET DEPOSIT.REPTDATE; SELECT(DAY(REPTDATE)) ...
# (REPTDATE now comes from the SAS batch date in the control file)
# ============================================================================
print("Step 0: Deriving report date / week number...")

REPTDATE = get_batch_date(BATCH_SOURCE)

_day = REPTDATE.day
if _day == 8:
    NOWK = "1"
elif _day == 15:
    NOWK = "2"
elif _day == 22:
    NOWK = "3"
else:
    NOWK = "4"

REPTDAY  = f"{REPTDATE.day:02d}"           # DD token in input filenames
REPTMON  = f"{REPTDATE.month:02d}"         # PUT(MONTH(REPTDATE),Z2.)
REPTYEAR = REPTDATE.strftime("%y")         # PUT(REPTDATE,YEAR2.)
REPTWEEK = NOWK
REPTDT   = REPTDATE.strftime("%d%m%y")     # PUT(REPTDATE,DDMMYYN6.)

print(f"  REPTDATE : {REPTDATE}")
print(f"  REPTMON  : {REPTMON}")
print(f"  NOWK     : {NOWK}")
print(f"  REPTDT   : {REPTDT}")

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Production Path
BASE_DIR   = Path("/sas/deposit/dwh")
OUTPUT_DIR = Path("/host_pq/mis/output/deposit/report")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# Saving / Current / Uma: single PBB-version files containing BOTH entities,
# discriminated by ENTITY_CD (PIBB filter applied below).
INPUT_SAVING_FILE   = BASE_DIR / "integration" / f"intg_dp_acct_saving_d{REPTDAY}.sas7bdat"
INPUT_CURRENT_FILE  = BASE_DIR / "integration" / f"intg_dp_acct_current_d{REPTDAY}.sas7bdat"
INPUT_UMA_FILE      = BASE_DIR / "integration" / f"intg_dp_acct_uma_d{REPTDAY}.sas7bdat"

# FD: cert-level (no ENTITY_CD) + account-level (has ACCTNO + ENTITY_CD).
INPUT_FD_CERT_FILE  = BASE_DIR / "enrichment"  / f"enrh_dp_fd_cert_d{REPTDAY}.sas7bdat"
INPUT_FD_ACCT_FILE  = BASE_DIR / "integration" / f"intg_dp_acct_fd_d{REPTDAY}.sas7bdat"

# Shared PBB file (no ENTITY_CD -> not filtered).
INPUT_CISDP_FILE    = Path("/dwh/rs_cis") / f"cisr1ca{REPTMON}{REPTWEEK}{REPTYEAR}.sas7bdat"

# Output: REXL_49299_ddmmyy.XLS (same name locally and on the DRR host)
REMOTE_FILENAME = f"REXL_49299_{REPTDT}.XLS"
OUTPUT_FILE     = OUTPUT_DIR / REMOTE_FILENAME

CHUNK_ROWS = 500_000
TEMP_DIR   = None   # None = system temp; set a path if the default temp area is too small

LRECL = 1000        # RECFM=FB, LRECL=1000 -> each output line padded to 1000 chars
DLM   = chr(0x05)   # SAS '05'X delimiter

CUSTCD_NON_RESIDENT = [
    "80", "81", "82", "83", "84", "85", "86", "87", "88", "89",
    "90", "91", "92", "95", "96", "98", "99",
]
PRODCD_ELIGIBLE = ["42132", "42199"]

BNMCODE = "4929980000000Y"




# ============================================================================
# INPUT CONVERSION  (.sas7bdat -> temporary Parquet; temp folder is deleted
# automatically, so no cache is kept)
# ============================================================================
def sas_to_parquet(src: Path, dst: Path, chunk_rows: int = CHUNK_ROWS) -> None:
    """Chunked .sas7bdat -> Parquet. Schema is locked on the first chunk."""
    writer, schema = None, None
    try:
        for chunk in pd.read_sas(str(src), encoding="latin1", chunksize=chunk_rows):
            # Force text columns to string so an all-null first chunk doesn't lock a null type
            for col in chunk.columns[chunk.dtypes == object]:
                chunk[col] = chunk[col].astype("string")
            table = pa.Table.from_pandas(chunk, preserve_index=False)
            if writer is None:
                schema = table.schema
                writer = pq.ParquetWriter(str(dst), schema, compression="snappy")
            else:
                table = table.cast(schema)
            writer.write_table(table)
    finally:
        if writer is not None:
            writer.close()


def _filter_pibb(src_parquet: Path, dst_parquet: Path) -> None:
    """Keep only ENTITY_CD = 'PIBB' rows (NULL ENTITY_CD is not PIBB)."""
    con = duckdb.connect()
    try:
        con.execute(f"""
            COPY (
                SELECT *
                FROM read_parquet('{src_parquet.as_posix()}')
                WHERE TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = 'PIBB'
            ) TO '{dst_parquet.as_posix()}' (FORMAT PARQUET, COMPRESSION SNAPPY)
        """)
    finally:
        con.close()


def _filter_fd_cert_pibb(cert_parquet: Path, acct_parquet: Path, dst_parquet: Path) -> None:
    """
    Cert-level FD has no ENTITY_CD: keep only certs whose ACCTNO belongs to a
    PIBB account in the account-level FD file (semi-join on ACCTNO, so no row
    duplication if the account-level file holds several rows per ACCTNO).
    """
    con = duckdb.connect()
    try:
        con.execute(f"""
            COPY (
                SELECT c.*
                FROM read_parquet('{cert_parquet.as_posix()}') AS c
                WHERE CAST(c.ACCTNO AS BIGINT) IN (
                    SELECT DISTINCT CAST(ACCTNO AS BIGINT)
                    FROM read_parquet('{acct_parquet.as_posix()}')
                    WHERE TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = 'PIBB'
                )
            ) TO '{dst_parquet.as_posix()}' (FORMAT PARQUET, COMPRESSION SNAPPY)
        """)
    finally:
        con.close()


def _convert_pibb(src: Path, tmp: Path, tag: str) -> Path:
    """sas7bdat -> temp Parquet -> ENTITY_CD = 'PIBB' Parquet (raw copy removed)."""
    raw = tmp / f"{tag}_raw.parquet"
    out = tmp / f"{tag}.parquet"
    print(f"  [{tag}] Converting {src.name} ...")
    sas_to_parquet(src, raw)
    _filter_pibb(raw, out)
    raw.unlink()
    return out


def load_bnm_frames() -> tuple[pl.DataFrame, pl.DataFrame, pl.DataFrame]:
    """
    Converts every input to temporary Parquet, passes the Parquet paths into
    DALWPBBD / FALWPBBD, and returns (BNM_SAVG, BNM_CURN, BNM_FDWKLY).
    The temporary folder is removed on exit; the returned frames are in memory.
    """
    with tempfile.TemporaryDirectory(dir=TEMP_DIR) as tmp_dir:
        tmp = Path(tmp_dir)

        saving_pq  = _convert_pibb(INPUT_SAVING_FILE,  tmp, "saving")
        current_pq = _convert_pibb(INPUT_CURRENT_FILE, tmp, "current")
        uma_pq     = _convert_pibb(INPUT_UMA_FILE,     tmp, "uma")

        # FD: cert-level restricted to PIBB accounts through the account-level file
        print(f"  [fd] Converting {INPUT_FD_CERT_FILE.name} + {INPUT_FD_ACCT_FILE.name} ...")
        fd_cert_raw = tmp / "fd_cert_raw.parquet"
        fd_acct_raw = tmp / "fd_acct_raw.parquet"
        fd_pq       = tmp / "fd.parquet"
        sas_to_parquet(INPUT_FD_CERT_FILE, fd_cert_raw)
        sas_to_parquet(INPUT_FD_ACCT_FILE, fd_acct_raw)
        _filter_fd_cert_pibb(fd_cert_raw, fd_acct_raw, fd_pq)
        fd_cert_raw.unlink()
        fd_acct_raw.unlink()

        # CISDP: no ENTITY_CD column -> not filtered
        print(f"  [cisdp] Converting {INPUT_CISDP_FILE.name} ...")
        cisdp_pq = tmp / "cisdp.parquet"
        sas_to_parquet(INPUT_CISDP_FILE, cisdp_pq)

        # %INC PGM(DALWPBBD) / %INC PGM(FALWPBBD)
        bnm_savg, bnm_curn, _bnm_dept = build_savg_curn_dept(saving_pq, current_pq, cisdp_pq)
        bnm_fdwkly, _bnm_uma          = build_fdwkly_uma(fd_pq, uma_pq)

    return bnm_savg, bnm_curn, bnm_fdwkly




# ============================================================================
# STEP 1: BUILD COMBINED SET
# DATA _NULL_; SET BNM.SAVG&REPTMON&NOWK BNM.CURN&REPTMON&NOWK
#     BNM.FDWKLY(RENAME=(INTPAY=INTPAYBL CUSTCODE=CUSTCD BIC=PRODCD
#                        ACCTTYPE=PRODUCT)) END=LAST;
# WHERE PRODCD IN ('42132','42199') & CUSTCD IN (...) & INTPAYBL NOT IN (.,0);
# (inputs sourced from DALWPBBD / FALWPBBD, fed with PIBB-filtered Parquet)
# ============================================================================
print("\nStep 1: Combining SAVG / CURN / FDWKLY (renamed) and filtering...")

BNM_SAVG, BNM_CURN, BNM_FDWKLY = load_bnm_frames()

_savg = BNM_SAVG.select(
    ["BRANCH", "ACCTNO", "CUSTCD", "PRODCD", "NAME", "PRODUCT", "INTPAYBL"]
)
_curn = BNM_CURN.select(
    ["BRANCH", "ACCTNO", "CUSTCD", "PRODCD", "NAME", "PRODUCT", "INTPAYBL"]
)
# RENAME=(INTPAY=INTPAYBL CUSTCODE=CUSTCD BIC=PRODCD ACCTTYPE=PRODUCT)
_fdwkly = BNM_FDWKLY.select([
    "BRANCH", "ACCTNO",
    pl.col("CUSTCODE").alias("CUSTCD"),
    pl.col("BIC").alias("PRODCD"),
    "NAME",
    pl.col("ACCTTYPE").alias("PRODUCT"),
    pl.col("INTPAY").alias("INTPAYBL"),
])

combined = pl.concat([_savg, _curn, _fdwkly])




# ============================================================================
# STEP 3: SFTP UPLOAD
# DATA _NULL_; FILE SFTP01; PUT @1 "PUT //SAP.PIBB.REXL.TEXT  REXL_49299_&REPTDT..XLS";
# RUNSFTP job step: cd "FD-BNM REPORTING/PIBB/BNM RPTG"
# ============================================================================
def sftp_upload(local_file: Path, remote_dir: str, remote_name: str) -> None:
    """Upload local_file to remote_dir/remote_name on the DRR host (info from ctl_dwh_sftp_info)."""
    info = get_sftp_info(SFTP_HOST_DESC)
    transport = paramiko.Transport((info["HOST"], SFTP_PORT))
    try:
        transport.connect(username=info["USER"], password=info["PASSWORD"])
        sftp = paramiko.SFTPClient.from_transport(transport)
        try:
            sftp.chdir(remote_dir)                       # cd "FD-BNM REPORTING/PIBB/BNM RPTG"
            sftp.put(str(local_file), remote_name)       # PUT ... REXL_49299_ddmmyy.XLS
        finally:
            sftp.close()
    finally:
        transport.close()


print("\nStep 3: Uploading via SFTP...")
sftp_upload(OUTPUT_FILE, SFTP_REMOTE_DIR, REMOTE_FILENAME)
print(f"  Uploaded {OUTPUT_FILE.name} -> {SFTP_REMOTE_DIR}/{REMOTE_FILENAME}")

print("\nEIIWREXL complete.")




