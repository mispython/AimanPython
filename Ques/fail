            l.NOACCT AS NOACCT_SRC,
            (COALESCE(l.PAIDIND, '') NOT IN ('P', 'C')) AS PNOTPC
        FROM loan_raw_current l
        LEFT JOIN lncomm c
               ON l.ACCTNO = c.ACCTNO AND l.COMMNO IS NOT DISTINCT FROM c.COMMNO
        WHERE COALESCE(l.PAIDIND, '') NOT IN ('P', 'C') OR l.EIR_ADJ IS NOT NULL
    ),
    kept AS (
        SELECT * FROM base
        WHERE (ORIBAL IS NULL OR ROUND(ORIBAL, 2) <> 0)                  -- IF ORIBAL=-.00 / BALX IN (0,-0) THEN DELETE
          AND (SUBSTR(PRODCD, 1, 2) = '34' OR PRODCD = '54120')          -- IF SUBSTR(PRODCD,1,2)='34' OR PRODCD='54120';
    ),
    step1 AS (
