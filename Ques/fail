# ============================================================================
# STEP 9: DATA PBIF2; SET PBIF; FORMAT REMMTH REMFMT.;
# WHERE PART='2-RM' AND ITEM='A1.04';
# ============================================================================
print("\nStep 9: Filtering PART=2-RM / ITEM=A1.04 and bucketing REMMTH...")

# REMFMT labels in ascending REMMTH order (SAS CLASS output is ordered by the
# unformatted value, so buckets appear in this order)
_REMFMT_LABELS = [
    'UP TO 1 WK', '>1 WK - 1 MTH', '>1 MTH - 3 MTHS', '>3 - 6 MTHS',
    '>6 MTHS - 1 YR', '>1 YR  - 3 YR', '>3 YR  - 5 YR', '>5 YR',
]


def _remfmt(remmth: float) -> str:
    """PROC FORMAT VALUE REMFMT."""
    if remmth <= 0.255:
        return _REMFMT_LABELS[0]
    elif remmth <= 1:
        return _REMFMT_LABELS[1]
    elif remmth <= 3:
        return _REMFMT_LABELS[2]
    elif remmth <= 6:
        return _REMFMT_LABELS[3]
    elif remmth <= 12:
        return _REMFMT_LABELS[4]
    elif remmth <= 36:
        return _REMFMT_LABELS[5]
    elif remmth <= 60:
        return _REMFMT_LABELS[6]
    else:
        return _REMFMT_LABELS[7]


pbif2_filtered = pbif_summary.filter(
    (pl.col("PART") == "2-RM") & (pl.col("ITEM") == "A1.04")
).with_columns(
    pl.col("REMMTH").map_elements(_remfmt, return_dtype=pl.Utf8).alias("REMMTH_BUCKET")
)

