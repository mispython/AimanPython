def parse_matdate_ordinal(val) -> int:
    if val is None or val == 0:
        return 0
    try:
        ival = int(val)
        if ival > 10_000_000:                      # YYYYMMDD
            s = f"{ival:08d}"
            return date(int(s[0:4]), int(s[4:6]), int(s[6:8])).toordinal()
        return date(1960, 1, 1).toordinal() + ival # SAS date
    except Exception:
        return 0




