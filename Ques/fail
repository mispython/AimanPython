allfd = con.execute("""
    SELECT
        CURCODE,
        COUNT(*)                  AS NOACCT,
        SUM(CAST(CURBALRM AS DECIMAL(38, 6)))   AS CURBALRM,
        SUM(CAST(AMTENOR  AS DECIMAL(38, 6)))   AS AMTENOR,
        SUM(CAST(AMTENORATE AS DECIMAL(38, 6))) AS AMTENORATE
    FROM fd
    GROUP BY CURCODE
    ORDER BY CURCODE
""").pl()
