        COALESCE(b.MOBIPHON, a.MOBIPHON) AS MOBIPHON,
        {card_cols}
    FROM cis_rn a
    FULL OUTER JOIN tp_rn b
      ON a.NEWIC = b.NEWIC AND a.rn = b.rn
""").pl()

