def _append_to_cit_year(df_final: pl.DataFrame) -> pl.DataFrame:
    """Merge new monthly data into the yearly CIT parquet, preserving existing months."""

    # Columns being updated this run (e.g. AMOUNT02, NOACCT02)
    update_cols = [c for c in df_final.columns if c != "BRANCH"]

    if not CIT_YEAR_FILE.exists():
        # First run: scaffold all 12 months with zeros, then fill current month
        schema_df = _create_empty_cit_year()
        # We'll build from df_final, ensuring all 24 month cols exist
        for m in range(1, 13):
            mm = str(m).zfill(2)
            if f"AMOUNT{mm}" not in df_final.columns:
                df_final = df_final.with_columns(pl.lit(0.0).alias(f"AMOUNT{mm}"))
            if f"NOACCT{mm}" not in df_final.columns:
                df_final = df_final.with_columns(pl.lit(0).cast(pl.Int64).alias(f"NOACCT{mm}"))

        # Reorder columns canonically
        ordered_cols = ["BRANCH"] + [
            col
            for m in range(1, 13)
            for col in (f"AMOUNT{str(m).zfill(2)}", f"NOACCT{str(m).zfill(2)}")
        ]
        df_final = df_final.select(ordered_cols)
        df_final.write_parquet(CIT_YEAR_FILE)
        return df_final.sort("BRANCH")

    df_existing = _safe_read_cit_parquet(CIT_YEAR_FILE)
    df_existing = df_existing.with_columns(pl.col("BRANCH").cast(pl.Int64))
    df_final    = df_final.with_columns(pl.col("BRANCH").cast(pl.Int64))

    # Ensure all 24 month columns exist in df_existing
    for m in range(1, 13):
        mm = str(m).zfill(2)
        if f"AMOUNT{mm}" not in df_existing.columns:
            df_existing = df_existing.with_columns(pl.lit(0.0).alias(f"AMOUNT{mm}"))
        if f"NOACCT{mm}" not in df_existing.columns:
            df_existing = df_existing.with_columns(pl.lit(0).cast(pl.Int64).alias(f"NOACCT{mm}"))

    # Join new data on BRANCH, then overwrite only the updated month columns
    df_merged = df_existing.join(
        df_final.select(["BRANCH"] + update_cols),
        on="BRANCH",
        how="left",
        suffix="_NEW"
    )

    # Replace existing month cols with new values where available
    replace_exprs = []
    for col in update_cols:
        new_col = f"{col}_NEW"
        if new_col in df_merged.columns:
            replace_exprs.append(
                pl.when(pl.col(new_col).is_not_null())
                .then(pl.col(new_col))
                .otherwise(pl.col(col))
                .alias(col)
            )

    if replace_exprs:
        df_merged = df_merged.with_columns(replace_exprs)

    # Drop the _NEW suffix columns
    drop_cols = [c for c in df_merged.columns if c.endswith("_NEW")]
    df_merged = df_merged.drop(drop_cols)

    # Reorder columns canonically: BRANCH, AMOUNT01, NOACCT01, ..., AMOUNT12, NOACCT12
    ordered_cols = ["BRANCH"] + [
        col
        for m in range(1, 13)
        for col in (f"AMOUNT{str(m).zfill(2)}", f"NOACCT{str(m).zfill(2)}")
    ]
    df_merged = df_merged.select(ordered_cols)

    df_merged.write_parquet(CIT_YEAR_FILE)
    return df_merged.sort("BRANCH")

