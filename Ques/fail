# STEP 4: BUILD CISNM  (customer-name lookup)
# SAS: SET CISDP.DEPOSIT CISLN.LOAN; PROC SORT BY ACCTNO SECCUST CUSTNAME;
#      PROC SORT NODUPKEY BY ACCTNO  -> first row per ACCTNO
# SAS sorts missing/blank first, so NULLS FIRST is required (DuckDB default is NULLS LAST).
# ============================================================================
def build_cisnm() -> pl.DataFrame:
    with temp_parquet(cisdp_path, "CISDP") as cisdp_pq, \
         temp_parquet(cisln_path, "CISLN") as cisln_pq:
        con = duckdb.connect(database=":memory:")
        try:
            return con.execute(f"""
                WITH combined AS (
                    SELECT CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                           CAST(CUSTNAM1 AS VARCHAR) AS CUSTNAME,
                           CAST(SECCUST  AS VARCHAR) AS SECCUST
                    FROM read_parquet('{cisdp_pq.as_posix()}')
                    UNION ALL
                    SELECT CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                           CAST(CUSTNAM1 AS VARCHAR) AS CUSTNAME,
                           CAST(SECCUST  AS VARCHAR) AS SECCUST
                    FROM read_parquet('{cisln_pq.as_posix()}')
                ),
                ranked AS (
                    SELECT *,
                           ROW_NUMBER() OVER (
                               PARTITION BY ACCTNO
                               ORDER BY SECCUST NULLS FIRST, CUSTNAME NULLS FIRST
                           ) AS rn
                    FROM combined
                )
                SELECT ACCTNO, CUSTNAME, SECCUST FROM ranked WHERE rn = 1
            """).pl()
        finally:
            con.close()


# ============================================================================
# STEP 5: BUILD SASC  (current-period loan summary, one row per BRANCH+ACCTNO)
# [keep the FLAG-01 comment block here]
# ============================================================================
def build_sasc() -> pl.DataFrame:
    with temp_parquet(loan_path, "LOAN") as loan_pq:
        con = duckdb.connect(database=":memory:")
        try:
            return con.execute(f"""
                WITH categorised AS (
                    SELECT
                        CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                        CAST(BRANCH   AS INTEGER) AS BRANCH,
                        'C'                       AS TDI,
                        CAST(APPRLIMT AS DOUBLE)  AS APPRLIMT,
                        CAST(APPRLIM2 AS DOUBLE)  AS APPRLIM2,
                        CAST(BALANCE  AS DOUBLE)  AS BALANCE,
                        CASE
                            WHEN LNTYPE = 'OD'
                                 AND CAST(PRODUCT AS INTEGER) NOT IN (107,173) THEN 'OD'
                            WHEN LNTYPE = 'HP'                             THEN 'HP'
                            WHEN LNTYPE = 'RC'                             THEN 'RC'
                            WHEN LNTYPE IN ('HL','FL','ST','FR','FT','FS') THEN 'TL'
                            ELSE NULL
                        END AS CATG
                    FROM read_parquet('{loan_pq.as_posix()}')
                )
                SELECT
                    ACCTNO, BRANCH, 'C' AS TDI,
                    MAX(APPRLIMT)   AS APPRLIMT,
                    MAX(APPRLIM2)   AS APPRLIM2,
                    ANY_VALUE(CATG) AS CATG,
                    SUM(BALANCE)    AS ACCBAL,
                    SUM(APPRLIMT)   AS LIMTBAL
                FROM categorised
                WHERE CATG IS NOT NULL
                GROUP BY ACCTNO, BRANCH
            """).pl()
        finally:
            con.close()


# ============================================================================
# STEP 6: BUILD SASP  (previous-period loan summary)
# SAS: IF FIRST.BRANCH OR FIRST.ACCTNO THEN PACCBAL=0.00;   <-- PLIMBAL is NOT reset
#      PACCBAL + BALANCE;  PLIMBAL + APPRLIMT;
# PLIMBAL is a retained sum that is never reset, so at each BRANCH+ACCTNO output it
# holds the RUNNING TOTAL of APPRLIMT over all SASP rows up to that account (sorted
# BY BRANCH ACCTNO). This original SAS behaviour is preserved on purpose.
# ============================================================================
def build_sasp() -> pl.DataFrame:
    with temp_parquet(loanx_path, "LOANX") as loanx_pq:
        con = duckdb.connect(database=":memory:")
        try:
            return con.execute(f"""
                WITH categorised AS (
                    SELECT
                        CAST(ACCTNO   AS BIGINT)  AS ACCTNO,
                        CAST(BRANCH   AS INTEGER) AS BRANCH,
                        CAST(APPRLIMT AS DOUBLE)  AS APPRLIMT,
                        CAST(BALANCE  AS DOUBLE)  AS BALANCE,
                        CASE
                            WHEN LNTYPE = 'OD'
                                 AND CAST(PRODUCT AS INTEGER) NOT IN (107,173) THEN 'OD'
                            WHEN LNTYPE = 'HP'                             THEN 'HP'
                            WHEN LNTYPE = 'RC'                             THEN 'RC'
                            WHEN LNTYPE IN ('HL','FL','ST','FR','FT','FS') THEN 'TL'
                            ELSE NULL
                        END AS CATG
                    FROM read_parquet('{loanx_pq.as_posix()}')
                ),
                grouped AS (
                    SELECT ACCTNO, BRANCH, 'P' AS TDI,
                           ANY_VALUE(CATG)              AS CATG,
                           SUM(BALANCE)                 AS PACCBAL,
                           COALESCE(SUM(APPRLIMT), 0)   AS GRPLIM
                    FROM categorised
                    WHERE CATG IS NOT NULL
                    GROUP BY ACCTNO, BRANCH
                )
                SELECT ACCTNO, BRANCH, TDI, CATG, PACCBAL,
                       SUM(GRPLIM) OVER (
                           ORDER BY BRANCH, ACCTNO
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                       ) AS PLIMBAL
                FROM grouped
            """).pl()
        finally:
            con.close()


