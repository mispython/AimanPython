import paramiko




# Control file : SFTP connection info per host description
SFTP_CONTROL_FILE = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")




def get_sftp_info(host_desc: str):
    """Read one SFTP configuration row from the DWH SFTP control file.

    Returns (sftp_id, sftp_pw, host_ip, host_key).
    """
    if not SFTP_CONTROL_FILE.exists():
        raise FileNotFoundError(f"SFTP control file not found: {SFTP_CONTROL_FILE}")

    ctl = pd.read_sas(str(SFTP_CONTROL_FILE), format="sas7bdat", encoding="latin1")
    ctl.columns = [str(c).upper().strip() for c in ctl.columns]

    required = {"HOST_DESC", "SFTP_ID", "SFTP_PW", "HOST_IP"}
    missing_columns = sorted(required.difference(ctl.columns))
    if missing_columns:
        raise RuntimeError(
            "SFTP control file is missing columns: " + ", ".join(missing_columns)
        )

    descriptions = ctl["HOST_DESC"].fillna("").astype(str).str.strip()
    rows = ctl[descriptions.eq(host_desc)]
    if len(rows) != 1:
        raise RuntimeError(
            f"Expected exactly one SFTP row for '{host_desc}'; found {len(rows)}"
        )

    row = rows.iloc[0]

    # SAS character values can contain fixed-width padding.
    clean = lambda value: "".join(str(value).split()) if pd.notna(value) else ""
    sftp_id = clean(row["SFTP_ID"])
    sftp_pw = clean(row["SFTP_PW"])
    host_ip = clean(row["HOST_IP"])
    host_key = clean(row["HOST_KEY"]) if "HOST_KEY" in ctl.columns else ""

    empty_values = [
        name for name, value in (
            ("SFTP_ID", sftp_id), ("SFTP_PW", sftp_pw), ("HOST_IP", host_ip)
        ) if not value
    ]
    if empty_values:
        raise RuntimeError(
            f"SFTP row for '{host_desc}' has blank values: {', '.join(empty_values)}"
        )

    return sftp_id, sftp_pw, host_ip, host_key




# DRR (Data Report Repository) SFTP target - from FTPFDFCY
#   CD TD/INTERBANK/FCYFD
#   PUT //SAP.PBB.MNI.FDRMFC  FDRMFC_%ODD.%OMM.%OYY..CSV
DRR_HOST_DESC   = "Data Report Repository (DRR)"      # HOST_DESC in ctl_dwh_sftp_info
DRR_REMOTE_DIR  = "TD/INTERBANK/FCYFD"
DRR_REMOTE_FILE = f"FDRMFC_{REPTDATE:%d.%m.%y}.CSV"   # FDRMFC_DD.MM.YY.CSV




# ============================================================
# SFTP UPLOAD TO DRR
# ============================================================
def sftp_upload_to_drr(local_path: Path, remote_name: str) -> None:
    """Upload the report to the DRR server (equivalent of JCL RUNSFTP step).

    Connection details come from ctl_dwh_sftp_info.sas7bdat. HOST_KEY is blank
    for the DRR row, so no host-key pinning is applied (AutoAddPolicy).
    The file is sent as-is: it is already fixed-length (LRECL=150), which
    matches the JCL's 'notrim' option.
    """
    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(DRR_HOST_DESC)

    ssh = paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to DRR host {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw, timeout=30)
    try:
        sftp = ssh.open_sftp()
        try:
            try:
                sftp.chdir(DRR_REMOTE_DIR)
            except IOError as exc:
                raise FileNotFoundError(
                    f"Remote DRR folder '{DRR_REMOTE_DIR}' not found"
                ) from exc

            print(f"  SFTP upload: {local_path.name} -> {DRR_REMOTE_DIR}/{remote_name}")
            sftp.put(str(local_path), remote_name)
            print(f"  Uploaded {sftp.stat(remote_name).st_size:,} bytes.")
        finally:
            sftp.close()
    finally:
        ssh.close()
    print("  DRR upload complete.")





