_PARQUET_CACHE: dict[Path, Path] = {}      # source .sas7bdat -> temp parquet (converted once per run)


def sas_to_parquet(src: Path, dst: Path, chunk_rows: int = CHUNK_ROWS) -> None:
    """Chunked .sas7bdat -> Parquet. Schema is locked on the first chunk."""
    writer, schema = None, None
    try:
        for chunk in pd.read_sas(str(src), encoding="latin1", chunksize=chunk_rows):
            chunk.columns = [str(c).upper() for c in chunk.columns]
            # Force text columns to string so an all-null first chunk doesn't lock a null type
            for col in chunk.columns[chunk.dtypes == object]:
                chunk[col] = chunk[col].astype("string")
            table = pa.Table.from_pandas(chunk, preserve_index=False)
            if writer is None:
                schema = table.schema
                writer = pq.ParquetWriter(str(dst), schema, compression="snappy")
            else:
                table = table.cast(schema)
            writer.write_table(table)
    finally:
        if writer is not None:
            writer.close()
    if writer is None:
        raise ValueError(f"No rows found in {src}")


def _read_sas(path: Path, tmp_dir: Path, entity_cd: str | None = None) -> pl.DataFrame:
    """
    Read a .sas7bdat via a temporary Parquet file (converted once per run,
    reused if the same input is requested again) using DuckDB, optionally
    keeping only rows of the given ENTITY_CD. Columns are upper-cased.
    """
    parquet = _PARQUET_CACHE.get(path)
    if parquet is None:
        parquet = tmp_dir / f"{len(_PARQUET_CACHE):02d}_{path.stem}.parquet"
        sas_to_parquet(path, parquet)
        _PARQUET_CACHE[path] = parquet

    where = ""
    if entity_cd is not None:
        where = f"WHERE TRIM(COALESCE(CAST(ENTITY_CD AS VARCHAR), '')) = '{entity_cd}'"

    con = duckdb.connect()
    try:
        return con.execute(
            f"SELECT * FROM read_parquet('{parquet.as_posix()}') {where}"
        ).pl()
    finally:
        con.close()




def build_cisca_cisfd(tmp_dir: Path) -> tuple[pl.DataFrame, pl.DataFrame]:
    """
    DATA CISCA CISFD;
       SET CISCA.DEPOSIT CISFD.DEPOSIT;
       IF NEWIC NE '' THEN ICNO = NEWIC; ELSE ICNO = OLDIC;
       IF (3000000000<=ACCTNO<=3999999999) THEN OUTPUT CISCA;
       IF (1000000000<=ACCTNO<=1999999999) THEN OUTPUT CISFD;
       IF (7000000000<=ACCTNO<=7999999999) THEN OUTPUT CISFD;

    CISFD (SAP.PBB.CRM.CISBEXT) is supplied as two datasets, CISFD_SA and
    CISFD_FD; they are combined here into one CISFD source.
    """
    cisca_raw    = _read_sas(INPUT_CISCA, tmp_dir)
    cisfd_sa_raw = _read_sas(INPUT_CISFD_SA, tmp_dir)
    cisfd_fd_raw = _read_sas(INPUT_CISFD_FD, tmp_dir)
    cisfd_raw    = pl.concat([cisfd_sa_raw, cisfd_fd_raw], how="diagonal_relaxed")

    # SET (union) both CIS sources, then split by ACCTNO range
    combined = pl.concat([_build_cis(cisca_raw), _build_cis(cisfd_raw)], how="diagonal_relaxed")

    acctno = pl.col("ACCTNO").cast(pl.Int64, strict=False)
    cisca = combined.filter(acctno.is_between(*CA_RANGE))
    cisfd = combined.filter(
        acctno.is_between(*FD_RANGE_1) | acctno.is_between(*FD_RANGE_2)
    )
    return cisca, cisfd


def build_ca_fd(tmp_dir: Path) -> tuple[pl.DataFrame, pl.DataFrame]:
    """
    DATA CA FD;
       SET DEPOSIT.CURRENT DEPOSIT.FD;
       IF CURBAL > 0;
       IF (3000000000<=ACCTNO<=3999999999) THEN OUTPUT CA;
       IF (1000000000<=ACCTNO<=1999999999) THEN OUTPUT FD;
       IF (7000000000<=ACCTNO<=7999999999) THEN OUTPUT FD;
    """
    ica_df = _read_sas(INPUT_ICA, tmp_dir, ENTITY_CD_PIBB)   # DEPOSIT.CURRENT → ica
    ifd_df = _read_sas(INPUT_IFD, tmp_dir, ENTITY_CD_PIBB)   # DEPOSIT.FD      → ifd

    combined = pl.concat([ica_df, ifd_df], how="diagonal_relaxed")
    combined = combined.filter(pl.col("CURBAL").cast(pl.Float64, strict=False) > 0)

    acctno = pl.col("ACCTNO").cast(pl.Int64, strict=False)
    ca = combined.filter(acctno.is_between(*CA_RANGE))
    fd = combined.filter(
        acctno.is_between(*FD_RANGE_1) | acctno.is_between(*FD_RANGE_2)
    )
    return ca, fd




