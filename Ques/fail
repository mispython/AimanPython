SFTP_CONTROL_FILE = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")
LCR_HOST_DESC     = "PIVB LCR File Server"     # JCL: sas2finlcr@192.168.56.10
REMOTE_EXT        = ".XLS"                     # original remote name: NSFR_&RPTDT._MTH.XLS


def get_sftp_info(host_desc: str):
    """Read one SFTP configuration row directly from the DWH control file."""
    if not SFTP_CONTROL_FILE.exists():
        raise FileNotFoundError(f"SFTP control file not found: {SFTP_CONTROL_FILE}")

    ctl = pd.read_sas(SFTP_CONTROL_FILE, format="sas7bdat", encoding="utf-8")
    ctl.columns = [str(c).upper().strip() for c in ctl.columns]

    required = {"HOST_DESC", "SFTP_ID", "SFTP_PW", "HOST_IP"}
    missing_columns = sorted(required.difference(ctl.columns))
    if missing_columns:
        raise RuntimeError("SFTP control file is missing columns: " + ", ".join(missing_columns))

    descriptions = ctl["HOST_DESC"].fillna("").astype(str).str.strip()
    rows = ctl[descriptions.eq(host_desc)]
    if len(rows) != 1:
        raise RuntimeError(f"Expected exactly one SFTP row for '{host_desc}'; found {len(rows)}")

    row = rows.iloc[0]
    clean = lambda value: "".join(str(value).split()) if pd.notna(value) else ""
    sftp_id = clean(row["SFTP_ID"])
    sftp_pw = clean(row["SFTP_PW"])
    host_ip = clean(row["HOST_IP"])
    host_key = clean(row["HOST_KEY"]) if "HOST_KEY" in ctl.columns else ""

    empty_values = [
        name for name, value in (("SFTP_ID", sftp_id), ("SFTP_PW", sftp_pw), ("HOST_IP", host_ip))
        if not value
    ]
    if empty_values:
        raise RuntimeError(f"SFTP row for '{host_desc}' has blank values: {', '.join(empty_values)}")

    return sftp_id, sftp_pw, host_ip, host_key




def sftp_upload_to_pivb(local_path: Path, remote_name: str) -> None:
    """
    Equivalent of JCL RUNSFTP: put the report to the PIVB LCR file server
    (home directory, no CD). Binary transfer, because the file is now a real .xlsx
    (the original lzopts mode=text conversion applied to the old text extract).
    """
    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(LCR_HOST_DESC)

    ssh = paramiko.SSHClient()
    # HOST_KEY is blank for this row in ctl_dwh_sftp_info, so strict pinning is not possible.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to {LCR_HOST_DESC} {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    try:
        sftp = ssh.open_sftp()
        try:
            print(f"  SFTP upload: {local_path.name} -> {remote_name}")
            sftp.put(str(local_path), remote_name)
        finally:
            sftp.close()
    finally:
        ssh.close()
    print("  PIVB upload complete.")




remote_name = f"NSFR_{rptdt}_MTH{REMOTE_EXT}"
print("\nUploading report to PIVB LCR File Server via SFTP...")
sftp_upload_to_pivb(xlsx_path, remote_name)




