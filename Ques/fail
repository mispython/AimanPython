SELECT
    ACCTNO,
    MAX(BRANCH) AS BRANCH,
    MAX(LMTBASER) AS LMTBASER,
    MAX(NAME) AS NAME,
    MAX(ODSTATUS) AS ODSTATUS,
    MAX(APPRLIMT) AS APPRLIMT,

    MAX(CASE WHEN rn = 1 THEN LMTAMT END) AS LIMIT1,
    MAX(CASE WHEN rn = 1 THEN LMTRATE END) AS RATE1,
    MAX(CASE WHEN rn = 1 THEN LMTCOLL END) AS COLL1,

    MAX(CASE WHEN rn = 2 THEN LMTAMT END) AS LIMIT2,
    MAX(CASE WHEN rn = 2 THEN LMTRATE END) AS RATE2,
    MAX(CASE WHEN rn = 2 THEN LMTCOLL END) AS COLL2,

    MAX(CASE WHEN rn = 3 THEN LMTAMT END) AS LIMIT3,
    MAX(CASE WHEN rn = 3 THEN LMTRATE END) AS RATE3,
    MAX(CASE WHEN rn = 3 THEN LMTCOLL END) AS COLL3,

    MAX(CASE WHEN rn = 4 THEN LMTAMT END) AS LIMIT4,
    MAX(CASE WHEN rn = 4 THEN LMTRATE END) AS RATE4,
    MAX(CASE WHEN rn = 4 THEN LMTCOLL END) AS COLL4,

    MAX(CASE WHEN rn = 5 THEN LMTAMT END) AS LIMIT5,
    MAX(CASE WHEN rn = 5 THEN LMTRATE END) AS RATE5,
    MAX(CASE WHEN rn = 5 THEN LMTCOLL END) AS COLL5

FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY ACCTNO ORDER BY LMTAMT, LMTRATE, LMTCOLL) AS rn
    FROM ovdr
)
GROUP BY ACCTNO



o.LIMIT1,
o.RATE1,
o.COLL1,
o.LIMIT2,
o.RATE2,
o.COLL2,
o.LIMIT3,
o.RATE3,
o.COLL3,
o.LIMIT4,
o.RATE4,
o.COLL4,
o.LIMIT5,
o.RATE5,
o.COLL5,
(
    COALESCE(o.LIMIT1, 0) +
    COALESCE(o.LIMIT2, 0) +
    COALESCE(o.LIMIT3, 0) +
    COALESCE(o.LIMIT4, 0) +
    COALESCE(o.LIMIT5, 0)
) AS LIMITS
