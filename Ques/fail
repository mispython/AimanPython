    BNM_CURN.write_parquet(CURN_CACHE)
    BNM_DEPT.write_parquet(DEPT_CACHE)

    print(f"  Cached: {SAVG_CACHE.name}, {CURN_CACHE.name}, {DEPT_CACHE.name}")
    return BNM_SAVG, BNM_CURN, BNM_DEPT
