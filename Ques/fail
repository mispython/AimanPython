    pl.col('INTPLAN').map_elements(lambda x: fdprod_format(x), return_dtype=pl.String).alias('BNMCODE')
)
counts = fd_with_bnm.group_by('BNMCODE').agg(pl.len())
print("  Distinct BNMCODE counts:")
