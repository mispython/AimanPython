def accumulate_monthly(
    sas: saspy.SASsession,
    daily_df: pl.DataFrame,
    monthly_dir: Path,
    libref: str,
    prefix: str,
    reptmon: str,
    reptday: str,
    reptdt: float,
) -> Path:
    """Replicate the %ACCUM macro:

    %IF "&REPTDAY" EQ "01" %THEN
        DATA BNMx.<PREFIX>&REPTMON; SET <daily>; RUN;
    %ELSE
        DATA BNMx.<PREFIX>&REPTMON; SET BNMx.<PREFIX>&REPTMON;
            IF REPTDATE EQ "&RDATE" THEN DELETE;
        RUN;
        PROC APPEND DATA=<daily> BASE=BNMx.<PREFIX>&REPTMON; RUN;
    """
    table = f"{prefix}{reptmon}"
    monthly_file = monthly_dir / f"{table.lower()}.sas7bdat"

    sas.saslib(libref, path=str(monthly_dir))

    if reptday == "01":
        result_df = daily_df
    else:
        if monthly_file.exists():
            existing_df = read_sas_dataset(monthly_file)
            existing_df = (
                existing_df.filter(pl.col("REPTDATE") != reptdt)
                .select(daily_df.columns)
                .cast(daily_df.schema)
            )
        else:
            existing_df = daily_df.clear()
        result_df = pl.concat([existing_df, daily_df], how="vertical")

    write_sas_dataset(sas, result_df, libref, table)
    return monthly_file




