DRR_HOST_DESC       = "Data Report Repository (DRR)"
DRR_REMOTE_DIR      = "HPCC/WRITTEN-OFF"




def _read_fixed_records(path: Path) -> list:
    """Read a text file and pad/truncate every line to exactly 800 characters."""
    print(f"  Reading: {path}")
    if not path.exists():
        raise FileNotFoundError(f"Input file not found: {path}")

    with open(path, "r") as f:
        records = [line.rstrip("\n\r").ljust(RECORD_LENGTH)[:RECORD_LENGTH] for line in f]

    print(f"    Records read: {len(records)}")
    return records


def read_woff_files():
    """
    Read write-off text files (PIBB first, then PBB, as in the JCL INPUT DD
    concatenation). Each record is 800 characters.
    """
    print("Reading write-off input files...")

    records = _read_fixed_records(PIBB_INPUT_FILE)
    records += _read_fixed_records(PBB_INPUT_FILE)

    print(f"\nTotal records read: {len(records)}")
    return records




def write_output_file(records):
    """
    Write output file with FH header and FT trailer.

    - Line 1  : FHYYYYMMDD (run date), padded to 800
    - Lines 2+: data records (800 chars each)
    - Last    : FTnnnnnnnn (data record count, Z8), padded to 800
    """
    print(f"\nWriting output file: {OUTPUT_FILE}")

    rundate_str  = RUN_DATE.strftime("%Y%m%d")
    record_count = len(records)

    with open(OUTPUT_FILE, "w", newline="") as f:
        f.write(f"FH{rundate_str}".ljust(RECORD_LENGTH) + LINE_TERMINATOR)
        for record in records:
            f.write(record + LINE_TERMINATOR)
        f.write(f"FT{record_count:08d}".ljust(RECORD_LENGTH) + LINE_TERMINATOR)

    print(f"  File header: FH{rundate_str}")
    print(f"  Data records: {record_count}")
    print(f"  File trailer: FT{record_count:08d}")
    print(f"  Total lines written: {record_count + 2}")




def sftp_upload(host_desc: str, remote_dir: str, local_file: Path, remote_name: str) -> None:
    """Upload one file to the SFTP server identified by HOST_DESC."""
    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(host_desc)

    ssh = paramiko.SSHClient()
    # HOST_KEY from the control file is not used for pinning (same as EIWFRMCR);
    # AutoAddPolicy is used until the stored key format is confirmed.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to {host_desc} ({host_ip}) as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    try:
        sftp = ssh.open_sftp()
        try:
            try:
                sftp.chdir(remote_dir)
            except IOError as exc:
                raise FileNotFoundError(
                    f"Remote folder '{remote_dir}' not found on {host_desc}"
                ) from exc
            print(f"  SFTP upload: {local_file.name} -> {remote_dir}/{remote_name}")
            sftp.put(str(local_file), remote_name)
        finally:
            sftp.close()
    finally:
        ssh.close()


def sftp_to_webnotes() -> None:
    """JCL step: FTP TO WEBNOTES."""
    print("\nUploading to WebNotes via SFTP...")
    sftp_upload(WEBNOTES_HOST_DESC, WEBNOTES_REMOTE_DIR, OUTPUT_FILE, REMOTE_FILENAME)
    print("  WebNotes upload complete.")


def sftp_to_drr() -> None:
    """JCL step: FTP TO SAS DATAWAREHOUSE (DRR)."""
    print("\nUploading to DRR via SFTP...")
    sftp_upload(DRR_HOST_DESC, DRR_REMOTE_DIR, OUTPUT_FILE, REMOTE_FILENAME)
    print("  DRR upload complete.")




def main():
    """Main processing function."""
    print("=" * 70)
    print("EIFFTXT5 - HP LOTUS NOTES WRITE-OFF TEXT FILE PROCESSOR")
    print("=" * 70)
    print(f"\nBatch Date ({SOURCE_SYSTEM_CD}): {RUN_DATE.strftime('%Y-%m-%d')}")

    try:
        records = read_woff_files()

        if len(records) == 0:
            print("\nWarning: No records read from input files")
            print("Output file will contain only header and trailer")

        write_output_file(records)

        sftp_to_webnotes()
        sftp_to_drr()

        print("\n" + "=" * 70)
        print("✓ PROCESSING COMPLETED SUCCESSFULLY")
        print("=" * 70)

        print("\nOutput file:")
        print(f"  Combined write-off file: {OUTPUT_FILE}")
        print(f"  Remote filename        : {REMOTE_FILENAME}")
        print(f"  WebNotes               : {WEBNOTES_HOST_DESC} / {WEBNOTES_REMOTE_DIR}")
        print(f"  DRR                    : {DRR_HOST_DESC} / {DRR_REMOTE_DIR}")

        print("\nFile statistics:")
        print(f"  Data records: {len(records)}")
        print(f"  Total lines (incl. header/trailer): {len(records) + 2}")
        print(f"  Record length: {RECORD_LENGTH} characters")

        return 0

    except Exception as e:
        print("\n" + "!" * 70)
        print(f"✗ PROCESSING FAILED: {e}")
        print("!" * 70)
        import traceback
        traceback.print_exc()
        return 1




