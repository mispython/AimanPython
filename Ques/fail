        lines.append(
            f"{obs_no:>6} {_int_str(r.get('BRANCH')):>7}  {_int_str(r.get('ACCTNO')):>12}  "
            f"{str(r.get('CUSTNAME') or ''):<26}  {_int_str(r.get('CUSTNO')):>8}  "
            f"{_int_str(r.get('CUSTCODE')):>7}  {curbal:>18,.2f}  {_int_str(r.get('PRODUCT')):>8}"
        )

    # grand total bar + sum at the end (SAS PROC PRINT SUM behaviour)
