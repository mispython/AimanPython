def _sas_round(x: float) -> float:
    """SAS ROUND() equivalent: round half away from zero, with the same
    small relative fuzz SAS applies around the halfway point to absorb
    IEEE-754 representation noise (e.g. 129701.49999999999 -> 129702)."""
    if x == 0.0:
        return 0.0
    fuzz = abs(x) * 1e-10
    if x > 0:
        return float(int(x + 0.5 + fuzz))
    return float(-int(-x + 0.5 + fuzz))
