ca = ca.join(
    cisca.select(["ACCTNO", "CUSTNAME", "ICNO"]),
    on="ACCTNO",
    how="left",
)

ca = ca.with_columns(
    (pl.col("CURBAL").fill_null(0) + pl.col("INTPAYBL").fill_null(0)).alias("BALANCE"),
    pl.lit("CA").alias("CISTYPE"),
)


