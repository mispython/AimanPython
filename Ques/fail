#!/usr/bin/env python3
"""Throwaway diagnostic: inspect ENTITY_CD values in the raw caches."""
import duckdb
from pathlib import Path

CACHE_DIR = Path("/sas/python/virt_edw/Data_Warehouse/MIS/XMIS/input/cache/EIBDLIQP")

SAVING_CACHE_FULL  = CACHE_DIR / "saving_full.parquet"
CURRENT_CACHE_FULL = CACHE_DIR / "current_full.parquet"

con = duckdb.connect(database=":memory:")
for tag, cache in [("SAVING", SAVING_CACHE_FULL), ("CURRENT", CURRENT_CACHE_FULL)]:
    print(f"--- {tag} ENTITY_CD distinct values ---")
    rows = con.execute(f"""
        SELECT
            TRIM(CAST(ENTITY_CD AS VARCHAR)) AS ENTITY_CD,
            COUNT(*)                         AS N
        FROM read_parquet('{cache.as_posix()}')
        GROUP BY 1
        ORDER BY N DESC
    """).fetchall()
    for v, n in rows:
        print(f"  {v!r:20} {n:,}")
con.close()
