_PARQUET_REGISTRY: dict = {}      # sas7bdat path -> temporary Parquet (converted once per run)


def _load_cached(sas_path: Path, tag: str) -> Path:
    """Convert a .sas7bdat to a temporary Parquet once per run; reuse it on later calls.

    The same physical file is never converted twice, even when several DDs point to it.
    The Parquet files live under CACHE_DIR (temporary) and are deleted at the end of the run.
    """
    key = sas_path.resolve().as_posix()
    cache_path = _PARQUET_REGISTRY.get(key)
    if cache_path is not None:
        print(f"  [{tag}] Already converted in this run - reusing temporary Parquet.")
        return cache_path

    # Index + parent folder name keep names unique (RENCC / RENLN / LNNOTE share member names).
    cache_path = CACHE_DIR / f"{len(_PARQUET_REGISTRY):03d}__{sas_path.parent.name}__{sas_path.stem}.parquet"
    _sas_to_parquet(sas_path, cache_path, tag)
    _PARQUET_REGISTRY[key] = cache_path
    return cache_path




