_VALUE_COLS = ["SA", "ISA", "TSA", "CA", "ICA", "TCA", "FD", "IFD", "TFD"]


def _value_parts(rec: dict) -> list:
    parts = []
    for i, c in enumerate(_VALUE_COLS):
        if i:
            parts.append(("lit", ";"))
        parts.append(("var", _comma_text(rec[c])))
    return parts


