def _write_isbase(df: pl.DataFrame) -> None:
    """Write the ISBASE dataset as isbase.sas7bdat through saspy."""
    sas = saspy.SASsession()
    try:
        sas.saslib(ISBASE_LIBREF, path=str(INPUT_ISBASE_DIR))
        sas.df2sd(df.to_pandas(), table=ISBASE_TABLE, libref=ISBASE_LIBREF)
    finally:
        sas.endsas()


def _ensure_isbase() -> None:
    """
    Step from EIBMSISD:
        DATA SGM.ISBASE; ACCTNO=9999999999; NOTENO=99999;
    Creates isbase.sas7bdat (one seed observation) when it does not exist yet.
    """
    if INPUT_ISBASE_FILE.exists():
        return
    INPUT_ISBASE_DIR.mkdir(parents=True, exist_ok=True)
    seed = pl.DataFrame({"ACCTNO": [9999999999.0], "NOTENO": [99999.0]})
    _write_isbase(seed)
    print(f"  [ISBASE] Created {INPUT_ISBASE_FILE}")




