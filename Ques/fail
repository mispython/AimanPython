def _format_subtotal(label: str, amount: float) -> str:
    """Return a line with 'label' left-justified under the DEPOSITOR column,
    and amount right-justified under the CURBAL column."""
    # Fixed widths (Obs=6, BRANCH=6, ACCTNO=12, CUSTCODE=8, DEPOSITOR=30,
    # CUSTNO=12, NEWIC=14, OLDIC=14) => total before CURBAL = 6+6+12+8+30+12+14+14 = 102
    # The CURBAL column is 18 wide.
    before_curbal = 6 + 6 + 12 + 8 + 30 + 12 + 14 + 14
    return f"{label:<{before_curbal}}{_fmt_comma(amount, 18)}"


