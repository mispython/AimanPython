# ============================================================================
# STEP 12: GENERATE OUTPUT FILE (aligned, no separator line)
# ============================================================================
print("\nStep 12: Generating output file...")

report_df = sdfall.filter(pl.col("REPTDATE") <= reptdate)

# Convert to list of dicts for easier processing
rows = report_df.to_dicts()

# Define column headers and their alignment (L=left, R=right)
columns = [
    ("Date", "L"),
    ("Branch", "R"),
    ("SDF Account Number", "R"),
    ("Customer Name", "L"),
    ("Product", "R"),
    ("Opening Balance", "R"),
    ("Transaction Code", "R"),
    ("Description", "L"),
    ("Debit", "R"),
    ("Credit", "R"),
    ("Outstanding Balance", "R"),
]

# Prepare data rows with formatted values
data_rows = []
for row in rows:
    date_str = row["REPTDATE"].strftime("%d/%m/%Y")
    cust_name = (row["CUSTNAME"] or "").strip()
    trandesc = (row["TRANDESC"] or "").strip()
    
    # Format numbers: COMMA16.2 for decimals, BEST12. for integers
    def fmt_comma(val):
        if val is None or pd.isna(val):
            return ""
        return f"{float(val):,.2f}"
    
    def fmt_int(val):
        if val is None or pd.isna(val):
            return ""
        return f"{int(round(float(val)))}"
    
    data_rows.append([
        date_str,
        fmt_int(row["BRANCH"]),
        fmt_int(row["ACCTNO"]),
        cust_name,
        fmt_int(row["PRODUCT"]),
        fmt_comma(row["PCURBAL"]),
        fmt_int(row["TRANCODE"]),
        trandesc,
        fmt_comma(row["DEBIT"]),
        fmt_comma(row["CREDIT"]),
        fmt_comma(row["CURBAL"]),
    ])

# Combine header and data
all_rows = [[col[0] for col in columns]] + data_rows

# Compute column widths (at least as wide as the header)
col_widths = []
for i, col in enumerate(columns):
    header_len = len(col[0])
    max_data_len = max((len(str(row[i])) for row in data_rows), default=0)
    col_widths.append(max(header_len, max_data_len) + 2)  # +2 for padding

# Build the table lines
lines = []
# Title
lines.append(f"Special Deposit Facility (SDF) RM Account as at {RDATE}")
lines.append("")  # blank line

# Header row
header_line = ""
for i, col in enumerate(columns):
    if col[1] == "L":
        header_line += col[0].ljust(col_widths[i])
    else:
        header_line += col[0].rjust(col_widths[i])
lines.append(header_line)

# Data rows (no separator line)
for data_row in data_rows:
    line = ""
    for i, (col, align) in enumerate(columns):
        val = data_row[i]
        if align == "L":
            line += val.ljust(col_widths[i])
        else:
            line += val.rjust(col_widths[i])
    lines.append(line)

# Write to file
with open(OUTPUT_FILE, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")

print(f"\n  Output written : {OUTPUT_FILE}")
print(f"  Total rows    : {len(data_rows)}")
print("\n  --- Output preview ---")
for ln in lines[:20]:
    print(ln)
if len(lines) > 20:
    print(f"  ... ({len(lines) - 20} more lines)")
