def drr_remote_filename() -> str:
    """EIWIBT1C%ODD.%OMM..TXT -> EIWIBT1C + DD + MM + .TXT
    (day and month taken from the SAS batch date, REPTDAY / REPTMON)."""
    return f"{DRR_REMOTE_PREFIX}{REPTDAY}{REPTMON}.TXT"


def sftp_upload_to_drr(local_path: Path, remote_name: str) -> None:
    """Upload the report text file to the DRR server.

    Equivalent of the JCL RUNSFTP step (lzopts notrim, mode=text): the file is
    already written as fixed 150-byte records, so it is uploaded as-is and
    trailing blanks are preserved.
    """
    if not local_path.exists():
        raise FileNotFoundError(f"Output file to upload not found: {local_path}")

    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(DRR_HOST_DESC)

    ssh = paramiko.SSHClient()
    # HOST_KEY in ctl_dwh_sftp_info is blank for the DRR row, so host-key
    # pinning is not possible; the missing-key policy is auto-add.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to DRR host {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw, timeout=30)
    try:
        sftp = ssh.open_sftp()
        try:
            try:
                sftp.chdir(DRR_REMOTE_DIR)
            except IOError:
                raise RuntimeError(
                    f"Remote DRR folder '{DRR_REMOTE_DIR}' not found"
                )

            print(f"  SFTP upload: {local_path.name} -> {DRR_REMOTE_DIR}/{remote_name}")
            sftp.put(str(local_path), remote_name)

            local_size = local_path.stat().st_size
            remote_size = sftp.stat(remote_name).st_size
            if remote_size != local_size:
                raise RuntimeError(
                    f"Upload size mismatch for {remote_name}: "
                    f"local={local_size}, remote={remote_size}"
                )
        finally:
            sftp.close()
    finally:
        ssh.close()
    print("  DRR upload complete.")




