def _merge_with_cis(acct_df: pl.DataFrame, cis_df: pl.DataFrame, cis_wins: bool) -> pl.DataFrame:
    """
    SAS: MERGE acct(IN=A) cis; BY ACCTNO;  IF CUSTNAME='   ' THEN CUSTNAME=NAME;  IF A;

    cis_wins=True  (CA) : MERGE CA(IN=A) CISCA    -> CIS value overwrites a same-named account
                          column on matched rows; unmatched rows keep the account value.
    cis_wins=False (FD/SA): MERGE CISFD FD(IN=A)  -> account value is kept for same-named columns;
                          CIS only supplies columns the account file does not have.
    """
    cis_cols = [c for c in cis_df.columns if c != "ACCTNO"]
    common   = [c for c in cis_cols if c in acct_df.columns]

    cis_r = (
        cis_df.select(["ACCTNO"] + cis_cols)
        .with_columns(
            pl.col("ACCTNO").cast(acct_df.schema["ACCTNO"]),
            pl.lit(True).alias("_IN_CIS"),
        )
        .rename({c: f"{c}__CIS" for c in common})
    )

    merged = acct_df.join(cis_r, on="ACCTNO", how="left")

    for c in common:
        if cis_wins:
            merged = merged.with_columns(
                pl.when(pl.col("_IN_CIS"))
                  .then(pl.col(f"{c}__CIS").cast(acct_df.schema[c], strict=False))
                  .otherwise(pl.col(c))
                  .alias(c)
            )
        merged = merged.drop(f"{c}__CIS")
    merged = merged.drop("_IN_CIS")

    # IF CUSTNAME='   ' THEN CUSTNAME=NAME;
    merged = merged.with_columns(
        pl.when(pl.col("CUSTNAME").is_null() | (pl.col("CUSTNAME").str.strip_chars() == ""))
          .then(pl.col("NAME"))
          .otherwise(pl.col("CUSTNAME"))
          .alias("CUSTNAME")
    )
    return merged




