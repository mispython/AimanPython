                SELECT COUNT(*)                                          AS total,
                       COUNT(*) FILTER (WHERE c_entity)                  AS entity,
                       COUNT(*) FILTER (WHERE c_prod)                    AS product_amount_only,
                       COUNT(*) FILTER (WHERE c_entity AND c_prod)       AS entity_and_product
                FROM f""").pl())
        finally:
            con.close()


