# HELPERS: BATCH DATE + SFTP
# ============================================================================
def get_batch_date(source_system_cd: str) -> date:
    """Read BATCH_DTTM for the given SOURCE_SYSTEM_CD from the control file."""
    ctl = pd.read_sas(str(CTL_BATCH_DTTM), encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(
            f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {CTL_BATCH_DTTM}"
        )
    return pd.Timestamp(hit.iloc[0]).date()


def read_sftp_info(host_desc: str) -> tuple:
    """Return (SFTP_ID, SFTP_PW, HOST_IP) for the given HOST_DESC."""
    ctl = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    for col in ("SFTP_ID", "SFTP_PW", "HOST_IP", "HOST_DESC"):
        ctl[col] = ctl[col].astype(str).str.strip()
    hit = ctl.loc[ctl["HOST_DESC"] == host_desc]
    if hit.empty:
        raise ValueError(f"HOST_DESC '{host_desc}' not found in {CTL_SFTP_INFO}")
    row = hit.iloc[0]
    return row["SFTP_ID"], row["SFTP_PW"], row["HOST_IP"]


def sftp_put(local_file: Path, remote_dir: str, remote_name: str, host_desc: str) -> None:
    """Upload local_file to remote_dir/remote_name (equivalent of CD + PUT in FTPFMSGL)."""
    user, password, host = read_sftp_info(host_desc)
    remote_path = f"{remote_dir.rstrip('/')}/{remote_name}"

    transport = paramiko.Transport((host, SFTP_PORT))
    try:
        transport.connect(username=user, password=password)
        client = paramiko.SFTPClient.from_transport(transport)
        try:
            client.put(str(local_file), remote_path, confirm=True)
        finally:
            client.close()
    finally:
        transport.close()

    print(f"  SFTP done      : {local_file.name} -> {host}:{remote_path}")




