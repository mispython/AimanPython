def read_sas_dataset(file_path: Path) -> pl.DataFrame:
    """Read a .sas7bdat dataset into Polars (blank character values -> null)."""
    df = pl.from_pandas(pd.read_sas(file_path, format="sas7bdat", encoding="latin1"))
    return df.with_columns(
        pl.when(pl.col("CURRCODE").str.strip_chars() == "")
        .then(None)
        .otherwise(pl.col("CURRCODE"))
        .alias("CURRCODE")
    )


def write_sas_dataset(sas: saspy.SASsession, df: pl.DataFrame, libref: str, table: str) -> None:
    """Write a Polars DataFrame as <libref>.<table> (.sas7bdat) through saspy.
    Numeric columns are stored as 8-byte numerics, CURRCODE as $3."""
    numeric_cols = [name for name, dtype in df.schema.items() if dtype != pl.Utf8]
    pdf = df.with_columns(pl.col(numeric_cols).cast(pl.Float64)).to_pandas()
    result = sas.df2sd(pdf, table=table, libref=libref, char_lengths={"CURRCODE": 3})
    if result is None:
        raise RuntimeError(f"saspy failed to write {libref}.{table}")




def _parse_mmddyy6(raw: str) -> Optional[date]:
    """Replicate SAS MMDDYY6. informat under OPTIONS YEARCUTOFF=1930.

    Two-digit year yy: yy >= 30 -> 19yy, else 20yy. Invalid dates -> missing.
    """
    text = raw.strip()
    if len(text) < 6 or not text.isdigit():
        return None

    mm = int(text[0:2])
    dd = int(text[2:4])
    yy = int(text[4:6])
    year = 1900 + yy if yy >= 30 else 2000 + yy

    try:
        return date(year, mm, dd)
    except ValueError:
        return None




