RECORD_LEN = 133


def _put(*items) -> str:
    """Build one 133-byte record. items = (logical @column, text); ASA byte is index 0."""
    buf = [" "] * RECORD_LEN
    for pos, text in items:
        for i, ch in enumerate(text):
            if pos + i < RECORD_LEN:
                buf[pos + i] = ch
    return "".join(buf)


def _fmt_comma(value, width: int, decimals: int = 0) -> str:
    """SAS COMMAw.d: round half away from zero, comma separators, right-justified."""
    if value is None or value != value:
        return ".".rjust(width)
    quantum = Decimal(1).scaleb(-decimals)
    dec = Decimal(repr(float(value))).quantize(quantum, rounding=ROUND_HALF_UP)
    if dec == 0:
        dec = abs(dec)
    return f"{dec:,.{decimals}f}".rjust(width)


def _build_header(category: str) -> list[str]:
    """SAS HEADER=NEWPAGE block (10 lines); '1' = ASA page eject."""
    return [
        _put((0, "1"), (2, "PUBLIC BANK BERHAD - RETAIL BANKING DIVISION")),
        _put((2, "REPORT TITLE : EIBDLN1M")),
        _put((2, f"DAILY MOVEMENT IN BANK'S LOANS/OD ACCOUNTS @ {RDATE}")),
        _put((2, "NET INCREASED/(DECREASED) OF RM1 MILLION & ABOVE PER CUSTOMER")),
        _put((2, "*")),
        _put((2, f"{category:<16s}"[:16])),
        _put((2, "-" * 131)),
        _put((2, "BRH  BRH")),
        _put((2, "CODE ABBR CUSTOMER NAME"),
             (54, "ACCOUNT NO.   APPROVE LIMIT  CURRENT BALANCE"),
             (103, "PREVIOUS BAL    NET (INC/DEC)")),
        _put((2, "-" * 131)),
    ]


def _build_detail(row: dict) -> str:
    return _put(
        (2,   f"{int(row['BRANCH'] or 0):03d}"),                   # Z3.
        (7,   (row.get("BRNAME") or "")[:3]),                      # $3.
        (12,  (row.get("CUSTNAME") or "")[:40]),                   # $40.
        (54,  f"{int(row['ACCTNO'] or 0):>10d}"),                  # 10.
        (66,  _fmt_comma(row.get("LIMTBAL"), 15, 0)),              # COMMA15.0
        (83,  _fmt_comma(row.get("ACCBAL"), 15, 2)),               # COMMA15.2
        (100, _fmt_comma(row.get("PACCBAL"), 15, 2)),              # COMMA15.2
        (117, _fmt_comma(row.get("MOVEAMTS"), 15, 2)),             # COMMA15.2
    )


