_SME_CODES  = {"41", "42", "43", "44", "46", "47", "48", "49", "51", "52", "53", "54"}
_FBE_CODES  = {"87", "88", "89"}
_DNBFI_VALS = {"1", "2", "3"}


def _code_str(v) -> str:
    """CUSTCD / DNBFISME as a comparable string: 41.0 -> '41', missing -> ''."""
    if v is None or (not isinstance(v, str) and pd.isna(v)):
        return ""
    if isinstance(v, str):
        return v.strip()
    f = float(v)
    return str(int(f)) if f.is_integer() else str(f)


def _codes(s: pd.Series) -> pd.Series:
    return s.map(_code_str)


def _code_pl(df: pl.DataFrame, col: str) -> pl.Expr:
    """Polars version of _code_str (numeric -> Int64 -> Utf8, text -> stripped)."""
    if df.schema[col].is_numeric():
        return pl.col(col).cast(pl.Int64, strict=False).cast(pl.Utf8).fill_null("")
    return pl.col(col).cast(pl.Utf8).str.strip_chars().fill_null("")


def pl_join(left: pl.DataFrame, right: pl.DataFrame, on, how: str, **kwargs) -> pl.DataFrame:
    """Polars join where NULL keys match each other (SAS MERGE matches missing to missing)."""
    try:
        return left.join(right, on=on, how=how, nulls_equal=True, **kwargs)
    except TypeError:                       # Polars < 1.24
        return left.join(right, on=on, how=how, join_nulls=True, **kwargs)


def _ssum(col: str) -> pl.Expr:
    """PROC SUMMARY SUM=: missing (not 0) when every value in the group is missing."""
    return (pl.when(pl.col(col).count() > 0).then(pl.col(col).sum()).otherwise(None)).alias(col)


def _present(df: pl.DataFrame, cols: list) -> pl.Expr:
    """True where every CLASS column is non-missing (PROC SUMMARY/TABULATE without MISSING drops the rest)."""
    expr = pl.lit(True)
    for c in cols:
        if df.schema[c] == pl.Utf8:
            expr = expr & pl.col(c).is_not_null() & (pl.col(c).str.strip_chars() != "")
        else:
            expr = expr & pl.col(c).is_not_null()
    return expr


def sas_merge(left: pl.DataFrame, right: pl.DataFrame, by: list) -> pl.DataFrame:
    """SAS `MERGE left right; BY by;` including many-to-many BY groups.

    Emulates the program data vector: rows are paired by position inside a BY group,
    the shorter side keeps its last values, later-dataset values overwrite earlier ones
    (even when missing), and everything is reset to missing at each new BY group.
    Adds __A / __B (IN= flags: 1 when that input has the BY group).
    """
    left = left.with_columns([pl.col(c).cast(right.schema[c], strict=False)
                              for c in left.columns if c in right.columns])
    all_cols = list(left.columns) + [c for c in right.columns if c not in left.columns]
    schema = {c: (right.schema[c] if c in right.columns else left.schema[c]) for c in all_cols}
    schema["__A"], schema["__B"] = pl.Int8, pl.Int8

    def _group(df: pl.DataFrame) -> dict:
        groups: dict = {}
        for row in df.iter_rows(named=True):
            groups.setdefault(tuple(row[k] for k in by), []).append(row)
        return groups

    lg, rg = _group(left), _group(right)
    out = []
    for key in sorted(lg.keys() | rg.keys(), key=lambda k: tuple((v is not None, v) for v in k)):
        lrows, rrows = lg.get(key, []), rg.get(key, [])
        pdv = dict.fromkeys(all_cols)
        for i in range(max(len(lrows), len(rrows))):
            if i < len(lrows):
                pdv.update(lrows[i])
            if i < len(rrows):
                pdv.update(rrows[i])
            out.append({**pdv, "__A": int(bool(lrows)), "__B": int(bool(rrows))})
    return pl.DataFrame(out, schema=schema)


def _sme_splits(df: pl.DataFrame):
    """Return (sme, dbe, dnbfi, fbe) subsets using the SAS CUSTCD / DNBFISME IN-lists."""
    cols = [c for c in ("CUSTCD", "DNBFISME") if c in df.columns]
    pdf = df.select(cols).to_pandas()
    empty = pd.Series("", index=pdf.index, dtype=object)
    cust  = _codes(pdf["CUSTCD"])   if "CUSTCD"   in pdf.columns else empty
    dnbfi = _codes(pdf["DNBFISME"]) if "DNBFISME" in pdf.columns else empty
    masks = (
        cust.isin(_SME_CODES | _FBE_CODES) | dnbfi.isin(_DNBFI_VALS),
        cust.isin(_SME_CODES),
        dnbfi.isin(_DNBFI_VALS),
        cust.isin(_FBE_CODES),
    )
    return tuple(df.filter(pl.Series(m.to_numpy())) for m in masks)




