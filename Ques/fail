    for need in ("CUSTCODE", "PRODUCT"):
        if need not in common_cols:
            raise ValueError(f"EIBMTOP5: expected column {need!r} missing after alignment")

    data1 = (
        pl.concat([fdorg.select(common_cols), caorg.select(common_cols)], how="diagonal_relaxed")
        .filter(pl.col("CUSTNO").is_in(TOP50_CUSTNOS))
