# ============================================================
# REPORT DATE  (from ctl_dwh_batch_dttm, SOURCE_SYSTEM_CD = 'DP')
# replaces DATA REPTDATE / CALL SYMPUT
# ============================================================
def get_batch_date(ctl_file: Path, source_system_cd: str = "DP"):
    ctl = pd.read_sas(ctl_file, format="sas7bdat", encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    hit = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == source_system_cd, "BATCH_DTTM"]
    if hit.empty:
        raise ValueError(f"SOURCE_SYSTEM_CD '{source_system_cd}' not found in {ctl_file}")
    return pd.Timestamp(hit.iloc[0]).date()


_reptdate = get_batch_date(CTL_BATCH_FILE, "DP")

REPDD   = _reptdate.strftime("%d")      # Z2.  day
REPMM   = _reptdate.strftime("%m")      # Z2.  month
REPYY   = _reptdate.strftime("%Y")      # YEAR4.
REPDT   = _reptdate.strftime("%d/%m/%y")  # DDMMYY8. (e.g. 24/08/26)
REPYMD  = _reptdate.strftime("%y%m%d")  # yymmdd for input filenames

