def copy_outputs_to_ftpfiles(files: list) -> None:
    """Copy the produced output files, unchanged, to FTPFILES_DIR."""
    FTPFILES_DIR.mkdir(parents=True, exist_ok=True)
    for local_path, target_name in files:
        if not local_path.exists():
            raise FileNotFoundError(f"Output file not found: {local_path}")
        target = FTPFILES_DIR / target_name
        shutil.copyfile(local_path, target)
        print(f"  Copied: {local_path} -> {target}")




    print("\nCopying output files to ftpfiles folder...")
    copy_outputs_to_ftpfiles([(OUTPUT_DIR / local, target) for local, target in COPY_OUTPUTS])




