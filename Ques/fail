def _fmt_comma(value, width: int, decimals: int = 0) -> str:
    if value is None:
        return " " * width
    try:
        v = float(value)
    except (TypeError, ValueError):
        return " " * width
    # Build the formatted string with commas (standard thousands separator)
    if decimals > 0:
        s = f"{v:,.{decimals}f}"
    else:
        s = f"{v:,.0f}"          # rounds and adds commas
    # If absolute value >= 1 billion, strip all commas
    if abs(v) >= 1_000_000_000:
        s = s.replace(",", "")
    return s.rjust(width)
