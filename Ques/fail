def _fmt_num(value) -> str:
    """Replicate SAS BEST12. right-aligned numeric output (+(-1) has no effect here)."""
    if value is None:
        return " " * 12  # SAS missing numeric prints 12 blanks
    try:
        num = float(value)
        if num != num:  # NaN (SAS missing)
            return " " * 12
        # Check for whole number to avoid trailing .0
        if num.is_integer():
            # Format as integer, right-aligned to 12
            return f"{int(num):>12}"
        else:
            # Format as decimal, right-aligned to 12
            # Note: Python uses bankers rounding, but it's negligible for this report.
            return f"{num:>12}"
    except (ValueError, TypeError):
        # Fallback if somehow a string got here (shouldn't happen)
        return str(value).rjust(12)


