def sftp_upload_to_drr(uploads: list) -> None:
    """JCL //RUNSFTP: CD to each DRR folder and PUT the matching report as <prefix>@<MM><YY>.TXT."""
    sftp_id, sftp_pw, host_ip, _host_key = get_sftp_info(DRR_HOST_DESC)

    ssh = paramiko.SSHClient()
    # HOST_KEY is read from the control file but not pinned; AutoAddPolicy as in EIWFRMCR.py.
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    print(f"  Connecting to DRR host {host_ip} as {sftp_id} ...")
    ssh.connect(hostname=host_ip, username=sftp_id, password=sftp_pw)
    sftp = ssh.open_sftp()
    try:
        for remote_dir, local_path, remote_prefix in uploads:
            try:
                sftp.chdir(remote_dir)
            except IOError:
                sys.exit(f"Aborting: Remote DRR folder '{remote_dir}' not found")
            remote_name = f"{remote_prefix}@{REPTMON}{REPTYEAR}.TXT"      # %OMM.%OYY..TXT
            print(f"  SFTP upload: {local_path.name} -> {remote_dir}/{remote_name}")
            sftp.put(str(local_path), remote_name)
    finally:
        sftp.close()
        ssh.close()
    print("  DRR upload complete.")


