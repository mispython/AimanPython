def _asof_carry(base_df: pl.DataFrame, value_df: pl.DataFrame, value_col: str) -> pl.DataFrame:
    base_sorted = base_df.sort("ACCTNO")
    value_dedup = (
        value_df
        .sort("ACCTNO", maintain_order=True)
        .unique(subset=["ACCTNO"], keep="first")
    )
    # SAS MERGE-by-ACCTNO retain rule: a B-side value column is carried
    # forward from the closest previous (smaller) ACCTNO when the current
    # ACCTNO has no exact match; only null when nothing precedes it.
    return base_sorted.join_asof(
        value_dedup.select(["ACCTNO", value_col]),
        on="ACCTNO", strategy="backward",
    )




