def _fmt_branch(value) -> str:
    """Format branch without leading zeros."""
    if value is None:
        return ''

    text = str(value).strip()

    if text.endswith('.0'):
        text = text[:-2]

    digits = ''.join(ch for ch in text if ch.isdigit())

    if digits:
        return str(int(digits))

    return text
