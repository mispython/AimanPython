# RUN;
# NOTE: Report date = BATCH_DTTM of SOURCE_SYSTEM_CD 'LN' in
# ctl_dwh_batch_dttm.sas7bdat.
# ============================================================
def get_ln_batch_date() -> date:
    """Report date = BATCH_DTTM of SOURCE_SYSTEM_CD 'LN' in ctl_dwh_batch_dttm."""
    ctl = pd.read_sas(CTL_BATCH_FILE, format="sas7bdat", encoding="latin1")
    ctl["SOURCE_SYSTEM_CD"] = ctl["SOURCE_SYSTEM_CD"].astype(str).str.strip()
    batch = ctl.loc[ctl["SOURCE_SYSTEM_CD"] == BATCH_SOURCE_SYSTEM, "BATCH_DTTM"]
    if batch.empty or pd.isna(batch.iloc[0]):
        raise ValueError(
            f"No BATCH_DTTM for SOURCE_SYSTEM_CD='{BATCH_SOURCE_SYSTEM}' in {CTL_BATCH_FILE}"
        )
    return pd.Timestamp(batch.iloc[0]).date()


def to_sas_date(value: Optional[date]) -> Optional[float]:
    """Convert a Python date to a SAS date number (days since 01JAN1960)."""
    if value is None:
        return None
    return float((value - SAS_EPOCH).days)


