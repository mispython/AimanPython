# SAS -> TEMPORARY PARQUET HELPERS
# (converted once per run, shared by PBB and PIBB, removed at end of program)
# ============================================================================
def sas_to_parquet(sas_path: Path, parquet_path: Path, tag: str) -> None:
    """Convert a .sas7bdat to Parquet in streaming chunks (schema-locked)."""
    print(f"  [{tag}] Converting {sas_path.name} -> {parquet_path.name} ...")
    writer = None
    schema = None
    total = 0
    rows_read = 0

    try:
        for chunk in pd.read_sas(sas_path, encoding="latin1", chunksize=CHUNK_ROWS):
            if ROW_LIMIT and rows_read >= ROW_LIMIT:
                break
            if ROW_LIMIT:
                chunk = chunk.iloc[: ROW_LIMIT - rows_read]
            rows_read += len(chunk)

            table = pa.Table.from_pandas(chunk, preserve_index=False)

            if schema is None:
                # Never lock a 'null' type inferred from a chunk that happened to be
                # blank for a text column - it would null out real values in later chunks.
                fields = [
                    pa.field(f.name, pa.string()) if pa.types.is_null(f.type) else f
                    for f in table.schema
                ]
                schema = pa.schema(fields)
                table = table.cast(schema, safe=False)
                writer = pq.ParquetWriter(parquet_path, schema, compression="snappy")
            else:
                cast_arrays = []
                for field in schema:
                    col = table.column(field.name)
                    if col.type != field.type:
                        try:
                            col = col.cast(field.type, safe=False)
                        except Exception as e:
                            print(f"  [{tag}] WARNING: cannot cast '{field.name}' "
                                  f"{col.type}->{field.type}: {e} - nulling")
                            col = pa.nulls(len(col), type=field.type)
                    cast_arrays.append(col)
                table = pa.Table.from_arrays(cast_arrays, schema=schema)

            writer.write_table(table)
            total += len(chunk)
            del chunk, table
            gc.collect()
    finally:
        if writer:
            writer.close()

    if writer is None:
        raise RuntimeError(f"[{tag}] {sas_path} contains no rows - nothing to convert")
    print(f"  [{tag}] Done - {total:,} rows converted.")


def _prepare_inputs(tmp_dir: Path) -> tuple:
    """Convert the DEPOSIT and LOAN .sas7bdat inputs to temporary Parquet (once each).

    Returns (loan_parquet, deposit_parquet).
    """
    for label, path in (("DEPOSIT", DEPOSIT_FILE), ("LOAN", LOAN_FILE)):
        if not path.exists():
            raise FileNotFoundError(
                f"Expected {label} file not found: {path}\n"
                f"Derived from batch date {REPTDATE} with NOWK={NOWK}."
            )

    deposit_parquet = tmp_dir / f"{DEPOSIT_FILE.stem}.parquet"
    loan_parquet    = tmp_dir / f"{LOAN_FILE.stem}.parquet"

    sas_to_parquet(DEPOSIT_FILE, deposit_parquet, "DEPOSIT")
    sas_to_parquet(LOAN_FILE, loan_parquet, "LOAN")
    return loan_parquet, deposit_parquet




