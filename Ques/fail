import math
from datetime import date
from pathlib import Path

import pandas as pd
import paramiko
import polars as pl




XDATE    = reptdate.strftime("%d/%m/%y")     # DDMMYY8. -> dd/mm/yy, TITLE5 'AS AT ' &XDATE




# SFTP to Data Report Repository (DRR) - from FTPDMS1F
CTL_SFTP_INFO   = Path("/sasdata/dwh/control/ctl_dwh_sftp_info.sas7bdat")
SFTP_HOST_DESC  = "Data Report Repository (DRR)"
SFTP_REMOTE_DIR = "WMTB-SA&S/DEP - SAS/BANK TOTAL"
SFTP_PORT       = 22




def _sas_round(value: float) -> int:
    """SAS ROUND(x,1) - nearest whole number, halves rounded away from zero."""
    return int(math.floor(abs(value) + 0.5)) * (1 if value >= 0 else -1)


def _fmt_comma(value, width: int) -> str:
    """COMMA<width>. with OPTIONS MISSING=0 -> missing prints as 0."""
    v = 0.0 if value is None else float(value)
    s = f"{_sas_round(v):,}"
    return s.rjust(width)




def _emit_header(columns: list, include_date: bool) -> list[str]:
    """Return a header block, ASA '1' on the first line (always a new page),
    ASA ' ' on the remaining lines."""
    block = _build_header_block(columns, include_date)
    lines = ["1" + block[0]]
    lines.extend(" " + ln for ln in block[1:])
    return lines




def _get_sftp_credentials(host_desc: str) -> dict:
    """Read host / user / password for host_desc from ctl_dwh_sftp_info."""
    ctl = pd.read_sas(str(CTL_SFTP_INFO), encoding="latin1")
    for col in ("SFTP_ID", "SFTP_PW", "HOST_IP", "HOST_DESC"):
        ctl[col] = ctl[col].astype(str).str.strip()
    hit = ctl.loc[ctl["HOST_DESC"] == host_desc]
    if hit.empty:
        raise ValueError(f"HOST_DESC '{host_desc}' not found in {CTL_SFTP_INFO}")
    row = hit.iloc[0]
    return {"host": row["HOST_IP"], "user": row["SFTP_ID"], "password": row["SFTP_PW"]}


def sftp_put(local_file: Path, remote_dir: str, remote_name: str) -> None:
    """Upload one report to the DRR server (equivalent of the RUNSFTP step in FTPDMS1F)."""
    cred = _get_sftp_credentials(SFTP_HOST_DESC)
    transport = paramiko.Transport((cred["host"], SFTP_PORT))
    try:
        transport.connect(username=cred["user"], password=cred["password"])
        sftp = paramiko.SFTPClient.from_transport(transport)
        try:
            sftp.chdir(remote_dir)
            sftp.put(str(local_file), remote_name)
        finally:
            sftp.close()
    finally:
        transport.close()




